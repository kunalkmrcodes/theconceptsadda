---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "The Concepts Adda | Learn Mathematics",
	description = "The Concepts Adda makes Mathematics easier through clear concepts, visual examples, practice questions and exam-focused lessons.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>

		<meta
			name="description"
			content={description}
		/>

		<title>{title}</title>

		<!-- Favicon -->
		<link
			rel="icon"
			type="image/png"
			href="/favicon.png"
		/>

		<link
			rel="shortcut icon"
			type="image/png"
			href="/favicon.png"
		/>

		<link
			rel="apple-touch-icon"
			href="/favicon.png"
		/>
	</head>

	<body>
		<slot />
	</body>
</html>

<style>
	:global(html) {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
	}
</style>