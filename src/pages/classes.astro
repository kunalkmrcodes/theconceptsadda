---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
	title="Choose Your Class | The Concepts Adda"
	description="Choose your class and start learning Mathematics with The Concepts Adda."
>

	<header class="navbar">

		<div class="nav-container">

			<a href="/" class="brand">

				<img
					src="/logo.png"
					alt="The Concepts Adda"
					class="brand-logo"
				/>

				<div class="brand-text">

					<div class="brand-name">
						The Concepts Adda
					</div>

					<div class="brand-tagline">
						Understand. Practice. Master.
					</div>

				</div>

			</a>


			<nav class="nav-links">

				<a href="/">
					Home
				</a>

				<a href="/classes">
					Classes
				</a>

			</nav>


			<a
				href="/"
				class="nav-button"
			>
				Back Home
			</a>

		</div>

	</header>


	<main>

		<section class="choose-section">

			<div class="choose-container">

				<div class="section-label">
					THE CONCEPTS ADDA
				</div>


				<h1>

					Choose your

					<span class="blue-text spaced-text">
						class.
					</span>

				</h1>


				<p class="intro">

					Select your class and start learning Mathematics
					with concepts that actually make sense.

				</p>


				<div class="class-grid">

					<!-- CLASS 9 -->

					<a
						href="/class-9"
						class="class-choice class-nine"
					>

						<div class="class-number">
							09
						</div>


						<div class="class-content">

							<div class="badge">
								CLASS 09
							</div>


							<h2>
								Class 9 Mathematics
							</h2>


							<p>
								Build strong mathematical foundations
								with clear concepts and step-by-step
								explanations.
							</p>


							<span class="explore">
								Explore Class 9 →
							</span>

						</div>

					</a>


					<!-- CLASS 10 -->

					<a
						href="/class-10"
						class="class-choice class-ten"
					>

						<div class="class-number">
							10
						</div>


						<div class="class-content">

							<div class="badge">
								CLASS 10
							</div>


							<h2>
								Class 10 Mathematics
							</h2>


							<p>
								Master important concepts, practice
								questions and prepare confidently
								for your exams.
							</p>


							<span class="explore">
								Explore Class 10 →
							</span>

						</div>

					</a>

				</div>

			</div>

		</section>

	</main>


	<footer class="footer">

		<div class="footer-container">

			<div class="footer-brand">

				<img
					src="/logo.png"
					alt="The Concepts Adda"
				/>


				<div>

					<strong>
						The Concepts Adda
					</strong>

					<span>
						Understand. Practice. Master.
					</span>

				</div>

			</div>


			<div class="footer-links">

				<a href="/">
					Home
				</a>

				<a href="/classes">
					Classes
				</a>

			</div>

		</div>


		<div class="footer-bottom">

			© {new Date().getFullYear()}
			The Concepts Adda.
			All rights reserved.

		</div>

	</footer>


	<style>

		:global(*) {
			box-sizing: border-box;
		}


		:global(body) {
			margin: 0;

			background: #f8fafc;

			color: #14213d;

			font-family:
				Inter,
				ui-sans-serif,
				system-ui,
				-apple-system,
				BlinkMacSystemFont,
				"Segoe UI",
				sans-serif;
		}


		.blue-text {
			color: #2563eb;
		}


		/* THIS FIXES "yourclass." */

		.spaced-text {
			display: inline-block;

			margin-left: 0.18em;
		}


		/* =========================
		   NAVBAR
		========================= */

		.navbar {
			width: 100%;

			background:
				rgba(255, 255, 255, 0.96);

			border-bottom:
				1px solid #e4e9f2;

			position: relative;

			z-index: 20;
		}


		.nav-container {
			width:
				min(1180px, calc(100% - 40px));

			min-height: 82px;

			margin: 0 auto;

			display: flex;

			align-items: center;

			justify-content: space-between;

			gap: 30px;
		}


		.brand {
			display: flex;

			align-items: center;

			gap: 12px;

			text-decoration: none;

			color: inherit;
		}


		.brand-logo {
			width: 52px;

			height: 52px;

			border-radius: 50%;

			object-fit: cover;

			display: block;

			border:
				3px solid #f4c430;
		}


		.brand-text {
			display: flex;

			flex-direction: column;

			gap: 3px;
		}


		.brand-name {
			font-size: 19px;

			font-weight: 850;

			line-height: 1.1;

			color: #14213d;
		}


		.brand-tagline {
			font-size: 12px;

			color: #727b8d;
		}


		.nav-links {
			display: flex;

			align-items: center;

			gap: 30px;
		}


		.nav-links a {
			text-decoration: none;

			color: #3d4658;

			font-size: 14px;

			font-weight: 650;
		}


		.nav-links a:hover {
			color: #2563eb;
		}


		.nav-button {
			text-decoration: none;

			color: white;

			background: #14213d;

			padding: 13px 21px;

			border-radius: 10px;

			font-size: 14px;

			font-weight: 750;
		}


		.nav-button:hover {
			background: #2563eb;
		}


		/* =========================
		   MAIN
		========================= */

		.choose-section {
			min-height: calc(100vh - 82px);

			padding: 100px 0 120px;

			background:
				radial-gradient(
					circle at 80% 10%,
					rgba(37, 99, 235, 0.10),
					transparent 30%
				),
				radial-gradient(
					circle at 10% 90%,
					rgba(244, 196, 48, 0.10),
					transparent 28%
				),
				linear-gradient(
					135deg,
					#f8fbff,
					#eef5ff,
					#ffffff
				);
		}


		.choose-container {
			width:
				min(1080px, calc(100% - 40px));

			margin: 0 auto;
		}


		.section-label {
			color: #2563eb;

			font-size: 12px;

			font-weight: 850;

			letter-spacing: 2px;

			margin-bottom: 20px;
		}


		h1 {
			margin: 0;

			font-size:
				clamp(48px, 7vw, 78px);

			line-height: 1;

			letter-spacing: -3px;

			font-weight: 850;

			color: #14213d;
		}


		.intro {
			max-width: 650px;

			margin: 25px 0 0;

			font-size: 18px;

			line-height: 1.7;

			color: #687180;
		}


		/* =========================
		   CLASS CARDS
		========================= */

		.class-grid {
			display: grid;

			grid-template-columns:
				repeat(2, minmax(0, 1fr));

			gap: 24px;

			margin-top: 55px;
		}


		.class-choice {
			position: relative;

			overflow: hidden;

			display: flex;

			gap: 25px;

			min-height: 310px;

			padding: 35px;

			border-radius: 24px;

			text-decoration: none;

			transition:
				transform 0.25s ease,
				box-shadow 0.25s ease;
		}


		.class-choice:hover {
			transform: translateY(-6px);
		}


		.class-nine {
			background: #ffffff;

			border:
				1px solid #dce5f3;

			box-shadow:
				0 15px 40px
				rgba(20, 33, 61, 0.07);
		}


		.class-ten {
			background:
				linear-gradient(
					135deg,
					#14213d,
					#1c3159
				);

			box-shadow:
				0 20px 45px
				rgba(20, 33, 61, 0.20);
		}


		.class-number {
			font-size: 58px;

			line-height: 1;

			font-weight: 900;

			color: #2563eb;
		}


		.class-ten .class-number {
			color: #f4c430;
		}


		.class-content {
			position: relative;

			z-index: 2;
		}


		.badge {
			display: inline-flex;

			padding: 6px 10px;

			border-radius: 999px;

			background: #eef4ff;

			color: #2563eb;

			font-size: 10px;

			font-weight: 850;

			letter-spacing: 1px;

			margin-bottom: 14px;
		}


		.class-ten .badge {
			background:
				rgba(244, 196, 48, 0.13);

			color: #f4c430;
		}


		.class-choice h2 {
			margin: 0;

			font-size: 27px;

			line-height: 1.2;

			font-weight: 850;

			color: #14213d;
		}


		.class-ten h2 {
			color: #ffffff;
		}


		.class-choice p {
			margin: 15px 0 25px;

			font-size: 15px;

			line-height: 1.65;

			color: #687180;
		}


		.class-ten p {
			color: #c0c8d6;
		}


		.explore {
			font-size: 14px;

			font-weight: 800;

			color: #2563eb;
		}


		.class-ten .explore {
			color: #f4c430;
		}


		/* =========================
		   FOOTER
		========================= */

		.footer {
			background: #0d172b;

			color: white;

			padding: 55px 0 25px;
		}


		.footer-container {
			width:
				min(1180px, calc(100% - 40px));

			margin: 0 auto;

			display: flex;

			align-items: center;

			justify-content: space-between;

			gap: 30px;
		}


		.footer-brand {
			display: flex;

			align-items: center;

			gap: 12px;
		}


		.footer-brand img {
			width: 50px;

			height: 50px;

			border-radius: 50%;

			object-fit: cover;

			border:
				2px solid #f4c430;
		}


		.footer-brand div {
			display: flex;

			flex-direction: column;

			gap: 4px;
		}


		.footer-brand strong {
			font-size: 17px;
		}


		.footer-brand span {
			font-size: 12px;

			color: #aeb7c7;
		}


		.footer-links {
			display: flex;

			gap: 25px;
		}


		.footer-links a {
			color: #c4cad5;

			text-decoration: none;

			font-size: 13px;
		}


		.footer-bottom {
			width:
				min(1180px, calc(100% - 40px));

			margin: 40px auto 0;

			padding-top: 20px;

			border-top:
				1px solid
				rgba(255, 255, 255, 0.1);

			color: #8993a5;

			font-size: 12px;
		}


		/* =========================
		   MOBILE
		========================= */

		@media (max-width: 700px) {

			.nav-container {
				width:
					calc(100% - 28px);

				min-height: 72px;
			}


			.brand-logo {
				width: 43px;

				height: 43px;
			}


			.brand-name {
				font-size: 16px;
			}


			.brand-tagline {
				font-size: 10px;
			}


			.nav-links {
				display: none;
			}


			.nav-button {
				padding: 10px 14px;

				font-size: 12px;
			}


			.choose-section {
				padding: 75px 0 90px;
			}


			.choose-container {
				width:
					calc(100% - 28px);
			}


			h1 {
				font-size: 48px;

				letter-spacing: -2px;
			}


			.spaced-text {
				margin-left: 0.14em;
			}


			.intro {
				font-size: 15px;
			}


			.class-grid {
				grid-template-columns: 1fr;

				margin-top: 40px;
			}


			.class-choice {
				min-height: auto;

				padding: 25px;

				gap: 18px;
			}


			.class-number {
				font-size: 42px;
			}


			.class-choice h2 {
				font-size: 22px;
			}


			.footer-container {
				width:
					calc(100% - 28px);

				flex-direction: column;

				align-items: flex-start;
			}


			.footer-bottom {
				width:
					calc(100% - 28px);
			}

		}

	</style>

</Layout>