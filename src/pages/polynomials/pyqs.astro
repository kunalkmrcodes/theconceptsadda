---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
---

<Layout
	title="Polynomials Last 5 Years PYQs Practice | Class 10 | The Concepts Adda"
	description="Practice CBSE Class 10 Polynomials Last 5 Years (2020-2024) Previous Year Questions (PYQs) organized by year and marks for student self-practice."
>
	<main class="lesson-page">
		<div class="lesson-container">
			<a href="/polynomials" class="back-link">
				<span class="back-arrow">←</span>
				<span>Back to Polynomials</span>
			</a>

			<!-- LESSON HEADER -->
			<section class="lesson-header">
				<div class="lesson-number">04</div>
				<div class="lesson-header-copy">
					<div class="lesson-label">PRACTICE · CLASS 10 MATHEMATICS (NCERT)</div>
					<h1>Polynomials <span>Last 5 Years PYQs</span></h1>
					<p>
						Practice official CBSE Class 10 Board exam questions from the last 5 years (2020 – 2024) organized by year and mark distribution for self-assessment.
					</p>
				</div>
			</section>

			<!-- CONTENT LAYOUT -->
			<section class="content-layout">
				<article class="lesson-content">

					<!-- ================= 2024 BOARD QUESTIONS ================= -->
					<div class="topic-label">01 · CBSE BOARD EXAM 2024</div>
					<h2>CBSE 2024 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 1 MARK</span>
							<h3>Q1. If one zero of the quadratic polynomial x² + 3x + k is 2, then find the value of k.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 1 MARK</span>
							<h3>Q2. The number of polynomials having zeroes -2 and 5 is:</h3>
						</div>
						<div class="example-solution">
							<p>(A) 1 &nbsp;&nbsp;&nbsp;&nbsp; (B) 2 &nbsp;&nbsp;&nbsp;&nbsp; (C) 3 &nbsp;&nbsp;&nbsp;&nbsp; (D) More than 3</p>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 2 MARKS</span>
							<h3>Q3. Find the zeroes of the quadratic polynomial 6x² - 3 - 7x and verify the relationship between the zeroes and coefficients.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 3 MARKS</span>
							<h3>Q4. If α and β are the zeroes of the quadratic polynomial p(x) = x² - p(x + 1) - c, prove that (α + 1)(β + 1) = 1 - c.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 3 MARKS</span>
							<h3>Q5. If α and β are zeroes of x² - 6x + a, find the value of a if 3α + 2β = 20.</h3>
						</div>
					</div>

					<!-- ================= 2023 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">02 · CBSE BOARD EXAM 2023</div>
					<h2>CBSE 2023 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 1 MARK</span>
							<h3>Q6. If α and β are zeroes of p(x) = 2x² + 5x + k such that α² + β² + αβ = 21/4, find the value of k.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 1 MARK</span>
							<h3>Q7. A quadratic polynomial, the sum of whose zeroes is -3 and product is 2, is:</h3>
						</div>
						<div class="example-solution">
							<p>(A) x² + 3x + 2 &nbsp;&nbsp;&nbsp;&nbsp; (B) x² - 3x + 2 &nbsp;&nbsp;&nbsp;&nbsp; (C) x² + 3x - 2 &nbsp;&nbsp;&nbsp;&nbsp; (D) -x² + 3x + 2</p>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 2 MARKS</span>
							<h3>Q8. Find a quadratic polynomial whose zeroes are reciprocal of the zeroes of the polynomial f(x) = ax² + bx + c (a ≠ 0, c ≠ 0).</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 3 MARKS</span>
							<h3>Q9. If α and β are zeroes of the polynomial k x² + 4x + 4 such that α² + β² = 24, find the value of k.</h3>
						</div>
					</div>

					<!-- ================= 2022 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">03 · CBSE BOARD EXAM 2022</div>
					<h2>CBSE 2022 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2022 · 1 MARK</span>
							<h3>Q10. If one zero of 3x² + 8x + k is the reciprocal of the other, find the value of k.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2022 · 2 MARKS</span>
							<h3>Q11. Find the zeroes of 4x² - 4x + 1 and verify the relationship between zeroes and coefficients.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2022 · 3 MARKS</span>
							<h3>Q12. Find a quadratic polynomial whose zeroes are 2 + √3 and 2 - √3.</h3>
						</div>
					</div>

					<!-- ================= 2021 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">04 · CBSE BOARD EXAM 2021</div>
					<h2>CBSE 2021 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2021 · 1 MARK</span>
							<h3>Q13. If the product of zeroes of the polynomial ax² - 6x - 6 is 4, find the value of a.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2021 · 3 MARKS</span>
							<h3>Q14. If α and β are zeroes of x² - 4x + 3, form a quadratic polynomial whose zeroes are 3α and 3β.</h3>
						</div>
					</div>

					<!-- ================= 2020 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">05 · CBSE BOARD EXAM 2020</div>
					<h2>CBSE 2020 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2020 · 1 MARK</span>
							<h3>Q15. If α and β are the zeroes of p(x) = x² - 5x + 6, find the value of α + β - 3αβ.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2020 · 2 MARKS</span>
							<h3>Q16. Find the zeroes of x² - 2x - 8 and verify the relationship between the zeroes and coefficients.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2020 · 3 MARKS</span>
							<h3>Q17. If α and β are the zeroes of the quadratic polynomial f(x) = x² - 1, find a quadratic polynomial whose zeroes are 2α/β and 2β/α.</h3>
						</div>
					</div>

					<!-- 06 · PRACTICE TIPS -->
					<div class="topic-label second-label">06 · SELF-PRACTICE TIPS</div>
					<h2>Tips for Solving Board PYQs</h2>

					<div class="summary-list">
						<div class="summary-item">
							<span>01</span>
							<p>Always write down <strong>α + β = -b/a</strong> and <strong>αβ = c/a</strong> first before simplifying algebra.</p>
						</div>
						<div class="summary-item">
							<span>02</span>
							<p>Use identities like <strong>α² + β² = (α + β)² - 2αβ</strong> to evaluate expressions without finding roots.</p>
						</div>
						<div class="summary-item">
							<span>03</span>
							<p>When zeroes are reciprocal (α and 1/α), product of zeroes <strong>α · (1/α) = 1 ⟹ c/a = 1 ⟹ c = a</strong>!</p>
						</div>
					</div>

					<!-- LESSON NAVIGATION -->
					<div class="lesson-navigation">
						<a href="/polynomials/relationship-zeroes-coefficients" class="previous-lesson">
							<span>←</span>
							<div>
								<small>PREVIOUS LESSON</small>
								<strong>Zeroes & Coefficients</strong>
							</div>
						</a>

						<a href="/polynomials" class="next-lesson">
							<div>
								<small>COMPLETE COURSE</small>
								<strong>Polynomials Overview</strong>
							</div>
							<span>→</span>
						</a>
					</div>
				</article>

				<!-- SIDEBAR -->
				<aside class="lesson-sidebar">
					<div class="sidebar-card">
						<div class="sidebar-title">POLYNOMIALS</div>
						<div class="progress-text">Lesson 04 of 04</div>
						<div class="progress-bar">
							<div style="width: 100%;"></div>
						</div>

						<div class="sidebar-lessons">
							<a href="/polynomials/introduction" class="sidebar-lesson">
								<span>01</span>
								<div>
									<strong>Introduction</strong>
									<small>Degrees & types of polynomials</small>
								</div>
							</a>

							<a href="/polynomials/geometrical-meaning" class="sidebar-lesson">
								<span>02</span>
								<div>
									<strong>Geometrical Meaning</strong>
									<small>X-axis graphs of zeroes</small>
								</div>
							</a>

							<a href="/polynomials/relationship-zeroes-coefficients" class="sidebar-lesson">
								<span>03</span>
								<div>
									<strong>Zeroes & Coefficients</strong>
									<small>α + β = -b/a & αβ = c/a</small>
								</div>
							</a>

							<a href="/polynomials/pyqs" class="sidebar-lesson active">
								<span>04</span>
								<div>
									<strong>Last 5 Years PYQs</strong>
									<small>CBSE 2020-2024 practice set</small>
								</div>
							</a>
						</div>
					</div>
				</aside>
			</section>
		</div>
	</main>

	<style>
		.lesson-page {
			min-height: 100vh;
			background: linear-gradient(180deg, #f8fbff 0%, #ffffff 35%, #f7f9fc 100%);
			color: #14213d;
			padding: 45px 0 100px;
		}

		.lesson-container {
			width: min(1120px, calc(100% - 40px));
			margin: 0 auto;
		}

		.back-link {
			display: inline-flex;
			align-items: center;
			gap: 7px;
			color: #667085;
			text-decoration: none;
			font-size: 14px;
			font-weight: 700;
			margin-bottom: 35px;
			transition: color 0.2s ease, transform 0.2s ease;
		}

		.back-link:hover {
			color: #2563eb;
			transform: translateX(-3px);
		}

		.lesson-header {
			display: grid;
			grid-template-columns: 80px minmax(0, 1fr);
			gap: 25px;
			align-items: center;
			padding: 40px;
			border: 1px solid #e1e7f0;
			border-radius: 24px;
			background: rgba(255, 255, 255, 0.92);
			box-shadow: 0 18px 45px rgba(20, 33, 61, 0.055);
			margin-bottom: 45px;
		}

		.lesson-number {
			width: 80px;
			height: 80px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 20px;
			background: #eef4ff;
			color: #2563eb;
			font-size: 23px;
			font-weight: 900;
		}

		.lesson-label {
			color: #2563eb;
			font-size: 11px;
			font-weight: 850;
			letter-spacing: 1.7px;
			margin-bottom: 10px;
		}

		.lesson-header h1 {
			margin: 0;
			font-size: clamp(34px, 4.5vw, 54px);
			line-height: 1.05;
			letter-spacing: -2px;
			font-weight: 900;
			color: #14213d;
		}

		.lesson-header h1 span {
			color: #2563eb;
		}

		.lesson-header p {
			margin: 15px 0 0;
			max-width: 720px;
			color: #687180;
			font-size: 17px;
			line-height: 1.65;
		}

		.content-layout {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 300px;
			gap: 45px;
			align-items: start;
		}

		.lesson-content {
			min-width: 0;
			padding: 5px 0 0;
		}

		.topic-label {
			color: #2563eb;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1.8px;
			margin-bottom: 14px;
		}

		.second-label {
			margin-top: 60px;
		}

		.lesson-content h2 {
			margin: 0;
			color: #14213d;
			font-size: clamp(28px, 3.5vw, 38px);
			line-height: 1.1;
			letter-spacing: -1.5px;
			font-weight: 900;
		}

		.lesson-content > p {
			max-width: 780px;
			margin: 18px 0 0;
			color: #687180;
			font-size: 16.5px;
			line-height: 1.75;
		}

		.example-card {
			margin-top: 25px;
			border-radius: 20px;
			border: 1px solid #e1e7f0;
			background: #ffffff;
			box-shadow: 0 8px 25px rgba(20, 33, 61, 0.035);
			overflow: hidden;
		}

		.example-header {
			padding: 20px 24px;
			background: #f8fafc;
			border-bottom: 1px solid #edf2f7;
		}

		.example-badge {
			display: inline-block;
			padding: 4px 12px;
			border-radius: 6px;
			background: #2563eb;
			color: #ffffff;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1px;
			margin-bottom: 8px;
		}

		.example-header h3 {
			margin: 0;
			font-size: 18px;
			font-weight: 800;
			color: #14213d;
		}

		.example-solution {
			padding: 24px;
			color: #475569;
			font-size: 15px;
			line-height: 1.7;
		}

		.summary-list {
			display: grid;
			gap: 16px;
			margin-top: 26px;
		}

		.summary-item {
			display: flex;
			align-items: center;
			gap: 20px;
			padding: 20px 24px;
			border-radius: 16px;
			background: #ffffff;
			border: 1px solid #e1e7f0;
			box-shadow: 0 4px 15px rgba(20, 33, 61, 0.03);
		}

		.summary-item span {
			padding: 8px 14px;
			border-radius: 10px;
			background: #eef4ff;
			color: #2563eb;
			font-weight: 900;
			font-size: 13px;
			flex-shrink: 0;
		}

		.summary-item p {
			margin: 0;
			color: #334155;
			font-size: 15.5px;
			line-height: 1.5;
			font-weight: 600;
		}

		.lesson-navigation {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: 20px;
			margin-top: 60px;
			padding-top: 40px;
			border-top: 1px solid #e2e8f0;
		}

		.previous-lesson,
		.next-lesson {
			display: flex;
			align-items: center;
			gap: 16px;
			padding: 18px 24px;
			border: 1px solid #e1e7f0;
			border-radius: 16px;
			background: #ffffff;
			text-decoration: none;
			color: #14213d;
			transition: all 0.2s ease;
		}

		.next-lesson {
			margin-left: auto;
			text-align: right;
			justify-content: flex-end;
		}

		.previous-lesson:hover,
		.next-lesson:hover {
			border-color: #2563eb;
			box-shadow: 0 10px 25px rgba(37, 99, 235, 0.08);
			transform: translateY(-2px);
		}

		.previous-lesson div,
		.next-lesson div {
			display: flex;
			flex-direction: column;
		}

		.previous-lesson small,
		.next-lesson small {
			display: block;
			color: #64748b;
			font-size: 11px;
			font-weight: 700;
			letter-spacing: 1px;
			margin-bottom: 4px;
		}

		.previous-lesson strong,
		.next-lesson strong {
			display: block;
			font-size: 15px;
			font-weight: 600;
			color: #0f172a;
		}

		.previous-lesson span,
		.next-lesson span {
			font-size: 20px;
			color: #2563eb;
			font-weight: 800;
		}

		.lesson-sidebar {
			position: sticky;
			top: 30px;
		}

		.sidebar-card {
			padding: 28px;
			border-radius: 24px;
			border: 1px solid #e1e7f0;
			background: #ffffff;
			box-shadow: 0 10px 30px rgba(20, 33, 61, 0.04);
		}

		.sidebar-title {
			color: #2563eb;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1.5px;
			margin-bottom: 8px;
		}

		.progress-text {
			color: #64748b;
			font-size: 13px;
			font-weight: 700;
			margin-bottom: 12px;
		}

		.progress-bar {
			height: 6px;
			border-radius: 10px;
			background: #e2e8f0;
			overflow: hidden;
			margin-bottom: 24px;
		}

		.progress-bar div {
			height: 100%;
			background: #2563eb;
			border-radius: 10px;
		}

		.sidebar-lessons {
			display: flex;
			flex-direction: column;
			gap: 8px;
		}

		.sidebar-lesson {
			display: flex;
			align-items: flex-start;
			gap: 12px;
			padding: 12px;
			border-radius: 12px;
			text-decoration: none;
			color: #334155;
			transition: background 0.15s ease;
		}

		.sidebar-lesson:hover {
			background: #f8fafc;
		}

		.sidebar-lesson.active {
			background: #eef4ff;
		}

		.sidebar-lesson > span {
			width: 24px;
			height: 24px;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			border-radius: 6px;
			background: #f1f5f9;
			color: #64748b;
			font-size: 11px;
			font-weight: 700;
		}

		.sidebar-lesson.active > span {
			background: #dbeafe;
			color: #2563eb;
		}

		.sidebar-lesson div {
			min-width: 0;
			display: flex;
			flex-direction: column;
		}

		.sidebar-lesson strong {
			display: block;
			font-size: 13px;
			font-weight: 600;
			color: #1e293b;
			line-height: 1.3;
		}

		.sidebar-lesson.active strong {
			color: #1d4ed8;
		}

		.sidebar-lesson small {
			display: block;
			font-size: 11px;
			color: #64748b;
			margin-top: 3px;
			line-height: 1.3;
		}

		.sidebar-lesson.active small {
			color: #3b82f6;
		}

		@media (max-width: 900px) {
			.content-layout {
				grid-template-columns: 1fr;
			}

			.lesson-header {
				grid-template-columns: 1fr;
				padding: 28px;
			}

			.lesson-number {
				width: 60px;
				height: 60px;
				font-size: 18px;
			}

			.lesson-navigation {
				flex-direction: column;
			}

			.next-lesson {
				width: 100%;
			}
		}
	</style>
</Layout>
