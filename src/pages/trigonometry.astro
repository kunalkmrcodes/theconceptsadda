---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
	title="Introduction to Trigonometry | The Concepts Adda"
	description="Learn Trigonometry for Class 10 Mathematics through clear lessons, simple explanations and step-by-step examples."
>

	<main class="trigonometry-page">

		<!-- =========================
		     HERO
		========================= -->

		<section class="trig-hero">

			<div class="trig-container">

				<!-- BREADCRUMB -->

				<div class="breadcrumb">

					<a href="/">
						← Back to Home
					</a>

					<span class="breadcrumb-dot"></span>

					<span class="breadcrumb-class">
						CLASS 10 MATHEMATICS
					</span>

				</div>


				<!-- HERO HEADING -->

				<h1>
					Learn{" "}
					<span class="blue-text">
						Trigonometry.
					</span>
				</h1>


				<p class="hero-description">
					Build a strong understanding of Trigonometry through clear
					lessons, simple explanations and step-by-step examples.
				</p>

			</div>

		</section>


		<!-- =========================
		     LEARNING PATH
		========================= -->

		<section class="learning-section">

			<div class="trig-container">

				<div class="learning-heading">

					<div class="section-label">
						TRIGONOMETRY
					</div>

					<div class="heading-row">

						<h2>
							Your learning{" "}
							<span class="blue-text">
								path.
							</span>
						</h2>

						<p>
							Follow the lessons in order and build your
							concepts step by step.
						</p>

					</div>

				</div>


				<!-- =========================
				     LESSONS
				========================= -->

				<div class="lesson-list">


					<!-- LESSON 01 -->

					<a
						href="/trigonometry/introduction"
						class="lesson-card"
					>

						<div class="lesson-number">
							01
						</div>

						<div class="lesson-content">

							<div class="lesson-label">
								LESSON 01
							</div>

							<h3>
								Introduction to Trigonometry
							</h3>

							<p>
								Understand what trigonometry is and how
								right-angled triangles form its foundation.
							</p>

						</div>

						<div class="lesson-arrow">
							→
						</div>

					</a>


					<!-- LESSON 02 -->

					<a
						href="/trigonometry/trigonometric-ratios"
						class="lesson-card"
					>

						<div class="lesson-number">
							02
						</div>

						<div class="lesson-content">

							<div class="lesson-label">
								LESSON 02
							</div>

							<h3>
								Trigonometric Ratios
							</h3>

							<p>
								Learn sin θ, cos θ and tan θ by understanding
								the sides of a triangle.
							</p>

						</div>

						<div class="lesson-arrow">
							→
						</div>

					</a>


					<!-- LESSON 03 -->

					<a
						href="/trigonometry/reciprocal-ratios"
						class="lesson-card"
					>

						<div class="lesson-number">
							03
						</div>

						<div class="lesson-content">

							<div class="lesson-label">
								LESSON 03
							</div>

							<h3>
								Reciprocal Ratios
							</h3>

							<p>
								Understand cosec θ, sec θ and cot θ and how
								they relate to the basic ratios.
							</p>

						</div>

						<div class="lesson-arrow">
							→
						</div>

					</a>


					<!-- LESSON 04 -->

					<a
						href="/trigonometry/standard-values"
						class="lesson-card"
					>

						<div class="lesson-number">
							04
						</div>

						<div class="lesson-content">

							<div class="lesson-label">
								LESSON 04
							</div>

							<h3>
								Standard Trigonometric Values
							</h3>

							<p>
								Learn the standard values for 0°, 30°, 45°,
								60° and 90°.
							</p>

						</div>

						<div class="lesson-arrow">
							→
						</div>

					</a>


					<!-- LESSON 05 -->

					<a
						href="/trigonometry/trigonometric-identities"
						class="lesson-card"
					>

						<div class="lesson-number">
							05
						</div>

						<div class="lesson-content">

							<div class="lesson-label">
								LESSON 05
							</div>

							<h3>
								Trigonometric Identities
							</h3>

							<p>
								Understand important identities and learn
								how to use them to solve questions.
							</p>

						</div>

					</a>


					<!-- LESSON 06 -->

					<a
						href="/trigonometry/pyqs"
						class="lesson-card"
					>

						<div class="lesson-number">
							06
						</div>

						<div class="lesson-content">

							<div class="lesson-label">
								LESSON 06 · PRACTICE
							</div>

							<h3>
								Previous Year Questions (PYQs)
							</h3>

							<p>
								Practice official CBSE board exam questions (2020-2024) organized by year and mark distribution for self-assessment.
							</p>

						</div>

						<div class="lesson-arrow">
							→
						</div>

					</a>

				</div>

			</div>

		</section>


		<!-- =========================
		     BOTTOM CTA
		========================= -->

		<section class="trig-cta">

			<div class="trig-container">

				<div class="cta-box">

					<div>

						<div class="section-label">
							READY TO START?
						</div>

						<h2>
							Understand the concept.
							<br />
							<span class="blue-text">
								Then solve the question.
							</span>
						</h2>

						<p>
							Start with the first lesson and build your
							Trigonometry concepts step by step.
						</p>

					</div>

					<a
						href="/trigonometry/introduction"
						class="cta-button"
					>
						Start Lesson 01 →
					</a>

				</div>

			</div>

		</section>

	</main>


	<style>

		/* =========================
		   PAGE
		========================= */

		:global(html) {
			scroll-behavior: smooth;
		}

		:global(body) {
			margin: 0;
			background: #f8fafc;
			color: #14213d;

			font-family:
				Inter,
				ui-sans-serif,
				system-ui,
				-apple-system,
				BlinkMacSystemFont,
				"Segoe UI",
				sans-serif;
		}

		:global(*) {
			box-sizing: border-box;
		}


		.trigonometry-page {
			min-height: 100vh;
			overflow: hidden;
		}


		.blue-text {
			color: #2563eb;
		}


		.trig-container {
			width: min(1120px, calc(100% - 40px));
			margin: 0 auto;
		}


		/* =========================
		   HERO
		========================= */

		.trig-hero {
			padding: 72px 0 105px;

			background:
				radial-gradient(
					circle at 85% 20%,
					rgba(37, 99, 235, 0.08),
					transparent 30%
				),
				linear-gradient(
					135deg,
					#fbfdff 0%,
					#f1f6ff 55%,
					#ffffff 100%
				);
		}


		/* =========================
		   BREADCRUMB
		========================= */

		.breadcrumb {
			display: flex;
			align-items: center;

			/* THIS CREATES THE GAP */
			gap: 14px;

			margin-bottom: 38px;
		}


		.breadcrumb a {
			display: inline-flex;
			align-items: center;

			color: #626d7e;

			text-decoration: none;

			font-size: 15px;
			font-weight: 700;

			white-space: nowrap;

			transition:
				color 0.2s ease;
		}


		.breadcrumb a:hover {
			color: #2563eb;
		}


		.breadcrumb-dot {
			width: 7px;
			height: 7px;

			flex: 0 0 7px;

			border-radius: 50%;

			background: #f4c430;

			box-shadow:
				0 0 0 4px
				rgba(244, 196, 48, 0.12);
		}


		.breadcrumb-class {
			color: #2563eb;

			font-size: 12px;
			font-weight: 850;

			letter-spacing: 2px;

			white-space: nowrap;
		}


		/* =========================
		   HERO HEADING
		========================= */

		.trig-hero h1 {
			margin: 0;

			font-size:
				clamp(58px, 7vw, 88px);

			line-height: 0.98;

			letter-spacing: -4px;

			font-weight: 900;

			color: #14213d;
		}


		.hero-description {
			max-width: 760px;

			margin: 28px 0 0;

			color: #687180;

			font-size: 17px;

			line-height: 1.7;
		}


		/* =========================
		   LEARNING SECTION
		========================= */

		.learning-section {
			padding: 100px 0 115px;

			background:
				linear-gradient(
					180deg,
					#ffffff 0%,
					#f7f9fc 100%
				);
		}


		.section-label {
			margin-bottom: 20px;

			color: #2563eb;

			font-size: 11px;

			font-weight: 900;

			letter-spacing: 2.2px;
		}


		.learning-heading {
			margin-bottom: 48px;
		}


		.heading-row {
			display: flex;

			align-items: flex-end;
			justify-content: space-between;

			gap: 60px;
		}


		.heading-row h2 {
			margin: 0;

			color: #14213d;

			font-size:
				clamp(45px, 5vw, 66px);

			line-height: 1;

			letter-spacing: -3px;

			font-weight: 900;

			white-space: nowrap;
		}


		.heading-row p {
			max-width: 390px;

			margin: 0 0 5px;

			color: #737c8c;

			font-size: 15px;

			line-height: 1.65;
		}


		/* =========================
		   LESSON LIST
		========================= */

		.lesson-list {
			display: flex;

			flex-direction: column;

			gap: 14px;
		}


		.lesson-card {
			position: relative;

			display: grid;

			grid-template-columns: 78px minmax(0, 1fr) 45px;

			align-items: center;

			gap: 28px;

			min-height: 150px;

			padding: 27px 30px;

			border:
				1px solid #e2e7ef;

			border-radius: 20px;

			background: rgba(255, 255, 255, 0.9);

			box-shadow:
				0 8px 25px
				rgba(20, 33, 61, 0.035);

			text-decoration: none;

			transition:
				transform 0.22s ease,
				border-color 0.22s ease,
				box-shadow 0.22s ease;
		}


		.lesson-card:hover {
			transform: translateY(-3px);

			border-color: #cbd8ed;

			box-shadow:
				0 15px 35px
				rgba(20, 33, 61, 0.08);
		}


		/* =========================
		   LESSON NUMBER
		========================= */

		.lesson-number {
			display: flex;

			align-items: center;
			justify-content: center;

			width: 60px;
			height: 60px;

			border-radius: 14px;

			background: #edf4ff;

			color: #2563eb;

			font-size: 16px;

			font-weight: 900;
		}


		.lesson-card:nth-child(2n) .lesson-number {
			background: #fff8dc;

			color: #967300;
		}


		.lesson-card:nth-child(3n) .lesson-number {
			background: #edf8f2;

			color: #16834b;
		}


		/* =========================
		   LESSON CONTENT
		========================= */

		.lesson-content {
			min-width: 0;
		}


		.lesson-label {
			margin-bottom: 8px;

			color: #7a8493;

			font-size: 10px;

			font-weight: 900;

			letter-spacing: 1.6px;
		}


		.lesson-content h3 {
			margin: 0;

			color: #26344d;

			font-size: 23px;

			line-height: 1.25;

			font-weight: 850;
		}


		.lesson-content p {
			margin: 8px 0 0;

			color: #747d8c;

			font-size: 15px;

			line-height: 1.55;
		}


		/* =========================
		   ARROW
		========================= */

		.lesson-arrow {
			display: flex;

			align-items: center;
			justify-content: center;

			width: 40px;
			height: 40px;

			border-radius: 50%;

			background: #f4f7fb;

			color: #2563eb;

			font-size: 18px;

			font-weight: 800;

			transition:
				background 0.2s ease,
				transform 0.2s ease;
		}


		.lesson-card:hover .lesson-arrow {
			background: #eaf1ff;

			transform: translateX(3px);
		}


		/* =========================
		   CTA
		========================= */

		.trig-cta {
			padding: 0 0 110px;

			background: #f7f9fc;
		}


		.cta-box {
			display: flex;

			align-items: center;
			justify-content: space-between;

			gap: 50px;

			padding: 55px;

			border-radius: 26px;

			background:
				linear-gradient(
					135deg,
					#14213d 0%,
					#1d3155 100%
				);

			box-shadow:
				0 25px 55px
				rgba(20, 33, 61, 0.16);
		}


		.cta-box .section-label {
			color: #f4c430;

			margin-bottom: 16px;
		}


		.cta-box h2 {
			margin: 0;

			color: #ffffff;

			font-size:
				clamp(32px, 4vw, 50px);

			line-height: 1.08;

			letter-spacing: -2px;

			font-weight: 900;
		}


		.cta-box h2 .blue-text {
			color: #5b93ff;
		}


		.cta-box p {
			max-width: 570px;

			margin: 20px 0 0;

			color: #bdc7d7;

			font-size: 15px;

			line-height: 1.7;
		}


		.cta-button {
			display: inline-flex;

			align-items: center;
			justify-content: center;

			min-height: 50px;

			padding: 0 22px;

			flex-shrink: 0;

			border-radius: 10px;

			background: #2563eb;

			color: #ffffff;

			text-decoration: none;

			font-size: 14px;

			font-weight: 800;

			box-shadow:
				0 10px 25px
				rgba(0, 0, 0, 0.18);

			transition:
				background 0.2s ease,
				transform 0.2s ease;
		}


		.cta-button:hover {
			background: #3b73ed;

			transform: translateY(-2px);
		}


		/* =========================
		   TABLET
		========================= */

		@media (max-width: 850px) {

			.heading-row {
				align-items: flex-start;

				flex-direction: column;

				gap: 20px;
			}


			.heading-row h2 {
				white-space: normal;
			}


			.cta-box {
				flex-direction: column;

				align-items: flex-start;
			}

		}


		/* =========================
		   MOBILE
		========================= */

		@media (max-width: 600px) {

			.trig-container {
				width: min(100% - 28px, 1120px);
			}


			.trig-hero {
				padding: 55px 0 75px;
			}


			.breadcrumb {
				gap: 10px;

				margin-bottom: 30px;

				flex-wrap: wrap;
			}


			.breadcrumb a {
				font-size: 13px;
			}


			.breadcrumb-class {
				font-size: 10px;

				letter-spacing: 1.4px;
			}


			.trig-hero h1 {
				font-size: clamp(46px, 14vw, 68px);

				letter-spacing: -2.8px;
			}


			.hero-description {
				font-size: 15px;

				margin-top: 22px;
			}


			.learning-section {
				padding: 75px 0 80px;
			}


			.learning-heading {
				margin-bottom: 35px;
			}


			.heading-row h2 {
				font-size: 44px;

				letter-spacing: -2px;
			}


			.heading-row p {
				font-size: 14px;
			}


			.lesson-list {
				gap: 12px;
			}


			.lesson-card {
				grid-template-columns: 52px minmax(0, 1fr);

				gap: 16px;

				padding: 21px 18px;

				min-height: 130px;
			}


			.lesson-number {
				width: 50px;
				height: 50px;

				border-radius: 12px;

				font-size: 14px;
			}


			.lesson-content h3 {
				font-size: 18px;
			}


			.lesson-content p {
				font-size: 13px;
			}


			.lesson-arrow {
				display: none;
			}


			.trig-cta {
				padding-bottom: 75px;
			}


			.cta-box {
				padding: 32px 24px;

				border-radius: 20px;

				gap: 30px;
			}


			.cta-box h2 {
				font-size: 34px;

				letter-spacing: -1.5px;
			}


			.cta-button {
				width: 100%;
			}

		}

	</style>

</Layout>