---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
---

<Layout
	title="Triangles Last 5 Years PYQs Practice | Class 10 | The Concepts Adda"
	description="Practice CBSE Class 10 Triangles Last 5 Years (2020-2024) Previous Year Questions (PYQs) organized by year and marks for student self-practice."
>
	<main class="lesson-page">
		<div class="lesson-container">
			<a href="/triangles" class="back-link">
				<span class="back-arrow">←</span>
				<span>Back to Triangles</span>
			</a>

			<!-- LESSON HEADER -->
			<section class="lesson-header">
				<div class="lesson-number">04</div>
				<div class="lesson-header-copy">
					<div class="lesson-label">PRACTICE · CLASS 10 MATHEMATICS (NCERT)</div>
					<h1>Triangles <span>Last 5 Years PYQs</span></h1>
					<p>
						Practice official CBSE Class 10 Board exam questions from the last 5 years (2020 – 2024) organized by year and mark distribution for self-assessment.
					</p>
				</div>
			</section>

			<!-- CONTENT LAYOUT -->
			<section class="content-layout">
				<article class="lesson-content">

					<!-- ================= 2024 BOARD QUESTIONS ================= -->
					<div class="topic-label">01 · CBSE BOARD EXAM 2024</div>
					<h2>CBSE 2024 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 1 MARK</span>
							<h3>Q1. In △ABC, DE ∥ BC such that AD = 3 cm, DB = 5 cm and AE = 4.5 cm. Find EC.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 1 MARK</span>
							<h3>Q2. If △ABC ~ △PQR with AB / PQ = 1 / 3, then find ar(△ABC) / ar(△PQR).</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 2 MARKS</span>
							<h3>Q3. In a trapezium ABCD, AB ∥ DC and its diagonals intersect each other at point O. Show that AO / BO = CO / DO.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 3 MARKS</span>
							<h3>Q4. State and prove Basic Proportionality Theorem (Thales Theorem).</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 5 MARKS</span>
							<h3>Q5. If a line is drawn parallel to one side of a triangle to intersect the other two sides in distinct points, prove that the other two sides are divided in the same ratio. Using this theorem, in △ABC with DE ∥ BC, if AD/DB = 3/5 and AC = 5.6 cm, find AE.</h3>
						</div>
					</div>

					<!-- ================= 2023 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">02 · CBSE BOARD EXAM 2023</div>
					<h2>CBSE 2023 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 1 MARK</span>
							<h3>Q6. Sides of two similar triangles are in the ratio 4 : 9. Ratio of their areas is:</h3>
						</div>
						<div class="example-solution">
							<p>(A) 2 : 3 &nbsp;&nbsp;&nbsp;&nbsp; (B) 4 : 9 &nbsp;&nbsp;&nbsp;&nbsp; (C) 81 : 16 &nbsp;&nbsp;&nbsp;&nbsp; (D) 16 : 81</p>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 2 MARKS</span>
							<h3>Q7. E and F are points on the sides PQ and PR respectively of a △PQR. For PE = 3.9 cm, EQ = 3 cm, PF = 3.6 cm and FR = 2.4 cm, check if EF ∥ QR.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 3 MARKS</span>
							<h3>Q8. In △ABC, D and E are points on sides AB and AC respectively such that DE ∥ BC. If AD = x, DB = x - 2, AE = x + 2 and EC = x - 1, find the value of x.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 5 MARKS</span>
							<h3>Q9. Diagonals of a quadrilateral ABCD intersect each other at point O such that AO / BO = CO / DO. Prove that ABCD is a trapezium.</h3>
						</div>
					</div>

					<!-- ================= 2022 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">03 · CBSE BOARD EXAM 2022</div>
					<h2>CBSE 2022 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2022 · 1 MARK</span>
							<h3>Q10. Two triangles △ABC and △DEF are similar such that ∠A = 47° and ∠E = 83°. Find ∠C.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2022 · 2 MARKS</span>
							<h3>Q11. In given △ABC, DE ∥ BC. If AD = 2.4 cm, AE = 3.2 cm, EC = 4.8 cm, find BD.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2022 · 3 MARKS</span>
							<h3>Q12. In △ABC, ∠A = 90° and AD ⊥ BC. Prove that AD² = BD · CD.</h3>
						</div>
					</div>

					<!-- ================= 2021 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">04 · CBSE BOARD EXAM 2021</div>
					<h2>CBSE 2021 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2021 · 1 MARK</span>
							<h3>Q13. Are two isosceles triangles always similar? State true or false with reason.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2021 · 2 MARKS</span>
							<h3>Q14. A vertical pole of length 6 m casts a shadow 4 m long on the ground and at the same time a tower casts a shadow 28 m long. Find the height of the tower.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2021 · 3 MARKS</span>
							<h3>Q15. Through the vertex D of a parallelogram ABCD, a line is drawn to intersect the side BC at P and AB produced at Q. Prove that DA · PQ = FB · DP.</h3>
						</div>
					</div>

					<!-- ================= 2020 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">05 · CBSE BOARD EXAM 2020</div>
					<h2>CBSE 2020 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2020 · 1 MARK</span>
							<h3>Q16. In △ABC, D and E are points on AB and AC such that DE ∥ BC. If AD/DB = 2/3 and AC = 18 cm, find AE.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2020 · 3 MARKS</span>
							<h3>Q17. In △ABC, if AD ⊥ BC, prove that AB² + CD² = AC² + BD².</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2020 · 5 MARKS</span>
							<h3>Q18. State and prove the Converse of Basic Proportionality Theorem.</h3>
						</div>
					</div>

					<!-- 06 · PRACTICE TIPS -->
					<div class="topic-label second-label">06 · SELF-PRACTICE TIPS</div>
					<h2>Tips for Solving Board PYQs</h2>

					<div class="summary-list">
						<div class="summary-item">
							<span>01</span>
							<p>Always draw a clear, labeled triangle diagram before starting any geometry proof.</p>
						</div>
						<div class="summary-item">
							<span>02</span>
							<p>For BPT problems, write <strong>AD/DB = AE/EC</strong> and substitute given values accurately.</p>
						</div>
						<div class="summary-item">
							<span>03</span>
							<p>When proving similarity, state the criterion used (AA, SSS, or SAS) explicitly.</p>
						</div>
					</div>

					<!-- LESSON NAVIGATION -->
					<div class="lesson-navigation">
						<a href="/triangles/applications-and-proofs" class="previous-lesson">
							<span>←</span>
							<div>
								<small>PREVIOUS LESSON</small>
								<strong>Applications & Proofs</strong>
							</div>
						</a>

						<a href="/triangles" class="next-lesson">
							<div>
								<small>COMPLETE COURSE</small>
								<strong>Triangles Overview</strong>
							</div>
							<span>→</span>
						</a>
					</div>
				</article>

				<!-- SIDEBAR -->
				<aside class="lesson-sidebar">
					<div class="sidebar-card">
						<div class="sidebar-title">TRIANGLES</div>
						<div class="progress-text">Lesson 04 of 04</div>
						<div class="progress-bar">
							<div style="width: 100%;"></div>
						</div>

						<div class="sidebar-lessons">
							<a href="/triangles/similar-figures-criteria" class="sidebar-lesson">
								<span>01</span>
								<div>
									<strong>Similar Figures & Criteria</strong>
									<small>AAA, SSS & SAS criteria</small>
								</div>
							</a>

							<a href="/triangles/basic-proportionality-theorem" class="sidebar-lesson">
								<span>02</span>
								<div>
									<strong>Thales Theorem (BPT)</strong>
									<small>Complete proof of BPT</small>
								</div>
							</a>

							<a href="/triangles/applications-and-proofs" class="sidebar-lesson">
								<span>03</span>
								<div>
									<strong>Applications & Proofs</strong>
									<small>Trapeziums & diagonals</small>
								</div>
							</a>

							<a href="/triangles/pyqs" class="sidebar-lesson active">
								<span>04</span>
								<div>
									<strong>Last 5 Years PYQs</strong>
									<small>CBSE 2020-2024 practice set</small>
								</div>
							</a>
						</div>
					</div>
				</aside>
			</section>
		</div>
	</main>

	<style>
		.lesson-page {
			min-height: 100vh;
			background: linear-gradient(180deg, #f8fbff 0%, #ffffff 35%, #f7f9fc 100%);
			color: #14213d;
			padding: 45px 0 100px;
		}

		.lesson-container {
			width: min(1120px, calc(100% - 40px));
			margin: 0 auto;
		}

		.back-link {
			display: inline-flex;
			align-items: center;
			gap: 7px;
			color: #667085;
			text-decoration: none;
			font-size: 14px;
			font-weight: 700;
			margin-bottom: 35px;
			transition: color 0.2s ease, transform 0.2s ease;
		}

		.back-link:hover {
			color: #2563eb;
			transform: translateX(-3px);
		}

		.lesson-header {
			display: grid;
			grid-template-columns: 80px minmax(0, 1fr);
			gap: 25px;
			align-items: center;
			padding: 40px;
			border: 1px solid #e1e7f0;
			border-radius: 24px;
			background: rgba(255, 255, 255, 0.92);
			box-shadow: 0 18px 45px rgba(20, 33, 61, 0.055);
			margin-bottom: 45px;
		}

		.lesson-number {
			width: 80px;
			height: 80px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 20px;
			background: #eef4ff;
			color: #2563eb;
			font-size: 23px;
			font-weight: 900;
		}

		.lesson-label {
			color: #2563eb;
			font-size: 11px;
			font-weight: 850;
			letter-spacing: 1.7px;
			margin-bottom: 10px;
		}

		.lesson-header h1 {
			margin: 0;
			font-size: clamp(34px, 4.5vw, 54px);
			line-height: 1.05;
			letter-spacing: -2px;
			font-weight: 900;
			color: #14213d;
		}

		.lesson-header h1 span {
			color: #2563eb;
		}

		.lesson-header p {
			margin: 15px 0 0;
			max-width: 720px;
			color: #687180;
			font-size: 17px;
			line-height: 1.65;
		}

		.content-layout {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 300px;
			gap: 45px;
			align-items: start;
		}

		.lesson-content {
			min-width: 0;
			padding: 5px 0 0;
		}

		.topic-label {
			color: #2563eb;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1.8px;
			margin-bottom: 14px;
		}

		.second-label {
			margin-top: 60px;
		}

		.lesson-content h2 {
			margin: 0;
			color: #14213d;
			font-size: clamp(28px, 3.5vw, 38px);
			line-height: 1.1;
			letter-spacing: -1.5px;
			font-weight: 900;
		}

		.lesson-content > p {
			max-width: 780px;
			margin: 18px 0 0;
			color: #687180;
			font-size: 16.5px;
			line-height: 1.75;
		}

		.example-card {
			margin-top: 25px;
			border-radius: 20px;
			border: 1px solid #e1e7f0;
			background: #ffffff;
			box-shadow: 0 8px 25px rgba(20, 33, 61, 0.035);
			overflow: hidden;
		}

		.example-header {
			padding: 20px 24px;
			background: #f8fafc;
			border-bottom: 1px solid #edf2f7;
		}

		.example-badge {
			display: inline-block;
			padding: 4px 12px;
			border-radius: 6px;
			background: #2563eb;
			color: #ffffff;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1px;
			margin-bottom: 8px;
		}

		.example-header h3 {
			margin: 0;
			font-size: 18px;
			font-weight: 800;
			color: #14213d;
		}

		.example-solution {
			padding: 24px;
			color: #475569;
			font-size: 15px;
			line-height: 1.7;
		}

		.summary-list {
			display: grid;
			gap: 16px;
			margin-top: 26px;
		}

		.summary-item {
			display: flex;
			align-items: center;
			gap: 20px;
			padding: 20px 24px;
			border-radius: 16px;
			background: #ffffff;
			border: 1px solid #e1e7f0;
			box-shadow: 0 4px 15px rgba(20, 33, 61, 0.03);
		}

		.summary-item span {
			padding: 8px 14px;
			border-radius: 10px;
			background: #eef4ff;
			color: #2563eb;
			font-weight: 900;
			font-size: 13px;
			flex-shrink: 0;
		}

		.summary-item p {
			margin: 0;
			color: #334155;
			font-size: 15.5px;
			line-height: 1.5;
			font-weight: 600;
		}

		.lesson-navigation {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: 20px;
			margin-top: 60px;
			padding-top: 40px;
			border-top: 1px solid #e2e8f0;
		}

		.previous-lesson,
		.next-lesson {
			display: flex;
			align-items: center;
			gap: 16px;
			padding: 18px 24px;
			border: 1px solid #e1e7f0;
			border-radius: 16px;
			background: #ffffff;
			text-decoration: none;
			color: #14213d;
			transition: all 0.2s ease;
		}

		.next-lesson {
			margin-left: auto;
			text-align: right;
			justify-content: flex-end;
		}

		.previous-lesson:hover,
		.next-lesson:hover {
			border-color: #2563eb;
			box-shadow: 0 10px 25px rgba(37, 99, 235, 0.08);
			transform: translateY(-2px);
		}

		.previous-lesson div,
		.next-lesson div {
			display: flex;
			flex-direction: column;
		}

		.previous-lesson small,
		.next-lesson small {
			display: block;
			color: #64748b;
			font-size: 11px;
			font-weight: 700;
			letter-spacing: 1px;
			margin-bottom: 4px;
		}

		.previous-lesson strong,
		.next-lesson strong {
			display: block;
			font-size: 15px;
			font-weight: 600;
			color: #0f172a;
		}

		.previous-lesson span,
		.next-lesson span {
			font-size: 20px;
			color: #2563eb;
			font-weight: 800;
		}

		.lesson-sidebar {
			position: sticky;
			top: 30px;
		}

		.sidebar-card {
			padding: 28px;
			border-radius: 24px;
			border: 1px solid #e1e7f0;
			background: #ffffff;
			box-shadow: 0 10px 30px rgba(20, 33, 61, 0.04);
		}

		.sidebar-title {
			color: #2563eb;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1.5px;
			margin-bottom: 8px;
		}

		.progress-text {
			color: #64748b;
			font-size: 13px;
			font-weight: 700;
			margin-bottom: 12px;
		}

		.progress-bar {
			height: 6px;
			border-radius: 10px;
			background: #e2e8f0;
			overflow: hidden;
			margin-bottom: 24px;
		}

		.progress-bar div {
			height: 100%;
			background: #2563eb;
			border-radius: 10px;
		}

		.sidebar-lessons {
			display: flex;
			flex-direction: column;
			gap: 8px;
		}

		.sidebar-lesson {
			display: flex;
			align-items: flex-start;
			gap: 12px;
			padding: 12px;
			border-radius: 12px;
			text-decoration: none;
			color: #334155;
			transition: background 0.15s ease;
		}

		.sidebar-lesson:hover {
			background: #f8fafc;
		}

		.sidebar-lesson.active {
			background: #eef4ff;
		}

		.sidebar-lesson > span {
			width: 24px;
			height: 24px;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			border-radius: 6px;
			background: #f1f5f9;
			color: #64748b;
			font-size: 11px;
			font-weight: 700;
		}

		.sidebar-lesson.active > span {
			background: #dbeafe;
			color: #2563eb;
		}

		.sidebar-lesson div {
			min-width: 0;
			display: flex;
			flex-direction: column;
		}

		.sidebar-lesson strong {
			display: block;
			font-size: 13px;
			font-weight: 600;
			color: #1e293b;
			line-height: 1.3;
		}

		.sidebar-lesson.active strong {
			color: #1d4ed8;
		}

		.sidebar-lesson small {
			display: block;
			font-size: 11px;
			color: #64748b;
			margin-top: 3px;
			line-height: 1.3;
		}

		.sidebar-lesson.active small {
			color: #3b82f6;
		}

		@media (max-width: 900px) {
			.content-layout {
				grid-template-columns: 1fr;
			}

			.lesson-header {
				grid-template-columns: 1fr;
				padding: 28px;
			}

			.lesson-number {
				width: 60px;
				height: 60px;
				font-size: 18px;
			}

			.lesson-navigation {
				flex-direction: column;
			}

			.next-lesson {
				width: 100%;
			}
		}
	</style>
</Layout>
