		}

		.topic-label {
			color: #2563eb;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1.8px;
			margin-bottom: 14px;
		}

		.second-label {
			margin-top: 60px;
		}

		.lesson-content h2 {
			margin: 0;
			color: #14213d;
			font-size: clamp(28px, 3.5vw, 38px);
			line-height: 1.1;
			letter-spacing: -1.5px;
			font-weight: 900;
		}

		.lesson-content > p {
