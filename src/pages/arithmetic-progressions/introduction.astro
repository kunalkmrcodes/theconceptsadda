			color: #ffffff;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1px;
			margin-bottom: 8px;
		}

		.example-header h3 {
			margin: 0;
			font-size: 18px;
			font-weight: 800;
			color: #14213d;
		}

		.example-solution {
