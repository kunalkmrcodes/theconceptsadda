			align-items: center;
			gap: 7px;
			color: #667085;
			text-decoration: none;
			font-size: 14px;
			font-weight: 700;
			margin-bottom: 35px;
			transition: color 0.2s ease, transform 0.2s ease;
		}

		.back-link:hover {
			color: #2563eb;
			transform: translateX(-3px);
		}

		.lesson-header {
			display: grid;
			grid-template-columns: 80px minmax(0, 1fr);
			gap: 25px;
			align-items: center;
			padding: 40px;
			border: 1px solid #e1e7f0;
			border-radius: 24px;
			background: rgba(255, 255, 255, 0.92);
			box-shadow: 0 18px 45px rgba(20, 33, 61, 0.055);
			margin-bottom: 45px;
		}

