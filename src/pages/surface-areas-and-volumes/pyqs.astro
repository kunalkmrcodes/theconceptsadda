			transition: all 0.2s ease;
		}

		.next-lesson {
			margin-left: auto;
			text-align: right;
			justify-content: flex-end;
		}

		.previous-lesson:hover,
		.next-lesson:hover {
			border-color: #2563eb;
			box-shadow: 0 10px 25px rgba(37, 99, 235, 0.08);
			transform: translateY(-2px);
		}

		.previous-lesson div,
		.next-lesson div {
			display: flex;
			flex-direction: column;
		}

		.previous-lesson small,
