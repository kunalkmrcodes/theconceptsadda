			font-size: 13px;
			flex-shrink: 0;
		}

		.summary-item p {
			margin: 0;
			color: #334155;
			font-size: 15.5px;
			line-height: 1.5;
			font-weight: 600;
		}

		.lesson-navigation {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: 20px;
			margin-top: 60px;
			padding-top: 40px;
			border-top: 1px solid #e2e8f0;
		}

		.previous-lesson,
		.next-lesson {
