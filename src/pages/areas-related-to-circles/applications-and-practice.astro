			height: 80px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 20px;
			background: #eef4ff;
			color: #2563eb;
			font-size: 23px;
			font-weight: 900;
		}

		.lesson-label {
			color: #2563eb;
			font-size: 11px;
			font-weight: 850;
			letter-spacing: 1.7px;
			margin-bottom: 10px;
		}

		.lesson-header h1 {
