---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
---

<Layout
	title="Perimeter, Area & Sector of a Circle | Class 10 | The Concepts Adda"
	description="Learn perimeter, area of circle, sector area formula (θ/360° × πr²), and arc length formula (θ/360° × 2πr) for Class 10 NCERT Mathematics."
>
	<main class="lesson-page">
		<div class="lesson-container">
			<a href="/areas-related-to-circles" class="back-link">
				<span class="back-arrow">←</span>
				<span>Back to Areas Related to Circles</span>
			</a>

			<!-- LESSON HEADER -->
			<section class="lesson-header">
				<div class="lesson-number">01</div>
				<div class="lesson-header-copy">
					<div class="lesson-label">LESSON 01 · CLASS 10 MATHEMATICS (NCERT)</div>
					<h1>Perimeter, Area & <span>Sector of a Circle</span></h1>
					<p>
						Master circle circumference 2πr, area πr², arc length, and sector area formulas with clear geometric diagrams.
					</p>
				</div>
			</section>

			<!-- CONTENT LAYOUT -->
			<section class="content-layout">
				<article class="lesson-content">

					<!-- 01 · RECAP FORMULAS -->
					<div class="topic-label">01 · BASIC FORMULAS</div>
					<h2>Perimeter & Area of a Circle</h2>

					<div class="formula-box">
						<strong>Perimeter (Circumference) = 2πr &nbsp;(or πd)</strong>
						<strong>Area of Circle = πr²</strong>
					</div>

					<!-- 02 · SECTOR OF A CIRCLE -->
					<div class="topic-label second-label">02 · SECTOR FORMULAS</div>
					<h2>Sector of a Circle & Arc Length</h2>
					<p>
						A <strong>sector</strong> is the portion of a circular region enclosed by two radii and their corresponding arc.
					</p>

					<!-- SVG Diagram for Sector of a Circle -->
					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">GEOMETRIC DIAGRAM</span>
							<h3>Minor Sector vs Major Sector</h3>
						</div>
						<div class="example-solution">
							<div style="margin:15px 0; text-align:center;">
								<svg width="340" height="230" viewBox="0 0 340 230" fill="none" xmlns="http://www.w3.org/2000/svg" style="background:#f8fafc; border-radius:18px; border:1px solid #cbd5e1; box-shadow:0 6px 20px rgba(0,0,0,0.03);">
									<!-- Circle (Center 170, 115, radius 80) -->
									<circle cx="170" cy="115" r="80" stroke="#0f172a" stroke-width="3" fill="#ffffff"/>

									<!-- Minor Sector Wedge (Angle 60°) from 170,115 -->
									<!-- Radius OA (Angle -30° = (239, 75)) -->
									<!-- Radius OB (Angle +30° = (239, 155)) -->
									<path d="M 170,115 L 239,75 A 80 80 0 0 1 239,155 Z" fill="#dbeafe" stroke="#2563eb" stroke-width="2.5"/>

									<!-- Center Point O -->
									<circle cx="170" cy="115" r="4.5" fill="#0f172a"/>

									<!-- Angle θ Arc -->
									<path d="M 200 98 A 35 35 0 0 1 200 132" stroke="#dc2626" stroke-width="2.5" fill="none"/>
									<text x="206" y="119" fill="#dc2626" font-size="13" font-weight="900">θ</text>

									<!-- Labels -->
									<text x="145" y="120" fill="#0f172a" font-size="14" font-weight="900">O</text>
									<text x="245" y="70" fill="#2563eb" font-size="14" font-weight="900">A</text>
									<text x="245" y="165" fill="#2563eb" font-size="14" font-weight="900">B</text>
									<text x="210" y="85" fill="#2563eb" font-size="12" font-weight="800">r</text>
									<text x="210" y="150" fill="#2563eb" font-size="12" font-weight="800">r</text>
									<text x="248" y="120" fill="#2563eb" font-size="12" font-weight="800">Arc APB</text>

									<text x="210" y="138" fill="#1d4ed8" font-size="12" font-weight="900">Minor Sector</text>
									<text x="90" y="120" fill="#64748b" font-size="13" font-weight="800">Major Sector</text>
								</svg>
							</div>

							<div class="calc-box">
								Area of Minor Sector = <strong>(θ / 360°) × πr²</strong><br/>
								Length of Arc APB = <strong>(θ / 360°) × 2πr</strong><br/>
								Area of Major Sector = <strong>πr² - Area of Minor Sector</strong>
							</div>
						</div>
					</div>

					<!-- 03 · SOLVED NCERT EXAMPLES -->
					<div class="topic-label second-label">03 · SOLVED NCERT EXAMPLES</div>
					<h2>Step-by-Step Problem Solving</h2>

					<!-- Example 1 -->
					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">EXAMPLE 1</span>
							<h3>Find the area of a sector of a circle with radius 6 cm if angle of sector is 60°</h3>
						</div>
						<div class="example-solution">
							<p>Given: radius <em>r = 6 cm</em>, angle <em>θ = 60°</em>.</p>
							<div class="calc-box">
								Area = (θ / 360°) × πr²<br/>
								Area = (60° / 360°) × (22/7) × 6 × 6<br/>
								Area = (1 / 6) × (22/7) × 36 = 132 / 7 = <strong>18.86 cm²</strong> (or 132/7 cm²)
							</div>
						</div>
					</div>

					<!-- Example 2 -->
					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">EXAMPLE 2</span>
							<h3>Find the length of an arc of a circle of radius 21 cm which subtends an angle of 60° at center</h3>
						</div>
						<div class="example-solution">
							<p>Given: radius <em>r = 21 cm</em>, angle <em>θ = 60°</em>.</p>
							<div class="calc-box">
								Arc Length = (60° / 360°) × 2 × (22/7) × 21<br/>
								Arc Length = (1 / 6) × 2 × 22 × 3 = <strong>22 cm</strong>
							</div>
						</div>
					</div>

					<!-- 04 · QUICK SUMMARY -->
					<div class="topic-label second-label">04 · QUICK SUMMARY</div>
					<h2>Key Takeaways</h2>

					<div class="summary-list">
						<div class="summary-item">
							<span>01</span>
							<p>Area of sector: <strong>(θ/360°) × πr²</strong>.</p>
						</div>
						<div class="summary-item">
							<span>02</span>
							<p>Length of arc: <strong>(θ/360°) × 2πr</strong>.</p>
						</div>
						<div class="summary-item">
							<span>03</span>
							<p>Major sector area = <strong>Total Circle Area - Minor Sector Area</strong>.</p>
						</div>
					</div>

					<!-- LESSON NAVIGATION -->
					<div class="lesson-navigation">
						<a href="/areas-related-to-circles" class="previous-lesson">
							<span>←</span>
							<div>
								<small>OVERVIEW</small>
								<strong>Chapter Overview</strong>
							</div>
						</a>

						<a href="/areas-related-to-circles/segment-of-a-circle" class="next-lesson">
							<div>
								<small>NEXT LESSON</small>
								<strong>Area of Segment of a Circle</strong>
							</div>
							<span>→</span>
						</a>
					</div>
				</article>

				<!-- SIDEBAR -->
				<aside class="lesson-sidebar">
					<div class="sidebar-card">
						<div class="sidebar-title">AREAS RELATED TO CIRCLES</div>
						<div class="progress-text">Lesson 01 of 04</div>
						<div class="progress-bar">
							<div style="width: 25%;"></div>
						</div>

						<div class="sidebar-lessons">
							<a href="/areas-related-to-circles/perimeter-area-sector" class="sidebar-lesson active">
								<span>01</span>
								<div>
									<strong>Perimeter & Sector Area</strong>
									<small>Arc length & sector area</small>
								</div>
							</a>

							<a href="/areas-related-to-circles/segment-of-a-circle" class="sidebar-lesson">
								<span>02</span>
								<div>
									<strong>Area of Segment</strong>
									<small>Minor & major segments</small>
								</div>
							</a>

							<a href="/areas-related-to-circles/applications-and-practice" class="sidebar-lesson">
								<span>03</span>
								<div>
									<strong>Applications & Practice</strong>
									<small>NCERT word problems</small>
								</div>
							</a>

							<a href="/areas-related-to-circles/pyqs" class="sidebar-lesson">
								<span>04</span>
								<div>
									<strong>Previous Year PYQs</strong>
									<small>CBSE 2020-2024 practice set</small>
								</div>
							</a>
						</div>
					</div>
				</aside>
			</section>
		</div>
	</main>

	<style>
