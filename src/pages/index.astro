		<div class="footer-container">

			<div class="footer-brand">

				<img
					src="/logo.png"
					alt="The Concepts Adda"
				/>

				<div>

					<strong>
						The Concepts Adda
					</strong>

					<span>
						Understand. Practice. Master.
					</span>

				</div>

			</div>


			<div class="footer-links">

				<a href="#courses">
					Courses
				</a>

				<a href="#classes">
					Classes
				</a>

				<a href="#resources">
					Resources
				</a>

				<a href="#about">
					About
				</a>

			</div>

		</div>


		<div class="footer-bottom">
			© {new Date().getFullYear()} The Concepts Adda. All rights reserved.
		</div>

	</footer>


	<style>

		/* =========================
		   GLOBAL
		========================= */

		:global(html) {
			scroll-behavior: smooth;
		}


		:global(body) {
			margin: 0;
			background: #f8fafc;
			color: #14213d;

			font-family:
				Inter,
				ui-sans-serif,
				system-ui,
				-apple-system,
				BlinkMacSystemFont,
				"Segoe UI",
				sans-serif;
		}


		:global(*) {
			box-sizing: border-box;
		}


		.blue-text {
			color: #2563eb;
		}


		/* =========================
		   NAVBAR
		========================= */

		.navbar {
			width: 100%;

			background:
				rgba(255, 255, 255, 0.94);

			border-bottom:
				1px solid #e4e9f2;

			position: relative;
			z-index: 20;

			backdrop-filter:
				blur(14px);
		}


		.nav-container {
			width:
				min(1180px, calc(100% - 40px));

			min-height: 82px;

			margin: 0 auto;

			display: flex;
			align-items: center;
			justify-content: space-between;

			gap: 30px;
		}


		.brand {
			display: flex;
			align-items: center;

			gap: 12px;

			text-decoration: none;
			color: inherit;

			flex-shrink: 0;
		}


		.brand-logo {
			width: 52px;
			height: 52px;

			border-radius: 50%;

			object-fit: cover;

			display: block;

			border:
				3px solid #f4c430;

			box-shadow:
				0 4px 12px
				rgba(20, 33, 61, 0.12);
		}


		.brand-text {
			display: flex;
			flex-direction: column;

			gap: 3px;
		}


		.brand-name {
			font-size: 19px;
			font-weight: 850;
			line-height: 1.1;

			color: #14213d;
		}


		.brand-tagline {
			font-size: 12px;
			color: #727b8d;
		}


		.nav-links {
			display: flex;
			align-items: center;

			gap: 34px;

			margin-left: auto;
		}


		.nav-links a {
			color: #3d4658;

			font-size: 14px;
			font-weight: 650;

			text-decoration: none;

			transition:
				color 0.2s ease,
				transform 0.2s ease;
		}


		.nav-links a:hover {
			color: #2563eb;
		}


		.nav-button {
			text-decoration: none;

			color: #ffffff;
			background: #14213d;

			padding: 13px 21px;

			border-radius: 10px;

			font-size: 14px;
			font-weight: 750;

			box-shadow:
				0 8px 20px
				rgba(20, 33, 61, 0.14);

			white-space: nowrap;

			transition:
				background 0.2s ease,
				transform 0.2s ease,
				box-shadow 0.2s ease;
		}


		.nav-button:hover {
			background: #2563eb;

			transform: translateY(-1px);

			box-shadow:
				0 10px 24px
				rgba(37, 99, 235, 0.22);
		}


		/* =========================
		   HERO
		========================= */

		.hero {
			position: relative;

			padding: 105px 0 120px;

			overflow: hidden;

			background:
				radial-gradient(
					circle at 78% 20%,
					rgba(37, 99, 235, 0.12),
					transparent 32%
				),
				radial-gradient(
					circle at 8% 90%,
					rgba(244, 196, 48, 0.14),
					transparent 28%
				),
				linear-gradient(
					135deg,
					#f8fbff 0%,
					#eef5ff 52%,
					#f9fbff 100%
				);
		}


		.hero-decoration {
			position: absolute;

			border-radius: 50%;

			pointer-events: none;

			filter: blur(2px);
		}


		.hero-decoration-one {
			width: 120px;
			height: 120px;

			right: 8%;
			top: 8%;

			border:
				2px solid
				rgba(37, 99, 235, 0.08);
		}


		.hero-decoration-two {
			width: 180px;
			height: 180px;

			left: -70px;
			bottom: -80px;

			border:
				2px solid
				rgba(244, 196, 48, 0.12);
		}


		.hero-container {
			position: relative;
			z-index: 2;

			width:
				min(1180px, calc(100% - 40px));

			margin: 0 auto;

			display: grid;

			grid-template-columns:
				minmax(0, 1fr)
				minmax(430px, 0.9fr);

			align-items: center;

			gap: 75px;
		}


		.hero-content {
			min-width: 0;
		}


		.eyebrow {
			display: inline-flex;
			align-items: center;

			gap: 10px;

			padding: 9px 16px;

			border:
				1px solid
				rgba(37, 99, 235, 0.12);

			border-radius: 999px;

			background:
				rgba(255, 255, 255, 0.78);

			color: #315a9f;

			font-size: 14px;
			font-weight: 750;

			margin-bottom: 25px;

			box-shadow:
