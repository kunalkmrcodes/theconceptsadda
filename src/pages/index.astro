---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
	title="The Concepts Adda | Learn Mathematics"
	description="The Concepts Adda makes Mathematics easier through clear concepts, visual examples, practice questions and exam-focused lessons."
>

	<!-- =========================
	     NAVBAR
	========================= -->

	<header class="navbar">
		<div class="nav-container">

			<a href="/" class="brand">
				<img
					src="/logo.png"
					alt="The Concepts Adda"
					class="brand-logo"
				/>

				<div class="brand-text">
					<div class="brand-name">The Concepts Adda</div>

					<div class="brand-tagline">
						Understand. Practice. Master.
					</div>
				</div>
			</a>

			<nav class="nav-links">
				<a href="#courses">Courses</a>
				<a href="#classes">Classes</a>
				<a href="#exam-prep">Exam Prep</a>
				<a href="#resources">Resources</a>
				<a href="/practice">Practice</a>
				<a href="#about">About</a>
			</nav>

			<a href="/classes" class="nav-button">
				Start Learning
			</a>

		</div>
	</header>


	<main>

		<!-- =========================
		     HERO
		========================= -->

		<section class="hero" id="courses">

			<div class="hero-decoration hero-decoration-one"></div>
			<div class="hero-decoration hero-decoration-two"></div>

			<div class="hero-container">

				<div class="hero-content">

					<div class="eyebrow">
						<span></span>
						Class 9 &amp; 10 Mathematics
					</div>

					<h1>
						Don't just learn
						<br />
						formulas.
						<span class="blue-text"> Understand</span>
						<br />
						<span class="blue-text">the concept.</span>
					</h1>

					<p class="hero-description">
						The Concepts Adda makes Mathematics easier to understand
						through clear explanations, visual examples, practice
						questions and exam-focused lessons.
					</p>

					<div class="hero-buttons">

						<a href="/classes" class="primary-button">
							Explore Classes →
						</a>

						<a href="#resources" class="secondary-button">
							Watch Free Lessons
						</a>

					</div>

					<div class="hero-trust">

						<div class="trust-item">
							<span class="trust-check">✓</span>
							Concept-focused
						</div>

						<div class="trust-item">
							<span class="trust-check">✓</span>
							Exam-oriented
						</div>

						<div class="trust-item">
							<span class="trust-check">✓</span>
							Student-friendly
						</div>

					</div>

				</div>


				<!-- =========================
				     CONCEPT CARD
				========================= -->

				<div class="concept-card-wrapper">

					<div class="concept-glow"></div>

					<div class="concept-card">

						<div class="card-top">

							<div class="window-dots">
								<span></span>
								<span></span>
								<span></span>
							</div>

							<div class="card-brand">
								The Concepts Adda
							</div>

						</div>

						<div class="card-content">

							<div class="today-label">
								TODAY'S CONCEPT
							</div>

							<h2>
								Trigonometry
							</h2>

							<div class="trig-line"></div>

							<div class="trig-grid">

								<div class="trig-item active">

									<strong>sin</strong>

									<span>
										Perpendicular /
										<br />
										Hypotenuse
									</span>

								</div>

								<div class="trig-item">

									<strong>cos</strong>

									<span>
										Base /
										<br />
										Hypotenuse
									</span>

								</div>

								<div class="trig-item">

									<strong>tan</strong>

									<span>
										Perpendicular /
										<br />
										Base
									</span>

								</div>

							</div>

							<div class="remember-box">

								<div class="remember-icon">
									!
								</div>

								<div>

									<span>
										Remember
									</span>

									<strong>
										Understanding &gt; Memorizing
									</strong>

								</div>

							</div>

						</div>

					</div>

				</div>

			</div>

		</section>


		<!-- =========================
		     ABOUT
		========================= -->

		<section class="about-section" id="about">

			<div class="about-container">

				<div class="about-logo-wrap">

					<div class="logo-ring"></div>

					<div class="about-logo">

