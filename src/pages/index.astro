---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
	title="The Concepts Adda | Learn Mathematics"
	description="The Concepts Adda makes Mathematics easier through clear concepts, visual examples, practice questions and exam-focused lessons."
>

	<!-- =========================
	     NAVBAR
	========================= -->

	<header class="navbar">
		<div class="nav-container">

			<a href="/" class="brand">
				<img
					src="/logo.png"
					alt="The Concepts Adda"
					class="brand-logo"
				/>

				<div class="brand-text">
					<div class="brand-name">The Concepts Adda</div>

					<div class="brand-tagline">
						Understand. Practice. Master.
					</div>
				</div>
			</a>

			<nav class="nav-links">
				<a href="#courses">Courses</a>
				<a href="#classes">Classes</a>
				<a href="#resources">Resources</a>
				<a href="#about">About</a>
			</nav>

			<a href="/classes" class="nav-button">
				Start Learning
			</a>

		</div>
	</header>


	<main>

		<!-- =========================
		     HERO
		========================= -->

		<section class="hero" id="courses">

			<div class="hero-decoration hero-decoration-one"></div>
			<div class="hero-decoration hero-decoration-two"></div>

			<div class="hero-container">

				<div class="hero-content">

					<div class="eyebrow">
						<span></span>
						Class 9 &amp; 10 Mathematics
					</div>

					<h1>
						Don't just learn
						<br />
						formulas.
						<span class="blue-text"> Understand</span>
						<br />
						<span class="blue-text">the concept.</span>
					</h1>

					<p class="hero-description">
						The Concepts Adda makes Mathematics easier to understand
						through clear explanations, visual examples, practice
						questions and exam-focused lessons.
					</p>

					<div class="hero-buttons">

						<a href="/classes" class="primary-button">
							Explore Classes →
						</a>

						<a href="#resources" class="secondary-button">
							Watch Free Lessons
						</a>

					</div>

					<div class="hero-trust">

						<div class="trust-item">
							<span class="trust-check">✓</span>
							Concept-focused
						</div>

						<div class="trust-item">
							<span class="trust-check">✓</span>
							Exam-oriented
						</div>

						<div class="trust-item">
							<span class="trust-check">✓</span>
							Student-friendly
						</div>

					</div>

				</div>


				<!-- =========================
				     CONCEPT CARD
				========================= -->

				<div class="concept-card-wrapper">

					<div class="concept-glow"></div>

					<div class="concept-card">

						<div class="card-top">

							<div class="window-dots">
								<span></span>
								<span></span>
								<span></span>
							</div>

							<div class="card-brand">
								The Concepts Adda
							</div>

						</div>

						<div class="card-content">

							<div class="today-label">
								TODAY'S CONCEPT
							</div>

							<h2>
								Trigonometry
							</h2>

							<div class="trig-line"></div>

							<div class="trig-grid">

								<div class="trig-item active">

									<strong>sin</strong>

									<span>
										Perpendicular /
										<br />
										Hypotenuse
									</span>

								</div>

								<div class="trig-item">

									<strong>cos</strong>

									<span>
										Base /
										<br />
										Hypotenuse
									</span>

								</div>

								<div class="trig-item">

									<strong>tan</strong>

									<span>
										Perpendicular /
										<br />
										Base
									</span>

								</div>

							</div>

							<div class="remember-box">

								<div class="remember-icon">
									!
								</div>

								<div>

									<span>
										Remember
									</span>

									<strong>
										Understanding &gt; Memorizing
									</strong>

								</div>

							</div>

						</div>

					</div>

				</div>

			</div>

		</section>


		<!-- =========================
		     ABOUT
		========================= -->

		<section class="about-section" id="about">

			<div class="about-container">

				<div class="about-logo-wrap">

					<div class="logo-ring"></div>

					<div class="about-logo">

						<img
							src="/logo.png"
							alt="The Concepts Adda Logo"
						/>

					</div>

				</div>


				<div class="about-content">

					<div class="section-label">
						ABOUT THE CONCEPTS ADDA
					</div>

					<h2>
						Mathematics becomes
						<br />
						easier&nbsp;
						<span class="blue-text">
							when you understand
						</span>
						<br />
						<span class="blue-text">
							it.
						</span>
					</h2>

					<p>
						The Concepts Adda is focused on making Mathematics
						simpler through concepts, examples, practice and
						consistent learning.
					</p>

				</div>

			</div>

		</section>


		<!-- =========================
		     CLASSES
		========================= -->

		<section class="classes-section" id="classes">

			<div class="section-container">

				<div class="section-heading">

					<div class="section-label">
						LEARN WITH THE CONCEPTS ADDA
					</div>

					<h2>
						Build concepts.
						<br />
						<span class="blue-text">
							Build confidence.
						</span>
					</h2>

					<p>
						Focused Mathematics learning for students who want
						to understand instead of simply memorizing.
					</p>

				</div>


				<div class="class-grid">

					<!-- CLASS 9 -->

					<div class="class-card class-nine">

						<div class="class-number">
							09
						</div>

						<div class="class-card-content">

							<div class="class-badge">
								CLASS 09
							</div>

							<h3>
								Class 9 Mathematics
							</h3>

							<p>
								Build a strong foundation with clear
								concepts and step-by-step explanations.
							</p>

							<a href="/class-9">
								Explore Class 9 →
							</a>

						</div>

					</div>


					<!-- CLASS 10 -->

					<div class="class-card class-ten">

						<div class="class-number">
							10
						</div>

						<div class="class-card-content">

							<div class="class-badge">
								CLASS 10
							</div>

							<h3>
								Class 10 Mathematics
							</h3>

							<p>
								Master important concepts, practice
								questions and prepare confidently for exams.
							</p>

							<a href="/class-10">
								Explore Class 10 →
							</a>

						</div>

					</div>

				</div>

			</div>

		</section>


		<!-- =========================
		     RESOURCES
		========================= -->

		<section class="resources-section" id="resources">

			<div class="section-container">

				<div class="section-label">
					FREE LEARNING
				</div>

				<h2>
					Learn beyond the&nbsp;
					<span class="blue-text">
						classroom.
					</span>
				</h2>

				<p>
					Access lessons, explanations, examples and practice
					material designed to make Mathematics easier.
				</p>

				<div class="resource-grid">

					<!-- VIDEO -->

					<div class="resource-card">

						<div class="resource-icon video-icon">
							▶
						</div>

						<h3>
							Free Video Lessons
						</h3>

						<p>
							Learn difficult Mathematics concepts through
							clear and visual explanations.
						</p>

						<a href="#">
							Watch lessons →
						</a>

					</div>


					<!-- PRACTICE -->

					<div class="resource-card">

						<div class="resource-icon practice-icon">
							?
						</div>

						<h3>
							Practice Questions
						</h3>

						<p>
							Practice important questions and improve your
							problem-solving skills.
						</p>

						<a href="#">
							Start practicing →
						</a>

					</div>


					<!-- EXAM -->

					<div class="resource-card">

						<div class="resource-icon exam-icon">
							✓
						</div>

						<h3>
							Exam Preparation
						</h3>

						<p>
							Prepare smarter with focused lessons and
							exam-oriented practice.
						</p>

						<a href="#">
							Prepare smarter →
						</a>

					</div>

				</div>

			</div>

		</section>

	</main>


	<!-- =========================
	     FOOTER
	========================= -->

	<footer class="footer">

		<div class="footer-container">

			<div class="footer-brand">

				<img
					src="/logo.png"
					alt="The Concepts Adda"
				/>

				<div>

					<strong>
						The Concepts Adda
					</strong>

					<span>
						Understand. Practice. Master.
					</span>

				</div>

			</div>


			<div class="footer-links">

				<a href="#courses">
					Courses
				</a>

				<a href="#classes">
					Classes
				</a>

				<a href="#resources">
					Resources
				</a>

				<a href="#about">
					About
				</a>

			</div>

		</div>


		<div class="footer-bottom">
			© {new Date().getFullYear()} The Concepts Adda. All rights reserved.
		</div>

	</footer>


	<style>

		/* =========================
		   GLOBAL
		========================= */

		:global(html) {
			scroll-behavior: smooth;
		}


		:global(body) {
			margin: 0;
			background: #f8fafc;
			color: #14213d;

			font-family:
				Inter,
				ui-sans-serif,
				system-ui,
				-apple-system,
				BlinkMacSystemFont,
				"Segoe UI",
				sans-serif;
		}


		:global(*) {
			box-sizing: border-box;
		}


		.blue-text {
			color: #2563eb;
		}


		/* =========================
		   NAVBAR
		========================= */

		.navbar {
			width: 100%;

			background:
				rgba(255, 255, 255, 0.94);

			border-bottom:
				1px solid #e4e9f2;

			position: relative;
			z-index: 20;

			backdrop-filter:
				blur(14px);
		}


		.nav-container {
			width:
				min(1180px, calc(100% - 40px));

			min-height: 82px;

			margin: 0 auto;

			display: flex;
			align-items: center;
			justify-content: space-between;

			gap: 30px;
		}


		.brand {
			display: flex;
			align-items: center;

			gap: 12px;

			text-decoration: none;
			color: inherit;

			flex-shrink: 0;
		}


		.brand-logo {
			width: 52px;
			height: 52px;

			border-radius: 50%;

			object-fit: cover;

			display: block;

			border:
				3px solid #f4c430;

			box-shadow:
				0 4px 12px
				rgba(20, 33, 61, 0.12);
		}


		.brand-text {
			display: flex;
			flex-direction: column;

			gap: 3px;
		}


		.brand-name {
			font-size: 19px;
			font-weight: 850;
			line-height: 1.1;

			color: #14213d;
		}


		.brand-tagline {
			font-size: 12px;
			color: #727b8d;
		}


		.nav-links {
			display: flex;
			align-items: center;

			gap: 34px;

			margin-left: auto;
		}


		.nav-links a {
			color: #3d4658;

			font-size: 14px;
			font-weight: 650;

			text-decoration: none;

			transition:
				color 0.2s ease,
				transform 0.2s ease;
		}


		.nav-links a:hover {
			color: #2563eb;
		}


		.nav-button {
			text-decoration: none;

			color: #ffffff;
			background: #14213d;

			padding: 13px 21px;

			border-radius: 10px;

			font-size: 14px;
			font-weight: 750;

			box-shadow:
				0 8px 20px
				rgba(20, 33, 61, 0.14);

			white-space: nowrap;

			transition:
				background 0.2s ease,
				transform 0.2s ease,
				box-shadow 0.2s ease;
		}


		.nav-button:hover {
			background: #2563eb;

			transform: translateY(-1px);

			box-shadow:
				0 10px 24px
				rgba(37, 99, 235, 0.22);
		}


		/* =========================
		   HERO
		========================= */

		.hero {
			position: relative;

			padding: 105px 0 120px;

			overflow: hidden;

			background:
				radial-gradient(
					circle at 78% 20%,
					rgba(37, 99, 235, 0.12),
					transparent 32%
				),
				radial-gradient(
					circle at 8% 90%,
					rgba(244, 196, 48, 0.14),
					transparent 28%
				),
				linear-gradient(
					135deg,
					#f8fbff 0%,
					#eef5ff 52%,
					#f9fbff 100%
				);
		}


		.hero-decoration {
			position: absolute;

			border-radius: 50%;

			pointer-events: none;

			filter: blur(2px);
		}


		.hero-decoration-one {
			width: 120px;
			height: 120px;

			right: 8%;
			top: 8%;

			border:
				2px solid
				rgba(37, 99, 235, 0.08);
		}


		.hero-decoration-two {
			width: 180px;
			height: 180px;

			left: -70px;
			bottom: -80px;

			border:
				2px solid
				rgba(244, 196, 48, 0.12);
		}


		.hero-container {
			position: relative;
			z-index: 2;

			width:
				min(1180px, calc(100% - 40px));

			margin: 0 auto;

			display: grid;

			grid-template-columns:
				minmax(0, 1fr)
				minmax(430px, 0.9fr);

			align-items: center;

			gap: 75px;
		}


		.hero-content {
			min-width: 0;
		}


		.eyebrow {
			display: inline-flex;
			align-items: center;

			gap: 10px;

			padding: 9px 16px;

			border:
				1px solid
				rgba(37, 99, 235, 0.12);

			border-radius: 999px;

			background:
				rgba(255, 255, 255, 0.78);

			color: #315a9f;

			font-size: 14px;
			font-weight: 750;

			margin-bottom: 25px;

			box-shadow:
				0 5px 18px
				rgba(20, 33, 61, 0.05);
		}


		.eyebrow span {
			width: 8px;
			height: 8px;

			border-radius: 50%;

			background: #f4c430;

			box-shadow:
				0 0 0 4px
				rgba(244, 196, 48, 0.18);
		}


		.hero h1 {
			margin: 0;

			max-width: 680px;

			font-size:
				clamp(48px, 5.2vw, 72px);

			line-height: 0.99;

			letter-spacing: -3.5px;

			font-weight: 850;

			color: #14213d;
		}


		.hero-description {
			max-width: 610px;

			margin: 30px 0 0;

			font-size: 17px;

			line-height: 1.7;

			color: #626d80;
		}


		.hero-buttons {
			display: flex;
			align-items: center;

			gap: 12px;

			margin-top: 30px;
		}


		.primary-button,
		.secondary-button {
			display: inline-flex;

			align-items: center;
			justify-content: center;

			min-height: 48px;

			padding: 0 22px;

			border-radius: 10px;

			text-decoration: none;

			font-size: 14px;
			font-weight: 750;

			transition:
				transform 0.2s ease,
				box-shadow 0.2s ease,
				background 0.2s ease;
		}


		.primary-button {
			background: #2563eb;
			color: #ffffff;

			box-shadow:
				0 10px 25px
				rgba(37, 99, 235, 0.22);
		}


		.primary-button:hover {
			transform: translateY(-2px);

			background: #1d4ed8;

			box-shadow:
				0 14px 30px
				rgba(37, 99, 235, 0.27);
		}


		.secondary-button {
			color: #14213d;

			border:
				1px solid #d7deea;

			background:
				rgba(255, 255, 255, 0.82);
		}


		.secondary-button:hover {
			transform: translateY(-2px);

			border-color: #a9b9d3;

			background: #ffffff;
		}


		.hero-trust {
			display: flex;

			flex-wrap: wrap;

			gap: 18px;

			margin-top: 28px;
		}


		.trust-item {
			display: flex;
			align-items: center;

			gap: 7px;

			font-size: 12px;
			font-weight: 650;

			color: #697487;
		}


		.trust-check {
			display: inline-flex;

			align-items: center;
			justify-content: center;

			width: 19px;
			height: 19px;

			border-radius: 50%;

			background: #f4c430;

			color: #14213d;

			font-size: 11px;
			font-weight: 900;
		}


		/* =========================
		   CONCEPT CARD
		========================= */

		.concept-card-wrapper {
			position: relative;

			width: 100%;

			display: flex;

			align-items: center;
			justify-content: center;
		}


		.concept-glow {
			position: absolute;

			width: 320px;
			height: 320px;

			border-radius: 50%;

			background:
				rgba(37, 99, 235, 0.16);

			filter: blur(60px);

			pointer-events: none;
		}


		.concept-card {
			position: relative;

			z-index: 2;

			width: 100%;

			max-width: 510px;

			background: #14213d;

			border:
				1px solid
				rgba(255, 255, 255, 0.08);

			border-radius: 24px;

			padding: 11px;

			box-shadow:
				0 30px 70px
				rgba(20, 33, 61, 0.22),
				0 8px 20px
				rgba(20, 33, 61, 0.12);
		}


		.card-top {
			height: 42px;

			display: flex;

			align-items: center;
			justify-content: space-between;

			padding: 0 12px;
		}


		.window-dots {
			display: flex;

			gap: 7px;
		}


		.window-dots span {
			width: 10px;
			height: 10px;

			border-radius: 50%;

			background: #596a88;
		}


		.window-dots span:nth-child(2) {
			background: #f4c430;
		}


		.card-brand {
			font-size: 10px;

			color: #c9d0df;

			font-weight: 650;
		}


		.card-content {
			background:
				linear-gradient(
					145deg,
					#ffffff,
					#f7faff
				);

			border-radius: 16px;

			padding: 27px 25px 25px;
		}


		.today-label {
			font-size: 11px;

			font-weight: 850;

			letter-spacing: 1.4px;

			color: #2563eb;

			margin-bottom: 7px;
		}


		.card-content h2 {
			margin: 0;

			font-size: 28px;

			line-height: 1.2;

			color: #14213d;

			font-weight: 850;
		}


		.trig-line {
			width: 48px;
			height: 4px;

			margin-top: 12px;

			border-radius: 99px;

			background: #f4c430;
		}


		.trig-grid {
			display: grid;

			grid-template-columns:
				repeat(3, 1fr);

			gap: 10px;

			margin-top: 24px;
		}


		.trig-item {
			min-height: 105px;

			border:
				1px solid #e4e9f2;

			border-radius: 13px;

			background: #ffffff;

			display: flex;

			flex-direction: column;

			align-items: center;
			justify-content: center;

			text-align: center;

			padding: 10px;

			transition:
				transform 0.2s ease,
				box-shadow 0.2s ease;
		}


		.trig-item:hover {
			transform: translateY(-2px);

			box-shadow:
				0 8px 18px
				rgba(20, 33, 61, 0.08);
		}


		.trig-item.active {
			border-color:
				rgba(37, 99, 235, 0.25);

			background: #eef4ff;
		}


		.trig-item strong {
			font-family: Georgia, serif;

			font-size: 23px;

			font-style: italic;

			color: #14213d;
		}


		.trig-item.active strong {
			color: #2563eb;
		}


		.trig-item span {
			margin-top: 7px;

			font-size: 9px;

			line-height: 1.4;

			color: #687180;
		}


		.remember-box {
			margin-top: 15px;

			min-height: 76px;

			border-radius: 13px;

			background: #14213d;

			display: flex;

			align-items: center;

			gap: 12px;

			padding: 12px 18px;
		}


		.remember-icon {
			width: 30px;
			height: 30px;

			flex-shrink: 0;

			display: flex;

			align-items: center;
			justify-content: center;

			border-radius: 50%;

			background: #f4c430;

			color: #14213d;

			font-weight: 900;
		}


		.remember-box div:last-child {
			display: flex;

			flex-direction: column;
		}


		.remember-box span {
			font-size: 10px;

			color: #aeb8cb;

			margin-bottom: 4px;
		}


		.remember-box strong {
			font-size: 14px;

			color: #ffffff;
		}


		/* =========================
		   ABOUT
		========================= */

		.about-section {
			position: relative;

			padding: 115px 0;

			background:
				linear-gradient(
					120deg,
					#fffdf5 0%,
					#ffffff 48%,
					#f4f8ff 100%
				);

			overflow: hidden;
		}


		.about-section::before {
			content: "";

			position: absolute;

			width: 250px;
			height: 250px;

			right: -100px;
			top: -100px;

			border-radius: 50%;

			background:
