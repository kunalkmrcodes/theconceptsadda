		.hero h1 {
			margin: 0;

			max-width: 680px;

			font-size:
				clamp(48px, 5.2vw, 72px);

			line-height: 1.02;

			letter-spacing: -0.8px;

			font-weight: 850;

			color: #14213d;
		}


		.hero-description {
			max-width: 610px;

			margin: 30px 0 0;

			font-size: 17px;

			line-height: 1.7;

			color: #626d80;
		}


		.hero-buttons {
			display: flex;
			align-items: center;

			gap: 12px;

			margin-top: 30px;
		}


		.primary-button,
		.secondary-button {
			display: inline-flex;

			align-items: center;
			justify-content: center;

			min-height: 48px;

			padding: 0 22px;

			border-radius: 10px;

			text-decoration: none;

			font-size: 14px;
			font-weight: 750;

			transition:
				transform 0.2s ease,
				box-shadow 0.2s ease,
				background 0.2s ease;
		}


		.primary-button {
			background: #2563eb;
			color: #ffffff;

			box-shadow:
				0 10px 25px
				rgba(37, 99, 235, 0.22);
		}


		.primary-button:hover {
			transform: translateY(-2px);

			background: #1d4ed8;

			box-shadow:
				0 14px 30px
				rgba(37, 99, 235, 0.27);
		}


		.secondary-button {
			color: #14213d;

			border:
				1px solid #d7deea;

			background:
				rgba(255, 255, 255, 0.82);
		}


		.secondary-button:hover {
			transform: translateY(-2px);

			border-color: #a9b9d3;

			background: #ffffff;
		}


		.hero-trust {
			display: flex;

			flex-wrap: wrap;

			gap: 18px;

			margin-top: 28px;
		}


		.trust-item {
			display: flex;
			align-items: center;

			gap: 7px;

			font-size: 12px;
			font-weight: 650;

			color: #697487;
		}


		.trust-check {
			display: inline-flex;

			align-items: center;
			justify-content: center;

			width: 19px;
			height: 19px;

			border-radius: 50%;

			background: #f4c430;

			color: #14213d;

			font-size: 11px;
			font-weight: 900;
		}


		/* =========================
		   CONCEPT CARD
		========================= */

		.concept-card-wrapper {
			position: relative;

			width: 100%;

			display: flex;

			align-items: center;
			justify-content: center;
		}


		.concept-glow {
			position: absolute;

			width: 320px;
			height: 320px;

			border-radius: 50%;

			background:
				rgba(37, 99, 235, 0.16);

			filter: blur(60px);

			pointer-events: none;
		}


		.concept-card {
			position: relative;

			z-index: 2;

			width: 100%;

			max-width: 510px;

			background: #14213d;

			border:
				1px solid
				rgba(255, 255, 255, 0.08);

			border-radius: 24px;

			padding: 11px;

			box-shadow:
				0 30px 70px
				rgba(20, 33, 61, 0.22),
				0 8px 20px
				rgba(20, 33, 61, 0.12);
		}


		.card-top {
			height: 42px;

			display: flex;

			align-items: center;
			justify-content: space-between;

			padding: 0 12px;
		}


		.window-dots {
			display: flex;

			gap: 7px;
		}


		.window-dots span {
			width: 10px;
			height: 10px;

			border-radius: 50%;

			background: #596a88;
		}


		.window-dots span:nth-child(2) {
			background: #f4c430;
		}


		.card-brand {
			font-size: 10px;

			color: #c9d0df;

			font-weight: 650;
		}


		.card-content {
			background:
				linear-gradient(
					145deg,
					#ffffff,
					#f7faff
				);

			border-radius: 16px;

			padding: 27px 25px 25px;
		}


		.today-label {
			font-size: 11px;

			font-weight: 850;

			letter-spacing: 1.4px;

			color: #2563eb;

			margin-bottom: 7px;
		}


		.card-content h2 {
			margin: 0;

			font-size: 28px;

			line-height: 1.2;

			color: #14213d;

			font-weight: 850;
		}


		.trig-line {
			width: 48px;
			height: 4px;

			margin-top: 12px;

			border-radius: 99px;

			background: #f4c430;
		}


		.trig-grid {
			display: grid;

			grid-template-columns:
				repeat(3, 1fr);

			gap: 10px;

			margin-top: 24px;
		}


		.trig-item {
			min-height: 105px;

			border:
				1px solid #e4e9f2;

			border-radius: 13px;

			background: #ffffff;

			display: flex;

			flex-direction: column;

			align-items: center;
			justify-content: center;

			text-align: center;

			padding: 10px;

			transition:
				transform 0.2s ease,
				box-shadow 0.2s ease;
		}


		.trig-item:hover {
			transform: translateY(-2px);

			box-shadow:
				0 8px 18px
				rgba(20, 33, 61, 0.08);
		}


		.trig-item.active {
			border-color:
				rgba(37, 99, 235, 0.25);

			background: #eef4ff;
		}


		.trig-item strong {
			font-family: Georgia, serif;

			font-size: 23px;

			font-style: italic;

			color: #14213d;
		}


		.trig-item.active strong {
			color: #2563eb;
		}


		.trig-item span {
			margin-top: 7px;

			font-size: 9px;

			line-height: 1.4;

			color: #687180;
		}


		.remember-box {
			margin-top: 15px;

			min-height: 76px;

			border-radius: 13px;

			background: #14213d;

			display: flex;

			align-items: center;

			gap: 12px;

			padding: 12px 18px;
		}


		.remember-icon {
			width: 30px;
			height: 30px;

			flex-shrink: 0;

			display: flex;

			align-items: center;
			justify-content: center;

			border-radius: 50%;

			background: #f4c430;

			color: #14213d;

			font-weight: 900;
		}


		.remember-box div:last-child {
			display: flex;

			flex-direction: column;
		}


		.remember-box span {
			font-size: 10px;

			color: #aeb8cb;

			margin-bottom: 4px;
		}


		.remember-box strong {
			font-size: 14px;

			color: #ffffff;
		}


		/* =========================
		   ABOUT
		========================= */

		.about-section {
			position: relative;

			padding: 115px 0;

			background:
				linear-gradient(
					120deg,
					#fffdf5 0%,
					#ffffff 48%,
					#f4f8ff 100%
				);

			overflow: hidden;
		}


		.about-section::before {
			content: "";

			position: absolute;

			width: 250px;
			height: 250px;

			right: -100px;
			top: -100px;

			border-radius: 50%;

			background:
				rgba(244, 196, 48, 0.11);

			filter: blur(20px);
		}


		.about-container {
			position: relative;

			z-index: 2;

			width:
				min(1180px, calc(100% - 40px));

			margin: 0 auto;

			display: grid;

			grid-template-columns:
				260px
				minmax(0, 1fr);

			align-items: center;

			gap: 65px;
		}


		.about-logo-wrap {
			position: relative;

			display: flex;

			align-items: center;
			justify-content: center;
		}


		.logo-ring {
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);

			width: 245px;
			height: 245px;

			border:
				2px dashed
				rgba(244, 196, 48, 0.55);

			border-radius: 50%;
			pointer-events: none;
		}


		.about-logo {
			position: relative;

			z-index: 2;

			display: flex;

			align-items: center;
			justify-content: center;

			width: 225px;
			height: 225px;

			border-radius: 50%;

			background: #ffffff;

			box-shadow:
				0 20px 45px
				rgba(20, 33, 61, 0.13);
		}


		.about-logo img {
			width: 210px;
			height: 210px;

			object-fit: cover;

			border-radius: 50%;

			display: block;
		}


		.section-label {
			color: #2563eb;

			font-size: 12px;

			font-weight: 850;

			letter-spacing: 2px;

			margin-bottom: 22px;
		}


		.about-content h2,
		.section-heading h2,
		.resources-section h2 {
			margin: 0;

			font-size:
				clamp(40px, 4.5vw, 60px);

			line-height: 1.06;

			letter-spacing: -2.5px;

			color: #14213d;

			font-weight: 850;
		}


		.about-content p {
			max-width: 720px;

			margin: 30px 0 0;

			font-size: 17px;

			line-height: 1.7;

			color: #687180;
		}


		/* =========================
		   CLASSES
		========================= */

		.classes-section {
			padding: 110px 0;

			background: #f2f6fc;
		}


		.section-container {
			width:
				min(1180px, calc(100% - 40px));

			margin: 0 auto;
		}


		.section-heading {
			max-width: 700px;

			margin-bottom: 50px;
		}


		.section-heading p {
			max-width: 650px;

			margin: 25px 0 0;

			font-size: 17px;

			line-height: 1.7;

			color: #687180;
		}


		.class-grid {
			display: grid;

			grid-template-columns:
				repeat(2, minmax(0, 1fr));

			gap: 22px;
		}


		.class-card {
			position: relative;

			overflow: hidden;

			padding: 35px;

			border-radius: 22px;

			display: flex;

			gap: 25px;

			min-height: 250px;

			transition:
				transform 0.25s ease,
				box-shadow 0.25s ease;
		}


		.class-card:hover {
			transform: translateY(-5px);
		}


		.class-nine {
			background:
				radial-gradient(circle at 85% 15%, rgba(56, 189, 248, 0.2) 0%, transparent 55%),
				linear-gradient(135deg, #090d16 0%, #152238 100%);

			border:
				1px solid rgba(255, 255, 255, 0.09);

			color: #ffffff;

			box-shadow:
				0 18px 40px
				rgba(9, 13, 22, 0.35);
		}


		.class-ten {
			background:
				radial-gradient(circle at 85% 15%, rgba(244, 196, 48, 0.18) 0%, transparent 55%),
				linear-gradient(
					135deg,
					#0b1329 0%,
					#172544 100%
				);

			border:
				1px solid rgba(255, 255, 255, 0.09);

			color: #ffffff;

			box-shadow:
				0 18px 40px
				rgba(11, 19, 41, 0.35);
		}


		.class-number {
			position: relative;

			z-index: 2;

			font-size: 45px;

			font-weight: 900;

			line-height: 1;

			color: #38bdf8;
		}


		.class-ten .class-number {
			color: #f4c430;
		}


		.class-card-content {
			position: relative;

			z-index: 2;
		}


		.class-badge {
			display: inline-flex;

			padding: 5px 9px;

			border-radius: 999px;

			background: rgba(56, 189, 248, 0.12);

			color: #38bdf8;

			border: 1px solid rgba(56, 189, 248, 0.25);

			font-size: 9px;

			font-weight: 850;

			letter-spacing: 1px;

			margin-bottom: 12px;
		}


		.class-ten .class-badge {
			background:
				rgba(244, 196, 48, 0.12);

			color: #f4c430;

			border: 1px solid rgba(244, 196, 48, 0.25);
		}


		.class-card h3 {
			margin: 0;

			font-size: 22px;

			font-weight: 850;

			color: #ffffff;
		}


		.class-card p {
			margin: 13px 0 20px;

			line-height: 1.6;

			color: #94a3b8;
		}


		.class-card a {
			color: #38bdf8;

			text-decoration: none;

			font-size: 14px;

			font-weight: 800;
		}


		.class-ten a {
			color: #f4c430;
		}


		/* =========================
		   RESOURCES
		========================= */

		.resources-section {
			position: relative;

			padding: 110px 0;

			background:
				radial-gradient(
					circle at 90% 20%,
					rgba(37, 99, 235, 0.08),
					transparent 25%
				),
				#ffffff;
		}


		.resources-section > .section-container > p {
			max-width: 650px;

			margin: 25px 0 45px;

			font-size: 17px;

			line-height: 1.7;

			color: #687180;
		}


		.resource-grid {
			display: grid;

			grid-template-columns:
				repeat(3, minmax(0, 1fr));

			gap: 20px;
		}


		.resource-card {
			position: relative;

			padding: 30px;

			border:
				1px solid #e2e8f2;

			border-radius: 20px;

			background: #ffffff;

			box-shadow:
				0 10px 30px
				rgba(20, 33, 61, 0.045);

			transition:
				transform 0.25s ease,
				box-shadow 0.25s ease,
				border-color 0.25s ease;
		}


		.resource-card:hover {
			transform: translateY(-5px);

			border-color: #c9d8ee;

			box-shadow:
				0 18px 40px
				rgba(20, 33, 61, 0.09);
		}


		.resource-icon {
			width: 48px;
			height: 48px;

			border-radius: 14px;

			display: flex;

			align-items: center;
			justify-content: center;

			font-weight: 900;

			margin-bottom: 22px;
		}


		.video-icon {
			background: #eaf1ff;

			color: #2563eb;
		}


		.practice-icon {
			background: #fff7d8;

			color: #9a7400;
		}


		.exam-icon {
			background: #e8f7ef;

			color: #16834b;
		}


		.resource-card h3 {
			margin: 0;

			font-size: 19px;

			color: #14213d;

			font-weight: 850;
		}


		.resource-card p {
			margin: 12px 0 18px;

			color: #707887;

			line-height: 1.6;

			font-size: 15px;
		}


		.resource-card a {
			color: #2563eb;

			text-decoration: none;

			font-size: 13px;

			font-weight: 800;
		}


		/* =========================
		   FOOTER
		========================= */

		.footer {
			background:
				radial-gradient(
					circle at 80% 0%,
					rgba(37, 99, 235, 0.18),
					transparent 30%
				),
				#0d172b;

			color: white;

			padding: 60px 0 25px;
		}


		.footer-container {
			width:
				min(1180px, calc(100% - 40px));

			margin: 0 auto;

			display: flex;

			align-items: center;
			justify-content: space-between;

			gap: 30px;
		}


		.footer-brand {
			display: flex;

			align-items: center;

			gap: 12px;
		}


		.footer-brand img {
			width: 50px;
			height: 50px;

			border-radius: 50%;

			object-fit: cover;

			border:
				2px solid #f4c430;
		}


		.footer-brand div {
			display: flex;

			flex-direction: column;

			gap: 4px;
		}


		.footer-brand strong {
			font-size: 17px;
		}


		.footer-brand span {
			font-size: 12px;

			color: #aeb7c7;
		}


		.footer-links {
			display: flex;

			gap: 25px;
		}


		.footer-links a {
			color: #c4cad5;

			text-decoration: none;

			font-size: 13px;

			transition:
				color 0.2s ease;
		}


		.footer-links a:hover {
			color: #f4c430;
		}


		.footer-bottom {
			width:
				min(1180px, calc(100% - 40px));

			margin: 45px auto 0;

			padding-top: 20px;

			border-top:
				1px solid
				rgba(255, 255, 255, 0.1);

			color: #8993a5;

			font-size: 12px;
		}


		/* =========================
		   TABLET
		========================= */

		@media (max-width: 1000px) {

			.nav-links {
				gap: 18px;
			}


			.hero-container {
				grid-template-columns: 1fr;

				gap: 60px;
			}


			.hero-content {
				max-width: 760px;
			}


			.concept-card-wrapper {
				justify-content: flex-start;
			}


			.concept-card {
				max-width: 650px;
			}


			.about-container {
				grid-template-columns:
					190px
					minmax(0, 1fr);

				gap: 40px;
			}


			.about-logo {
				width: 190px;
				height: 190px;
			}


			.about-logo img {
				width: 175px;
				height: 175px;
			}


			.logo-ring {
				width: 210px;
				height: 210px;
			}

		}


		/* =========================
		   MOBILE
		========================= */

		@media (max-width: 700px) {

			.nav-container {
				width:
					min(100% - 28px, 1180px);

				min-height: 72px;
			}


			.brand-logo {
				width: 43px;
				height: 43px;
			}


			.brand-name {
				font-size: 16px;
			}


			.brand-tagline {
				font-size: 10px;
			}


			.nav-links {
				display: none;
			}


			.nav-button {
				padding: 10px 14px;

				font-size: 12px;
			}


			.hero {
				padding: 70px 0 80px;
			}


			.hero-container,
			.about-container,
			.section-container {
				width:
					min(100% - 28px, 1180px);
			}


			.hero h1 {
				font-size:
					clamp(43px, 12vw, 60px);

				letter-spacing: -0.5px;

				line-height: 1.05;
			}


			.hero-description {
				font-size: 15px;
			}


			.hero-buttons {
				flex-direction: column;

				align-items: stretch;
			}


			.primary-button,
			.secondary-button {
				width: 100%;
			}


			.hero-trust {
				gap: 11px;
			}


			.trust-item {
				font-size: 11px;
			}


			.concept-card {
				border-radius: 17px;

				padding: 8px;
			}


			.card-content {
				padding: 22px 16px 18px;
			}


			.trig-grid {
				gap: 6px;
			}


			.trig-item {
				min-height: 90px;
			}


			.trig-item strong {
				font-size: 19px;
			}


			.trig-item span {
				font-size: 8px;
			}


			.remember-box strong {
				font-size: 12px;
			}


			.about-section,
			.classes-section,
			.resources-section {
				padding: 80px 0;
			}


			.about-container {
				grid-template-columns: 1fr;

				gap: 40px;
			}


			.about-logo-wrap {
				display: inline-flex;
				align-items: center;
				justify-content: center;

				width: 160px;
				height: 160px;
			}


			.about-logo {
				width: 140px;
				height: 140px;
			}


			.about-logo img {
				width: 130px;
				height: 130px;
			}


			.logo-ring {
				width: 160px;
				height: 160px;
			}


			.about-content h2,
			.section-heading h2,
			.resources-section h2 {
				font-size: 42px;

				letter-spacing: -1.8px;
			}


			.class-grid,
			.resource-grid {
				grid-template-columns: 1fr;
			}


			.class-card {
				padding: 25px;

				gap: 18px;
			}


			.class-number {
				font-size: 38px;
			}


			.footer-container {
				width:
					min(100% - 28px, 1180px);

				flex-direction: column;

				align-items: flex-start;
			}


			.footer-links {
				flex-wrap: wrap;
			}


			.footer-bottom {
				width:
					min(100% - 28px, 1180px);
			}

		}


		/* =========================
		   EXAM PREPARATION HUB STYLES
		========================= */

		.exam-prep-section {
			padding: 90px 0;
			background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
			border-top: 1px solid #e2e8f0;
			border-bottom: 1px solid #e2e8f0;
		}

		.text-center {
