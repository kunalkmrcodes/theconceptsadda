								<a href="/practice/class-10/triangles" class="pyq-tag">Triangles (10 Marks)</a>

								<a href="/practice/class-10/linear-equations" class="pyq-tag">Linear Equations (8 Marks)</a>

								<a href="/practice/class-10/quadratic-equations" class="pyq-tag">Quadratic Eq (7 Marks)</a>

								<a href="/practice/class-10/surface-areas-and-volumes" class="pyq-tag">Surface Areas (6 Marks)</a>

								<a href="/practice/class-10/statistics" class="pyq-tag">Statistics (7 Marks)</a>

							</div>

							<a href="/practice/class-10" class="prep-card-btn gold-btn">
								Solve Class 10 Board PYQs →
							</a>

						</div>


						<!-- CARD 2: Sample Papers & Mock Tests -->

						<div class="prep-card">

							<div class="prep-card-header">

								<span class="prep-icon">📑</span>

								<div>

									<span class="card-tag">CBSE PATTERN 2024-25</span>

									<h3>Class 10 Board Sample Papers</h3>

								</div>

							</div>

							<p>
								Full-length 80-Mark Sample Question Papers designed strictly on the latest CBSE curriculum with step-by-step solutions.
							</p>

							<ul class="prep-feature-list">

								<li>✓ Standard Mathematics Model Paper (80 Marks)</li>

								<li>✓ Basic Mathematics Model Paper (80 Marks)</li>

								<li>✓ 3-Hour Time Management Strategy</li>

							</ul>

							<a href="/practice/class-10" class="prep-card-btn">
								Practice Sample Papers →
							</a>

						</div>


						<!-- CARD 3: Case Study Masterclass -->

						<div class="prep-card">

							<div class="prep-card-header">

								<span class="prep-icon">⚡</span>

								<div>

									<span class="card-tag">COMPETENCY BASED</span>

									<h3>Case Study &amp; 5-Mark Masterclass</h3>

								</div>

							</div>

							<p>
								Master Section E Case-Study Questions (12 Marks) and Section D 5-Mark Theorem Proofs (20 Marks) to guarantee top score.
							</p>

							<ul class="prep-feature-list">

								<li>✓ Real-life Applications of Trigonometry</li>

								<li>✓ Coordinate Geometry Seating Grid Problems</li>

								<li>✓ Circles Tangent Theorem Proofs</li>

							</ul>

							<a href="/practice/class-10" class="prep-card-btn">
								Start Case Study Practice →
							</a>

						</div>

					</div>

				</div>


				<!-- CLASS 9 EXAM PREP CONTENT -->

				<div class="exam-tab-content" id="class-9-prep">

					<div class="prep-grid">

						<!-- CARD 1: Annual Exam Question Bank -->

						<div class="prep-card featured-card blue-theme">

							<div class="prep-card-header">

								<span class="prep-icon">📘</span>

								<div>

									<span class="card-tag blue-tag">CHAPTER-WISE PRACTICE</span>

									<h3>Class 9 Annual Exam Question Bank</h3>

								</div>

							</div>

							<p>
								240+ hand-crafted NCERT &amp; Annual Exam practice problems categorized by MCQs, Short Answers, Proofs &amp; Case Studies.
							</p>

							<div class="pyq-chapter-tags">

								<a href="/practice/class-9/number-systems" class="pyq-tag blue-tag">Number Systems</a>

								<a href="/practice/class-9/polynomials" class="pyq-tag blue-tag">Polynomials</a>

								<a href="/practice/class-9/lines-and-angles" class="pyq-tag blue-tag">Lines &amp; Angles</a>

								<a href="/practice/class-9/triangles" class="pyq-tag blue-tag">Triangles</a>

								<a href="/practice/class-9/quadrilaterals" class="pyq-tag blue-tag">Quadrilaterals</a>

								<a href="/practice/class-9/circles" class="pyq-tag blue-tag">Circles</a>

							</div>

							<a href="/practice/class-9" class="prep-card-btn blue-btn">
								Solve Class 9 Practice Sets →
							</a>

						</div>


						<!-- CARD 2: Class 9 Final Term Sample Papers -->

						<div class="prep-card">

							<div class="prep-card-header">

								<span class="prep-icon">📝</span>

								<div>

									<span class="card-tag">ANNUAL PATTERN</span>

									<h3>Class 9 Final Term Sample Papers</h3>

								</div>

							</div>

							<p>
								80-Mark Annual Examination Question Papers designed according to the latest CBSE pattern with complete solutions.
							</p>

							<ul class="prep-feature-list">

								<li>✓ Annual Final Exam Model Paper (80 Marks)</li>

								<li>✓ Half-Yearly Revision Mock Test</li>

								<li>✓ Step-by-Step Marking Scheme</li>

							</ul>

							<a href="/practice/class-9" class="prep-card-btn">
								Practice Annual Papers →
							</a>

						</div>


						<!-- CARD 3: Geometry Proofs & Formula Bank -->

						<div class="prep-card">

							<div class="prep-card-header">

								<span class="prep-icon">🧠</span>

								<div>

									<span class="card-tag">CONCEPT REVISION</span>

									<h3>Class 9 Geometry &amp; Formula Bank</h3>

								</div>

							</div>

							<p>
								Quick revision sheets for Mid-Point Theorem, Congruence Criteria, Euclid's Axioms, Heron's Formula &amp; Surface Areas.
							</p>

							<ul class="prep-feature-list">

								<li>✓ Triangle Congruence Proofs (SAS, SSS, ASA, RHS)</li>

								<li>✓ Parallelogram &amp; Circle Theorems</li>

								<li>✓ Heron's Formula &amp; Mensuration Cheat Sheet</li>

							</ul>

							<a href="/practice/class-9" class="prep-card-btn">
								Revise Formula Bank →
							</a>

						</div>

					</div>

