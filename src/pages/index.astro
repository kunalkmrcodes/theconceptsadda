				</div>


				<!-- CLASS 10 EXAM PREP CONTENT -->

				<div class="exam-tab-content active" id="class-10-prep">

					<div class="prep-grid">

						<!-- CARD 1: Board PYQs -->

						<div class="prep-card featured-card">

							<div class="prep-card-header">

								<span class="prep-icon">🏆</span>

								<div>

									<span class="card-tag gold-tag">HIGH WEIGHTAGE</span>

									<h3>Class 10 Board PYQs (2015-2024)</h3>

								</div>

							</div>

							<p>
								Chapter-wise solved Board Previous Year Questions categorized by 1-Mark MCQs, 2-Mark Short Answer, 3-Mark Long Answer &amp; 5-Mark Proofs.
							</p>

							<div class="pyq-chapter-tags">

