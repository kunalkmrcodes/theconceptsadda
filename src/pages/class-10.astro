---
import Layout from "../layouts/Layout.astro";
import PracticeSection from "../components/PracticeSection.astro";
import "../styles/global.css";
---

<Layout
	title="Class 10 Mathematics | The Concepts Adda"
	description="Learn Class 10 Mathematics with clear concepts, examples, practice questions and exam-focused lessons."
>

	<main class="class10-page">

		<!-- NAVBAR -->

		<header class="class10-navbar">
			<div class="class10-nav-container">

				<a href="/" class="class10-brand">
					<img
						src="/logo.png"
						alt="The Concepts Adda"
					/>

					<div>
						<strong>The Concepts Adda</strong>
						<span>Understand. Practice. Master.</span>
					</div>
				</a>

				<a href="/" class="back-home">
					← Home
				</a>

			</div>
		</header>


		<!-- HERO -->

		<section class="class10-hero">

			<div class="class10-container">

				<div class="class10-hero-content">

					<div class="class10-label">
						CLASS 10 MATHEMATICS
					</div>

					<h1>
						Master Mathematics.
						<br />
						<span>Understand every concept.</span>
					</h1>

					<p>
						Build strong concepts, solve questions with confidence
						and prepare smarter for your Class 10 Mathematics exams.
					</p>

					<div class="hero-stats">

						<div>
							<strong>14</strong>
							<span>Chapters</span>
						</div>

						<div>
							<strong>∞</strong>
							<span>Practice</span>
						</div>

						<div>
							<strong>100%</strong>
							<span>Concept Focus</span>
						</div>

					</div>

				</div>


				<div class="math-visual">

					<div class="visual-top">
						<span></span>
						<span></span>
						<span></span>
					</div>

					<div class="visual-content">

						<div class="visual-small">
							CLASS 10
						</div>

						<div class="equation">
							<span>x²</span>
							<span>+</span>
							<span>2x</span>
							<span>+</span>
							<span>1</span>
						</div>

						<div class="equation-line"></div>

						<div class="visual-answer">
							Understanding
							<strong>&gt;</strong>
							Memorizing
						</div>

					</div>

				</div>

			</div>

		</section>


		<!-- CHAPTERS -->

		<section class="chapters-section">

			<div class="class10-container">

				<div class="section-intro">

					<div class="class10-label">
						CLASS 10 SYLLABUS
					</div>

					<h2>
						Choose a chapter.
						<br />
						<span>Start understanding.</span>
					</h2>

					<p>
						Explore Mathematics chapter by chapter and learn
						at your own pace.
					</p>

				</div>


				<div class="chapter-grid">

					<a href="/real-numbers" class="chapter-card featured-chapter">

						<div class="chapter-number">01</div>

						<div class="chapter-info">
							<span>Chapter 01</span>
							<h3>Real Numbers</h3>
							<p>
								Master prime factorisation, HCF × LCM = a × b,
								and proofs of irrational numbers.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>


					<a href="/polynomials" class="chapter-card featured-chapter">

						<div class="chapter-number">02</div>

						<div class="chapter-info">
							<span>Chapter 02</span>
							<h3>Polynomials</h3>
							<p>
								Master zeroes, relationships between
								zeroes and coefficients and graphs.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>


					<a href="/linear-equations" class="chapter-card featured-chapter">

						<div class="chapter-number">03</div>

						<div class="chapter-info">
							<span>Chapter 03</span>
							<h3>Pair of Linear Equations</h3>
							<p>
								Learn graphical and algebraic methods
								to solve linear equations.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>


					<a href="/quadratic-equations" class="chapter-card featured-chapter">

						<div class="chapter-number">04</div>

						<div class="chapter-info">
							<span>Chapter 04</span>
							<h3>Quadratic Equations</h3>
							<p>
								Understand factorisation, formula and
								the nature of roots.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>


					<a href="/arithmetic-progressions" class="chapter-card featured-chapter">

						<div class="chapter-number">05</div>

						<div class="chapter-info">
							<span>Chapter 05</span>
							<h3>Arithmetic Progressions</h3>
							<p>
								Learn patterns, nth term and sum of
								the first n terms.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>


					<a href="/triangles" class="chapter-card featured-chapter">

						<div class="chapter-number">06</div>

						<div class="chapter-info">
							<span>Chapter 06</span>
							<h3>Triangles</h3>
							<p>
								Build a strong understanding of similarity
								and important theorems.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>


					<a href="/coordinate-geometry" class="chapter-card featured-chapter">

						<div class="chapter-number">07</div>

						<div class="chapter-info">
							<span>Chapter 07</span>
							<h3>Coordinate Geometry</h3>
							<p>
								Master distance formula, section formula,
								mid-point formula, and collinearity.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>


					<a href="/trigonometry" class="chapter-card featured-chapter">

						<div class="chapter-number">08</div>

						<div class="chapter-info">
							<span>Chapter 08</span>
							<h3>Introduction to Trigonometry</h3>
							<p>
								Understand trigonometric ratios and
								their applications.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>


					<a href="/applications-of-trigonometry" class="chapter-card featured-chapter">

						<div class="chapter-number">09</div>

						<div class="chapter-info">
							<span>Chapter 09</span>
							<h3>Applications of Trigonometry</h3>
							<p>
								Solve real-world problems using
								heights and distances.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>


					<a href="/circles" class="chapter-card featured-chapter">

						<div class="chapter-number">10</div>

						<div class="chapter-info">
							<span>Chapter 10</span>
							<h3>Circles</h3>
							<p>
								Explore tangents and important
								properties of circles.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>


					<a href="/areas-related-to-circles" class="chapter-card featured-chapter">

						<div class="chapter-number">11</div>

						<div class="chapter-info">
							<span>Chapter 11</span>
							<h3>Areas Related to Circles</h3>
							<p>
								Learn how to calculate areas and
								perimeters involving circles.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>


					<a href="/surface-areas-and-volumes" class="chapter-card featured-chapter">

						<div class="chapter-number">12</div>

						<div class="chapter-info">
							<span>Chapter 12</span>
							<h3>Surface Areas &amp; Volumes</h3>
							<p>
								Understand surface areas and volumes
								of three-dimensional figures.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>


					<a href="/statistics" class="chapter-card featured-chapter">

						<div class="chapter-number">13</div>

						<div class="chapter-info">
							<span>Chapter 13</span>
							<h3>Statistics</h3>
							<p>
								Learn mean, median, mode and
								cumulative frequency.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>


					<a href="/probability" class="chapter-card featured-chapter">

						<div class="chapter-number">14</div>

						<div class="chapter-info">
							<span>Chapter 14</span>
							<h3>Probability</h3>
							<p>
								Build intuition around probability
								and solve exam questions confidently.
							</p>
						</div>

						<div class="chapter-arrow">→</div>

					</a>

				</div>

			</div>

		</section>


		<!-- CTA -->

		<section class="class10-cta">

			<div class="class10-container">

				<div class="cta-box">

					<div>

						<div class="class10-label">
							THE CONCEPTS ADDA
						</div>

						<h2>
							Don't memorize Mathematics.
							<br />
							<span>Understand it.</span>
						</h2>

						<p>
							Your journey towards stronger concepts starts here.
						</p>

					</div>

					<a href="/" class="cta-button">
						Back to Home →
					</a>

				</div>

			</div>

		</section>

		<PracticeSection />

	</main>


	<!-- FOOTER -->

	<footer class="class10-footer">

		<div class="class10-container footer-inner">

			<div class="footer-brand">

				<img
					src="/logo.png"
					alt="The Concepts Adda"
				/>

				<div>
					<strong>The Concepts Adda</strong>
					<span>Understand. Practice. Master.</span>
				</div>

			</div>

			<p>
				© {new Date().getFullYear()} The Concepts Adda.
				All rights reserved.
			</p>

		</div>

	</footer>


	<style>

		:global(*) {
			box-sizing: border-box;
		}

		:global(html) {
			scroll-behavior: smooth;
		}

		:global(body) {
			margin: 0;
			background: #ffffff;
			color: #172033;
			font-family:
				Inter,
				ui-sans-serif,
				system-ui,
				-apple-system,
				BlinkMacSystemFont,
				"Segoe UI",
				sans-serif;
		}


		/* CONTAINER */

		.class10-container {
			width: min(1180px, calc(100% - 40px));
			margin: 0 auto;
		}


		/* NAVBAR */

		.class10-navbar {
			background: rgba(255, 255, 255, 0.96);
			border-bottom: 1px solid #e9edf3;
		}

		.class10-nav-container {
			width: min(1180px, calc(100% - 40px));
			min-height: 82px;
			margin: 0 auto;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 20px;
		}

		.class10-brand {
			display: flex;
			align-items: center;
			gap: 12px;
			text-decoration: none;
			color: #172033;
		}

		.class10-brand img {
			width: 50px;
			height: 50px;
			border-radius: 50%;
			object-fit: cover;
		}

		.class10-brand div {
			display: flex;
			flex-direction: column;
			gap: 3px;
		}

		.class10-brand strong {
			font-size: 18px;
			line-height: 1.1;
		}

		.class10-brand span {
			font-size: 11px;
			color: #7a8290;
		}

		.back-home {
			text-decoration: none;
			color: #344054;
			font-size: 14px;
			font-weight: 700;
			padding: 10px 16px;
			border: 1px solid #dfe4eb;
			border-radius: 9px;
			transition: all 0.2s ease;
		}

		.back-home:hover {
			background: #f5f7fa;
			border-color: #cdd4df;
		}


		/* HERO */

		.class10-hero {
			padding: 100px 0 105px;
			background:
				radial-gradient(
					circle at 80% 30%,
					#eaf1ff 0,
					transparent 28%
				),
				#f8faff;
		}

		.class10-hero .class10-container {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 440px;
			align-items: center;
			gap: 75px;
		}

		.class10-label {
			display: inline-block;
			color: #2563eb;
			font-size: 12px;
			font-weight: 850;
			letter-spacing: 2px;
			margin-bottom: 20px;
		}

		.class10-hero h1 {
			margin: 0;
			font-size: clamp(48px, 5vw, 70px);
			line-height: 1;
			letter-spacing: -3px;
			color: #172033;
		}

		.class10-hero h1 span,
		.section-intro h2 span,
		.cta-box h2 span {
			color: #2563eb;
		}

		.class10-hero-content > p {
			max-width: 650px;
			margin: 28px 0 0;
			font-size: 17px;
			line-height: 1.7;
			color: #687180;
		}

		.hero-stats {
			display: flex;
			gap: 35px;
			margin-top: 40px;
		}

		.hero-stats div {
			display: flex;
			flex-direction: column;
			gap: 4px;
		}

		.hero-stats strong {
			font-size: 25px;
			color: #172033;
		}

		.hero-stats span {
			font-size: 12px;
			color: #7a8290;
		}


		/* HERO VISUAL */

		.math-visual {
			background: #17233d;
			border-radius: 22px;
			padding: 10px;
			box-shadow: 0 25px 60px rgba(23, 35, 61, 0.18);
		}

		.visual-top {
			height: 40px;
			display: flex;
			align-items: center;
			gap: 7px;
			padding: 0 12px;
		}

		.visual-top span {
			width: 9px;
			height: 9px;
			border-radius: 50%;
			background: #66738b;
		}

		.visual-content {
			min-height: 300px;
			background: #ffffff;
			border-radius: 15px;
			padding: 35px;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			text-align: center;
		}

		.visual-small {
			font-size: 11px;
			font-weight: 800;
			letter-spacing: 2px;
			color: #7a8290;
		}

		.equation {
			display: flex;
			align-items: center;
			gap: 13px;
			margin-top: 25px;
			font-family: Georgia, serif;
			font-size: 37px;
			font-style: italic;
			color: #172033;
		}

		.equation-line {
			width: 220px;
			height: 2px;
			background: #2563eb;
			margin: 20px 0;
		}

		.visual-answer {
			font-size: 13px;
			color: #687180;
		}

		.visual-answer strong {
			color: #2563eb;
			margin: 0 5px;
		}


		/* CHAPTER SECTION */

		.chapters-section {
			padding: 110px 0 125px;
			background: #ffffff;
		}

		.section-intro {
			max-width: 700px;
			margin-bottom: 55px;
		}

		.section-intro h2 {
			margin: 0;
			font-size: clamp(42px, 4.5vw, 60px);
			line-height: 1.05;
			letter-spacing: -2.5px;
		}

		.section-intro p {
			margin: 25px 0 0;
			font-size: 17px;
			line-height: 1.7;
			color: #687180;
		}


		/* CHAPTER GRID */

		.chapter-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 18px;
		}


		/* BASE CARD */

		.chapter-card {
			position: relative;
			display: grid;
			grid-template-columns: 55px minmax(0, 1fr) 30px;
			gap: 18px;
			align-items: start;
			min-height: 185px;
			padding: 28px;
			border: 1px solid transparent;
			border-radius: 18px;
			text-decoration: none;
			color: #172033;
			transition:
				transform 0.2s ease,
				box-shadow 0.2s ease,
				border-color 0.2s ease;
		}

		.chapter-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 18px 40px rgba(23, 32, 51, 0.10);
		}


		/* DIFFERENT CARD COLOURS */

		.chapter-card:nth-child(1) {
			background: #eef6ff;
			border-color: #d9eaff;
		}

		.chapter-card:nth-child(2) {
			background: #f4efff;
			border-color: #e5d9ff;
		}

		.chapter-card:nth-child(3) {
			background: #eefbf5;
			border-color: #d7f1e3;
		}

		.chapter-card:nth-child(4) {
			background: #fff5ed;
			border-color: #f8dfcb;
		}

		.chapter-card:nth-child(5) {
			background: #fffbea;
			border-color: #f5eab8;
		}

		.chapter-card:nth-child(6) {
			background: #edf8fa;
			border-color: #d5ecef;
		}

		.chapter-card:nth-child(7) {
			background: #f3f5ff;
			border-color: #dfe3fa;
		}

		.chapter-card:nth-child(8) {
			background: #eef2ff;
			border-color: #d9e0ff;
		}

		.chapter-card:nth-child(9) {
			background: #f5efff;
			border-color: #e7dcfb;
		}

		.chapter-card:nth-child(10) {
			background: #eef9f2;
			border-color: #d8eddf;
		}

		.chapter-card:nth-child(11) {
			background: #fff3f5;
			border-color: #f5dce1;
		}

		.chapter-card:nth-child(12) {
			background: #f1f6ff;
			border-color: #dce7f8;
		}

		.chapter-card:nth-child(13) {
			background: #fff7ee;
			border-color: #f4e0c8;
		}

		.chapter-card:nth-child(14) {
			background: #f0f8ff;
			border-color: #d9eaf8;
		}


		/* CARD HOVER BORDER */

		.chapter-card:nth-child(1):hover {
			border-color: #b8d8fa;
		}

		.chapter-card:nth-child(2):hover {
			border-color: #ccb7f5;
		}

		.chapter-card:nth-child(3):hover {
			border-color: #b6e0c9;
		}

		.chapter-card:nth-child(4):hover {
			border-color: #edc5a7;
		}

		.chapter-card:nth-child(5):hover {
			border-color: #e7d58b;
		}

		.chapter-card:nth-child(6):hover {
			border-color: #afdce1;
		}

		.chapter-card:nth-child(7):hover {
			border-color: #c2caf0;
		}

		.chapter-card:nth-child(8):hover {
			border-color: #b7c5f7;
		}

		.chapter-card:nth-child(9):hover {
			border-color: #cbb9ed;
		}

		.chapter-card:nth-child(10):hover {
			border-color: #b7ddc3;
		}

		.chapter-card:nth-child(11):hover {
			border-color: #e9bcc5;
		}

		.chapter-card:nth-child(12):hover {
			border-color: #bfd4ef;
		}

		.chapter-card:nth-child(13):hover {
			border-color: #e9cda7;
		}

		.chapter-card:nth-child(14):hover {
			border-color: #b9d9ee;
		}


		/* NUMBER */

		.chapter-number {
			font-size: 20px;
			font-weight: 850;
			color: #2563eb;
		}


		/* INFO */

		.chapter-info {
			min-width: 0;
		}

		.chapter-info span {
			font-size: 11px;
			font-weight: 750;
			color: #7d8796;
			text-transform: uppercase;
			letter-spacing: 1px;
		}

		.chapter-info h3 {
			margin: 7px 0 0;
			font-size: 20px;
			line-height: 1.3;
			color: #172033;
		}

		.chapter-info p {
			margin: 10px 0 0;
			color: #687180;
			font-size: 14px;
			line-height: 1.6;
		}


		/* ARROW */

		.chapter-arrow {
			font-size: 20px;
			color: #7d8796;
			transition:
				color 0.2s ease,
				transform 0.2s ease;
		}

		.chapter-card:hover .chapter-arrow {
			color: #2563eb;
			transform: translateX(3px);
		}


		/* CTA */

		.class10-cta {
			padding: 0 0 110px;
		}

		.cta-box {
			background: #edf3ff;
			border-radius: 24px;
			padding: 55px 60px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 40px;
		}

		.cta-box .class10-label {
			margin-bottom: 12px;
		}

		.cta-box h2 {
			margin: 0;
			font-size: clamp(30px, 3.5vw, 46px);
			line-height: 1.1;
			letter-spacing: -1.8px;
		}

		.cta-box p {
			margin: 16px 0 0;
			color: #687180;
		}

		.cta-button {
			flex-shrink: 0;
			background: #2563eb;
			color: #ffffff;
			text-decoration: none;
			padding: 15px 21px;
			border-radius: 9px;
			font-size: 14px;
			font-weight: 750;
			box-shadow: 0 10px 25px rgba(37, 99, 235, 0.18);
			transition:
				transform 0.2s ease,
				background 0.2s ease;
		}

		.cta-button:hover {
			background: #1d4ed8;
			transform: translateY(-2px);
		}


		/* FOOTER */

		.class10-footer {
			background: #111a2d;
			padding: 35px 0;
			color: white;
		}

		.footer-inner {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 30px;
		}

		.footer-brand {
			display: flex;
			align-items: center;
			gap: 12px;
		}

		.footer-brand img {
