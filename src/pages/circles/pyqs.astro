---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
---

<Layout
	title="Circles Last 5 Years PYQs Practice | Class 10 | The Concepts Adda"
	description="Practice CBSE Class 10 Circles Last 5 Years (2020-2024) Previous Year Questions (PYQs) organized by year and marks for student self-practice."
>
	<main class="lesson-page">
		<div class="lesson-container">
			<a href="/circles" class="back-link">
				<span class="back-arrow">←</span>
				<span>Back to Circles</span>
			</a>

			<!-- LESSON HEADER -->
			<section class="lesson-header">
				<div class="lesson-number">04</div>
				<div class="lesson-header-copy">
					<div class="lesson-label">PRACTICE · CLASS 10 MATHEMATICS (NCERT)</div>
					<h1>Circles <span>Last 5 Years PYQs</span></h1>
					<p>
						Practice official CBSE Class 10 Board exam questions from the last 5 years (2020 – 2024) organized by year and mark distribution for self-assessment.
					</p>
				</div>
			</section>

			<!-- CONTENT LAYOUT -->
			<section class="content-layout">
				<article class="lesson-content">

					<!-- ================= 2024 BOARD QUESTIONS ================= -->
					<div class="topic-label">01 · CBSE BOARD EXAM 2024</div>
					<h2>CBSE 2024 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 1 MARK</span>
							<h3>Q1. A tangent PQ at a point P of a circle of radius 5 cm meets a line through the centre O at a point Q so that OQ = 12 cm. Find the length of PQ.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 1 MARK</span>
							<h3>Q2. If tangents PA and PB from a point P to a circle with centre O are inclined to each other at an angle of 80°, then find ∠POA.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 2 MARKS</span>
							<h3>Q3. Two concentric circles are of radii 5 cm and 3 cm. Find the length of the chord of the larger circle which touches the smaller circle.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 3 MARKS</span>
							<h3>Q4. Prove that the lengths of tangents drawn from an external point to a circle are equal (Theorem 10.2).</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 5 MARKS</span>
							<h3>Q5. Prove that a parallelogram circumscribing a circle is a rhombus.</h3>
						</div>
					</div>

					<!-- ================= 2023 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">02 · CBSE BOARD EXAM 2023</div>
					<h2>CBSE 2023 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 1 MARK</span>
							<h3>Q6. If the angle between two radii of a circle is 130°, the angle between the tangents at the ends of the radii is:</h3>
						</div>
						<div class="example-solution">
							<p>(A) 50° &nbsp;&nbsp;&nbsp;&nbsp; (B) 90° &nbsp;&nbsp;&nbsp;&nbsp; (C) 40° &nbsp;&nbsp;&nbsp;&nbsp; (D) 60°</p>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 2 MARKS</span>
							<h3>Q7. Prove that in two concentric circles, the chord of the larger circle, which touches the smaller circle, is bisected at the point of contact.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 3 MARKS</span>
							<h3>Q8. Prove that the angle between the two tangents drawn from an external point to a circle is supplementary to the angle subtended by the line-segment joining the points of contact at the centre.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 5 MARKS</span>
							<h3>Q9. A triangle ABC is drawn to circumscribe a circle of radius 4 cm such that the segments BD and DC into which BC is divided by the point of contact D are of lengths 8 cm and 6 cm respectively. Find the sides AB and AC.</h3>
						</div>
					</div>

					<!-- ================= 2022 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">03 · CBSE BOARD EXAM 2022</div>
					<h2>CBSE 2022 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2022 · 1 MARK</span>
							<h3>Q10. If TP and TQ are the two tangents to a circle with centre O so that ∠POQ = 110°, then find ∠PTQ.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2022 · 2 MARKS</span>
							<h3>Q11. Prove that the tangents drawn at the ends of a diameter of a circle are parallel.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2022 · 3 MARKS</span>
							<h3>Q12. A quadrilateral ABCD is drawn to circumscribe a circle. Prove that AB + CD = AD + BC.</h3>
						</div>
					</div>

					<!-- ================= 2021 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">04 · CBSE BOARD EXAM 2021</div>
					<h2>CBSE 2021 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2021 · 1 MARK</span>
							<h3>Q13. If a pair of tangents are drawn from an external point P to a circle of radius a with centre O and the angle between the tangents is 60°, find the length of OP.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2021 · 2 MARKS</span>
							<h3>Q14. Prove that the line segment joining the points of contact of two parallel tangents to a circle passes through the centre.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2021 · 3 MARKS</span>
							<h3>Q15. If PA and PB are tangents to a circle from an external point P and MN is another tangent touching the circle at C and intersecting PA and PB at M and N respectively, prove that perimeter of △PMN = 2 PA.</h3>
						</div>
					</div>

					<!-- ================= 2020 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">05 · CBSE BOARD EXAM 2020</div>
					<h2>CBSE 2020 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2020 · 1 MARK</span>
							<h3>Q16. The length of a tangent from a point A at distance 5 cm from the centre of the circle is 4 cm. Find the radius of the circle.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2020 · 3 MARKS</span>
							<h3>Q17. Prove that the tangent at any point of a circle is perpendicular to the radius through the point of contact (Theorem 10.1).</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2020 · 5 MARKS</span>
							<h3>Q18. Prove that opposite sides of a quadrilateral circumscribing a circle subtend supplementary angles at the centre of the circle.</h3>
						</div>
					</div>

					<!-- 06 · PRACTICE TIPS -->
					<div class="topic-label second-label">06 · SELF-PRACTICE TIPS</div>
					<h2>Tips for Solving Board PYQs</h2>

					<div class="summary-list">
						<div class="summary-item">
							<span>01</span>
							<p>Always use <strong>Theorem 10.1 (Radius ⊥ Tangent)</strong> to form right-angled triangles and apply Pythagoras theorem.</p>
						</div>
						<div class="summary-item">
							<span>02</span>
							<p>Use <strong>Theorem 10.2 (Equal tangent lengths)</strong> to label tangent segments from vertices in circumscribed polygons.</p>
						</div>
						<div class="summary-item">
							<span>03</span>
							<p>Remember that the angle at centre and angle between external tangents are <strong>supplementary (sum = 180°)</strong>.</p>
						</div>
					</div>

					<!-- LESSON NAVIGATION -->
					<div class="lesson-navigation">
						<a href="/circles/applications-and-proofs" class="previous-lesson">
							<span>←</span>
							<div>
								<small>PREVIOUS LESSON</small>
								<strong>Applications & Proofs</strong>
							</div>
						</a>

						<a href="/circles" class="next-lesson">
							<div>
								<small>COMPLETE COURSE</small>
								<strong>Circles Overview</strong>
							</div>
							<span>→</span>
						</a>
					</div>
				</article>

				<!-- SIDEBAR -->
				<aside class="lesson-sidebar">
					<div class="sidebar-card">
						<div class="sidebar-title">CIRCLES</div>
						<div class="progress-text">Lesson 04 of 04</div>
						<div class="progress-bar">
							<div style="width: 100%;"></div>
						</div>

						<div class="sidebar-lessons">
							<a href="/circles/tangent-to-a-circle" class="sidebar-lesson">
								<span>01</span>
								<div>
									<strong>Tangent & Theorem 10.1</strong>
									<small>Radius ⊥ Tangent proof</small>
								</div>
							</a>

							<a href="/circles/number-of-tangents-theorem" class="sidebar-lesson">
								<span>02</span>
								<div>
									<strong>Tangents & Theorem 10.2</strong>
									<small>External tangents equal proof</small>
								</div>
							</a>

							<a href="/circles/applications-and-proofs" class="sidebar-lesson">
								<span>03</span>
								<div>
									<strong>Applications & Proofs</strong>
									<small>Concentric circles & quadrilaterals</small>
								</div>
							</a>

							<a href="/circles/pyqs" class="sidebar-lesson active">
								<span>04</span>
								<div>
									<strong>Last 5 Years PYQs</strong>
									<small>CBSE 2020-2024 practice set</small>
								</div>
							</a>
						</div>
					</div>
				</aside>
			</section>
		</div>
	</main>

	<style>
		.lesson-page {
			min-height: 100vh;
			background: linear-gradient(180deg, #f8fbff 0%, #ffffff 35%, #f7f9fc 100%);
			color: #14213d;
			padding: 45px 0 100px;
		}

		.lesson-container {
			width: min(1120px, calc(100% - 40px));
			margin: 0 auto;
		}

		.back-link {
			display: inline-flex;
			align-items: center;
			gap: 7px;
			color: #667085;
			text-decoration: none;
			font-size: 14px;
			font-weight: 700;
			margin-bottom: 35px;
			transition: color 0.2s ease, transform 0.2s ease;
		}

		.back-link:hover {
			color: #2563eb;
			transform: translateX(-3px);
		}

		.lesson-header {
			display: grid;
			grid-template-columns: 80px minmax(0, 1fr);
			gap: 25px;
			align-items: center;
			padding: 40px;
			border: 1px solid #e1e7f0;
			border-radius: 24px;
			background: rgba(255, 255, 255, 0.92);
			box-shadow: 0 18px 45px rgba(20, 33, 61, 0.055);
			margin-bottom: 45px;
		}

		.lesson-number {
			width: 80px;
			height: 80px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 20px;
			background: #eef4ff;
			color: #2563eb;
			font-size: 23px;
			font-weight: 900;
		}

		.lesson-label {
			color: #2563eb;
			font-size: 11px;
			font-weight: 850;
			letter-spacing: 1.7px;
			margin-bottom: 10px;
		}

		.lesson-header h1 {
			margin: 0;
			font-size: clamp(34px, 4.5vw, 54px);
			line-height: 1.05;
			letter-spacing: -2px;
			font-weight: 900;
			color: #14213d;
		}

		.lesson-header h1 span {
			color: #2563eb;
		}

		.lesson-header p {
			margin: 15px 0 0;
			max-width: 720px;
			color: #687180;
			font-size: 17px;
			line-height: 1.65;
		}

		.content-layout {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 300px;
			gap: 45px;
			align-items: start;
		}

		.lesson-content {
			min-width: 0;
			padding: 5px 0 0;
		}

		.topic-label {
			color: #2563eb;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1.8px;
			margin-bottom: 14px;
		}

		.second-label {
			margin-top: 60px;
		}

		.lesson-content h2 {
			margin: 0;
			color: #14213d;
			font-size: clamp(28px, 3.5vw, 38px);
			line-height: 1.1;
			letter-spacing: -1.5px;
			font-weight: 900;
		}

		.lesson-content > p {
			max-width: 780px;
			margin: 18px 0 0;
			color: #687180;
			font-size: 16.5px;
			line-height: 1.75;
		}

		.example-card {
			margin-top: 25px;
			border-radius: 20px;
			border: 1px solid #e1e7f0;
			background: #ffffff;
			box-shadow: 0 8px 25px rgba(20, 33, 61, 0.035);
			overflow: hidden;
		}

		.example-header {
			padding: 20px 24px;
			background: #f8fafc;
			border-bottom: 1px solid #edf2f7;
		}

		.example-badge {
			display: inline-block;
			padding: 4px 12px;
			border-radius: 6px;
			background: #2563eb;
			color: #ffffff;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1px;
			margin-bottom: 8px;
		}

		.example-header h3 {
			margin: 0;
			font-size: 18px;
			font-weight: 800;
			color: #14213d;
		}

		.example-solution {
			padding: 24px;
			color: #475569;
			font-size: 15px;
			line-height: 1.7;
		}

		.summary-list {
			display: grid;
			gap: 16px;
			margin-top: 26px;
		}

		.summary-item {
			display: flex;
			align-items: center;
			gap: 20px;
			padding: 20px 24px;
			border-radius: 16px;
			background: #ffffff;
			border: 1px solid #e1e7f0;
			box-shadow: 0 4px 15px rgba(20, 33, 61, 0.03);
		}

		.summary-item span {
			padding: 8px 14px;
			border-radius: 10px;
			background: #eef4ff;
			color: #2563eb;
			font-weight: 900;
			font-size: 13px;
			flex-shrink: 0;
		}

		.summary-item p {
			margin: 0;
			color: #334155;
			font-size: 15.5px;
			line-height: 1.5;
			font-weight: 600;
		}

		.lesson-navigation {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: 20px;
			margin-top: 60px;
			padding-top: 40px;
			border-top: 1px solid #e2e8f0;
		}

		.previous-lesson,
		.next-lesson {
			display: flex;
			align-items: center;
			gap: 16px;
			padding: 18px 24px;
			border: 1px solid #e1e7f0;
			border-radius: 16px;
			background: #ffffff;
			text-decoration: none;
			color: #14213d;
			transition: all 0.2s ease;
		}

		.next-lesson {
			margin-left: auto;
			text-align: right;
			justify-content: flex-end;
		}

		.previous-lesson:hover,
		.next-lesson:hover {
			border-color: #2563eb;
			box-shadow: 0 10px 25px rgba(37, 99, 235, 0.08);
			transform: translateY(-2px);
		}

		.previous-lesson div,
		.next-lesson div {
			display: flex;
			flex-direction: column;
		}

		.previous-lesson small,
		.next-lesson small {
			display: block;
			color: #64748b;
			font-size: 11px;
			font-weight: 700;
			letter-spacing: 1px;
			margin-bottom: 4px;
		}

		.previous-lesson strong,
		.next-lesson strong {
			display: block;
			font-size: 15px;
			font-weight: 600;
			color: #0f172a;
		}

		.previous-lesson span,
		.next-lesson span {
			font-size: 20px;
			color: #2563eb;
			font-weight: 800;
		}

		.lesson-sidebar {
			position: sticky;
			top: 30px;
		}

		.sidebar-card {
			padding: 28px;
			border-radius: 24px;
			border: 1px solid #e1e7f0;
			background: #ffffff;
			box-shadow: 0 10px 30px rgba(20, 33, 61, 0.04);
		}

		.sidebar-title {
			color: #2563eb;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1.5px;
			margin-bottom: 8px;
		}

		.progress-text {
			color: #64748b;
			font-size: 13px;
			font-weight: 700;
			margin-bottom: 12px;
		}

		.progress-bar {
			height: 6px;
			border-radius: 10px;
			background: #e2e8f0;
			overflow: hidden;
			margin-bottom: 24px;
		}

		.progress-bar div {
			height: 100%;
			background: #2563eb;
			border-radius: 10px;
		}

		.sidebar-lessons {
			display: flex;
			flex-direction: column;
			gap: 8px;
		}

		.sidebar-lesson {
			display: flex;
			align-items: flex-start;
			gap: 12px;
			padding: 12px;
			border-radius: 12px;
			text-decoration: none;
			color: #334155;
			transition: background 0.15s ease;
		}

		.sidebar-lesson:hover {
			background: #f8fafc;
		}

		.sidebar-lesson.active {
			background: #eef4ff;
		}

		.sidebar-lesson > span {
			width: 24px;
			height: 24px;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			border-radius: 6px;
			background: #f1f5f9;
			color: #64748b;
			font-size: 11px;
			font-weight: 700;
		}

		.sidebar-lesson.active > span {
			background: #dbeafe;
			color: #2563eb;
		}

		.sidebar-lesson div {
			min-width: 0;
			display: flex;
			flex-direction: column;
		}

		.sidebar-lesson strong {
			display: block;
			font-size: 13px;
			font-weight: 600;
			color: #1e293b;
			line-height: 1.3;
		}

		.sidebar-lesson.active strong {
			color: #1d4ed8;
		}

		.sidebar-lesson small {
			display: block;
			font-size: 11px;
			color: #64748b;
			margin-top: 3px;
			line-height: 1.3;
		}

		.sidebar-lesson.active small {
			color: #3b82f6;
		}

		@media (max-width: 900px) {
			.content-layout {
				grid-template-columns: 1fr;
			}

			.lesson-header {
				grid-template-columns: 1fr;
				padding: 28px;
			}

			.lesson-number {
				width: 60px;
				height: 60px;
				font-size: 18px;
			}

			.lesson-navigation {
				flex-direction: column;
			}

			.next-lesson {
				width: 100%;
			}
		}
	</style>
</Layout>
