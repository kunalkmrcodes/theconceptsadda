---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
	title="Applications of Trigonometry | Class 10 Mathematics | The Concepts Adda"
	description="Learn Some Applications of Trigonometry (Heights and Distances) for Class 10 Mathematics (Latest NCERT) through clear lessons, angles of elevation & depression, and single/double triangle word problems."
>

	<main class="apptrig-page">

		<!-- HERO -->
		<section class="apptrig-hero">

			<div class="apptrig-container">

				<!-- BREADCRUMB -->
				<div class="breadcrumb">

					<a href="/class-10">
						← Back to Class 10
					</a>

					<span class="breadcrumb-dot"></span>

					<span class="breadcrumb-class">
						CLASS 10 MATHEMATICS
					</span>

				</div>

				<!-- HERO HEADING -->
				<h1>
					Master{" "}
					<span class="blue-text">
						Heights & Distances.
					</span>
				</h1>

				<p class="hero-description">
					Build a strong foundation in Some Applications of Trigonometry according to the latest NCERT syllabus through line of sight, angle of elevation, angle of depression, and step-by-step single and double right-triangle word problems.
				</p>

			</div>

		</section>

		<!-- LEARNING PATH -->
		<section class="learning-section">

			<div class="apptrig-container">

				<div class="learning-heading">

					<div class="section-label">
						APPLICATIONS OF TRIGONOMETRY
					</div>

					<div class="heading-row">

						<h2>
							Your learning{" "}
							<span class="blue-text">
								path.
							</span>
						</h2>

						<p>
							Follow the lessons in order and build your
							concepts step by step.
						</p>

					</div>

				</div>

				<!-- LESSONS LIST -->
				<div class="lesson-list">

					<!-- LESSON 01 -->
					<a
						href="/applications-of-trigonometry/line-of-sight-elevation-depression"
						class="lesson-card"
					>
						<div class="lesson-number">
							01
						</div>

						<div class="lesson-content">
							<div class="lesson-label">
								LESSON 01
							</div>

							<h3>
								Line of Sight, Elevation & Depression
							</h3>

							<p>
								Understand line of sight, angle of elevation, angle of depression, and the alternate interior angle relationship.
							</p>
						</div>

						<div class="lesson-arrow">
							→
						</div>
					</a>

					<!-- LESSON 02 -->
					<a
						href="/applications-of-trigonometry/single-triangle-problems"
						class="lesson-card"
					>
						<div class="lesson-number">
							02
						</div>

						<div class="lesson-content">
							<div class="lesson-label">
								LESSON 02
							</div>

							<h3>
								Single Right Triangle Problems
							</h3>

							<p>
								Calculate heights of towers, broken trees, and kite string lengths using single right-angled triangles.
							</p>
						</div>

						<div class="lesson-arrow">
							→
						</div>
					</a>

					<!-- LESSON 03 -->
					<a
						href="/applications-of-trigonometry/double-triangle-problems"
						class="lesson-card"
					>
						<div class="lesson-number">
							03
						</div>

						<div class="lesson-content">
							<div class="lesson-label">
								LESSON 03
							</div>

							<h3>
								Double Right Triangle Problems
							</h3>

							<p>
								Master complex 2-triangle NCERT word problems involving moving objects, pedestals, balloons, and dual angle observations.
							</p>
						</div>

					</a>

					<!-- LESSON 04 -->
					<a
						href="/applications-of-trigonometry/pyqs"
						class="lesson-card"
					>
						<div class="lesson-number">
							04
						</div>

						<div class="lesson-content">
							<div class="lesson-label">
								LESSON 04 · PRACTICE
							</div>

							<h3>
								Previous Year Questions (PYQs)
							</h3>

							<p>
								Practice official CBSE board exam questions (2020-2024) organized by year and mark distribution for self-assessment.
							</p>
						</div>

						<div class="lesson-arrow">
							→
						</div>
					</a>

				</div>

			</div>

		</section>

		<!-- BOTTOM CTA -->
		<section class="apptrig-cta">

			<div class="apptrig-container">

				<div class="cta-box">

					<div>

						<div class="section-label">
							READY TO START?
						</div>

						<h2>
							Understand the concept.
							<br />
							<span class="blue-text">
								Then calculate the height.
							</span>
						</h2>

						<p>
							Start with the first lesson and master Applications of Trigonometry step by step according to the latest NCERT pattern.
						</p>

					</div>

					<a
						href="/applications-of-trigonometry/line-of-sight-elevation-depression"
						class="cta-button"
					>
						Start Lesson 01 →
					</a>

				</div>

			</div>

		</section>

	</main>

	<style>
		:global(html) {
			scroll-behavior: smooth;
		}

		:global(body) {
			margin: 0;
			background: #f8fafc;
			color: #14213d;
			font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		}

		:global(*) {
			box-sizing: border-box;
		}

		.apptrig-page {
			min-height: 100vh;
			overflow: hidden;
		}

		.blue-text {
			color: #2563eb;
		}

		.apptrig-container {
			width: min(1120px, calc(100% - 40px));
			margin: 0 auto;
		}

		.apptrig-hero {
			padding: 72px 0 105px;
			background:
				radial-gradient(
					circle at 85% 20%,
					rgba(37, 99, 235, 0.08),
					transparent 30%
				),
				linear-gradient(
					135deg,
					#fbfdff 0%,
					#f1f6ff 55%,
					#ffffff 100%
				);
		}

		.breadcrumb {
			display: flex;
			align-items: center;
			gap: 14px;
			margin-bottom: 38px;
		}

		.breadcrumb a {
			display: inline-flex;
			align-items: center;
			color: #626d7e;
			text-decoration: none;
			font-size: 15px;
			font-weight: 700;
			white-space: nowrap;
			transition: color 0.2s ease;
		}

		.breadcrumb a:hover {
			color: #2563eb;
		}

		.breadcrumb-dot {
			width: 7px;
			height: 7px;
			flex: 0 0 7px;
			border-radius: 50%;
			background: #f4c430;
			box-shadow: 0 0 0 4px rgba(244, 196, 48, 0.12);
		}

		.breadcrumb-class {
			color: #2563eb;
			font-size: 12px;
			font-weight: 850;
			letter-spacing: 2px;
			white-space: nowrap;
		}

		.apptrig-hero h1 {
			margin: 0;
			font-size: clamp(52px, 7vw, 84px);
			line-height: 0.98;
			letter-spacing: -3.5px;
			font-weight: 900;
			color: #14213d;
		}

		.hero-description {
			max-width: 760px;
			margin: 28px 0 0;
			color: #687180;
			font-size: 17px;
			line-height: 1.7;
		}

		.learning-section {
			padding: 100px 0 115px;
			background: #ffffff;
		}

		.section-label {
			color: #2563eb;
			font-size: 11.5px;
			font-weight: 900;
			letter-spacing: 2.2px;
			margin-bottom: 16px;
		}

		.heading-row {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			gap: 40px;
		}

		.heading-row h2 {
			margin: 0;
			font-size: clamp(38px, 4.5vw, 56px);
			line-height: 1.02;
			letter-spacing: -2.2px;
			font-weight: 900;
			color: #14213d;
		}

		.heading-row p {
			margin: 0;
			max-width: 420px;
			color: #6a7483;
			font-size: 16px;
			line-height: 1.65;

			@media (max-width: 900px) {
				max-width: 100%;
			}
		}

		.lesson-list {
			display: flex;
			flex-direction: column;
			gap: 22px;
			margin-top: 55px;
		}

		.lesson-card {
			display: grid;
			grid-template-columns: 88px 1fr auto;
			align-items: center;
			gap: 28px;
			padding: 32px 36px;
			border-radius: 26px;
			background: #ffffff;
			border: 1px solid #e5ecf5;
			box-shadow: 0 14px 40px rgba(20, 33, 61, 0.035);
			text-decoration: none;
			color: inherit;
			transition: all 0.25s ease;
		}

		.lesson-card:hover {
			transform: translateY(-4px);
			border-color: #cbdcf8;
			box-shadow: 0 22px 50px rgba(37, 99, 235, 0.08);
		}

		.lesson-number {
			width: 88px;
			height: 88px;
			border-radius: 22px;
			background: #f0f5ff;
			color: #2563eb;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 26px;
			font-weight: 900;
		}

		.lesson-label {
			color: #2563eb;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1.8px;
			margin-bottom: 8px;
		}

		.lesson-content h3 {
			margin: 0;
			font-size: 24px;
			font-weight: 850;
			color: #14213d;
			letter-spacing: -0.6px;
		}

		.lesson-content p {
			margin: 8px 0 0;
			color: #64748b;
			font-size: 15px;
			line-height: 1.6;
		}

		.lesson-arrow {
			width: 48px;
			height: 48px;
			border-radius: 14px;
			background: #f8fafc;
			border: 1px solid #e2e8f0;
			color: #2563eb;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 20px;
			font-weight: 800;
			transition: all 0.2s ease;
		}

		.lesson-card:hover .lesson-arrow {
			background: #2563eb;
			color: #ffffff;
			border-color: #2563eb;
			transform: translateX(4px);
		}

		.apptrig-cta {
			padding: 0 0 110px;
			background: #ffffff;
		}

		.cta-box {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 40px;
			padding: 55px 60px;
			border-radius: 32px;
			background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
			color: #ffffff;
		}

		.cta-box h2 {
			margin: 0 0 12px;
			font-size: clamp(30px, 3.5vw, 42px);
			font-weight: 900;
			line-height: 1.15;
			color: #ffffff;
		}

		.cta-box p {
			margin: 0;
			color: #94a3b8;
			font-size: 16px;
		}

		.cta-button {
			display: inline-flex;
			align-items: center;
			gap: 10px;
			padding: 20px 36px;
			border-radius: 18px;
			background: #2563eb;
			color: #ffffff;
			font-weight: 800;
			font-size: 16px;
			text-decoration: none;
			white-space: nowrap;
			transition: all 0.2s ease;
			box-shadow: 0 10px 25px rgba(37, 99, 235, 0.3);
		}

		.cta-button:hover {
			background: #1d4ed8;
			transform: translateY(-2px);
			box-shadow: 0 14px 30px rgba(37, 99, 235, 0.4);
		}

		@media (max-width: 900px) {
			.heading-row {
				flex-direction: column;
				align-items: flex-start;
				gap: 16px;
			}

			.lesson-card {
				grid-template-columns: 1fr;
				padding: 28px;
			}

			.lesson-number {
				width: 60px;
				height: 60px;
				font-size: 20px;
			}

			.lesson-arrow {
				display: none;
			}

			.cta-box {
				flex-direction: column;
				align-items: flex-start;
				padding: 36px 30px;
			}
		}
	</style>

</Layout>
