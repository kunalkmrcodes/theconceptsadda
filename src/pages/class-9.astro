---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
	title="Class 9 Mathematics | The Concepts Adda"
	description="Learn Class 9 Mathematics (Latest NCERT) through clear concept lessons, solved examples, step-by-step proofs, and practice sets."
>
	<main class="class9-page">

		<!-- NAVBAR -->
		<header class="class9-navbar">
			<div class="class9-nav-container">
				<a href="/" class="class9-brand">
					<img src="/logo.png" alt="The Concepts Adda" />
					<div>
						<strong>The Concepts Adda</strong>
						<span>Understand. Practice. Master.</span>
					</div>
				</a>
				<a href="/" class="back-home">
					← Home
				</a>
			</div>
		</header>

		<!-- HERO -->
		<section class="class9-hero">
			<div class="class9-container">
				<div class="class9-hero-content">
					<div class="class9-label">
						CLASS 9 MATHEMATICS
					</div>
					<h1>
						Master Mathematics.
						<br />
						<span>Understand every concept.</span>
					</h1>
					<p>
						Build strong fundamental concepts, solve word problems with confidence, and prepare smarter for your Class 9 Mathematics exams.
					</p>

					<div class="hero-stats">
						<div>
							<strong>12</strong>
							<span>Chapters</span>
						</div>
						<div>
							<strong>∞</strong>
							<span>Practice</span>
						</div>
						<div>
							<strong>100%</strong>
							<span>Concept Focus</span>
						</div>
					</div>
				</div>

				<div class="math-visual">
					<div class="visual-top">
						<span></span>
						<span></span>
						<span></span>
					</div>
					<div class="visual-content">
						<div class="visual-small">
							CLASS 09
						</div>
						<div class="equation">
							<span>(a+b)²</span>
							<span>=</span>
							<span>a²</span>
							<span>+</span>
							<span>2ab</span>
							<span>+</span>
							<span>b²</span>
						</div>
						<div class="equation-line"></div>
						<div class="visual-answer">
							Understanding
							<strong>&gt;</strong>
							Memorizing
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- CHAPTERS GRID -->
		<section class="chapters-section">
			<div class="class9-container">
				<div class="section-intro">
					<div class="class9-label">
						CLASS 9 SYLLABUS (LATEST NCERT)
					</div>
					<h2>
						Choose a chapter.
						<br />
						<span>Start understanding.</span>
					</h2>
					<p>
						Explore Class 9 Mathematics chapter by chapter according to the latest NCERT curriculum and learn at your own pace.
					</p>
				</div>

				<div class="chapter-grid">
					<!-- CHAPTER 01 -->
					<a href="/class-9/number-systems" class="chapter-card featured-chapter">
						<div class="chapter-number">01</div>
						<div class="chapter-info">
							<span>Chapter 01</span>
							<h3>Number Systems</h3>
							<p>
								Master irrational numbers, real number decimal expansions, representation on number line, and laws of exponents.
							</p>
						</div>
						<div class="chapter-arrow">→</div>
					</a>

					<!-- CHAPTER 02 -->
					<a href="/class-9/polynomials" class="chapter-card featured-chapter">
						<div class="chapter-number">02</div>
						<div class="chapter-info">
							<span>Chapter 02</span>
							<h3>Polynomials</h3>
							<p>
								Master degree of polynomials, zeroes, Remainder Theorem, Factor Theorem, and algebraic identities.
							</p>
						</div>
						<div class="chapter-arrow">→</div>
					</a>

					<!-- CHAPTER 03 -->
					<a href="/class-9/coordinate-geometry" class="chapter-card featured-chapter">
						<div class="chapter-number">03</div>
						<div class="chapter-info">
							<span>Chapter 03</span>
							<h3>Coordinate Geometry</h3>
							<p>
								Learn Cartesian plane, axes, origin, quadrants, plotting points (x, y), and reading point coordinates.
							</p>
						</div>
						<div class="chapter-arrow">→</div>
					</a>

					<!-- CHAPTER 04 -->
					<a href="/class-9/linear-equations" class="chapter-card featured-chapter">
						<div class="chapter-number">04</div>
						<div class="chapter-info">
							<span>Chapter 04</span>
							<h3>Linear Equations in Two Variables</h3>
							<p>
								Understand ax + by + c = 0 form, finding solutions, and graphing linear equations in two variables.
							</p>
						</div>
						<div class="chapter-arrow">→</div>
					</a>

					<!-- CHAPTER 05 -->
					<a href="/class-9/euclids-geometry" class="chapter-card featured-chapter">
						<div class="chapter-number">05</div>
						<div class="chapter-info">
							<span>Chapter 05</span>
							<h3>Introduction to Euclid's Geometry</h3>
							<p>
								Explore axioms, postulates (Euclid's 5 Postulates), definitions, and basic geometric logic.
							</p>
						</div>
						<div class="chapter-arrow">→</div>
					</a>

					<!-- CHAPTER 06 -->
					<a href="/class-9/lines-and-angles" class="chapter-card featured-chapter">
						<div class="chapter-number">06</div>
						<div class="chapter-info">
							<span>Chapter 06</span>
							<h3>Lines and Angles</h3>
							<p>
								Master linear pair, vertically opposite angles, parallel lines with transversal angles, and angle sum property.
							</p>
						</div>
						<div class="chapter-arrow">→</div>
					</a>

					<!-- CHAPTER 07 -->
					<a href="/class-9/triangles" class="chapter-card featured-chapter">
						<div class="chapter-number">07</div>
						<div class="chapter-info">
							<span>Chapter 07</span>
							<h3>Triangles</h3>
							<p>
								Master congruence criteria (SAS, ASA, SSS, RHS), isosceles triangle theorems, and geometric proofs.
							</p>
						</div>
						<div class="chapter-arrow">→</div>
					</a>

					<!-- CHAPTER 08 -->
					<a href="/class-9/quadrilaterals" class="chapter-card featured-chapter">
						<div class="chapter-number">08</div>
						<div class="chapter-info">
							<span>Chapter 08</span>
							<h3>Quadrilaterals</h3>
							<p>
								Understand properties of parallelograms, rhombuses, rectangles, squares, and the Mid-point Theorem.
							</p>
						</div>
						<div class="chapter-arrow">→</div>
					</a>

					<!-- CHAPTER 09 -->
					<a href="/class-9/circles" class="chapter-card featured-chapter">
						<div class="chapter-number">09</div>
						<div class="chapter-info">
							<span>Chapter 09</span>
							<h3>Circles</h3>
							<p>
								Master chord properties, perpendicular from centre, equal chords theorem, cyclic quadrilaterals, and angle subtended.
							</p>
						</div>
						<div class="chapter-arrow">→</div>
					</a>

					<!-- CHAPTER 10 -->
					<a href="/class-9/herons-formula" class="chapter-card featured-chapter">
						<div class="chapter-number">10</div>
						<div class="chapter-info">
							<span>Chapter 10</span>
							<h3>Heron's Formula</h3>
							<p>
								Calculate area of triangles using s = (a+b+c)/2 and Area = √[s(s-a)(s-b)(s-c)], and applications.
							</p>
						</div>
						<div class="chapter-arrow">→</div>
					</a>

					<!-- CHAPTER 11 -->
					<a href="/class-9/surface-areas-and-volumes" class="chapter-card featured-chapter">
						<div class="chapter-number">11</div>
						<div class="chapter-info">
							<span>Chapter 11</span>
							<h3>Surface Areas and Volumes</h3>
							<p>
								Master surface area and volume of right circular cones and spheres/hemispheres.
							</p>
						</div>
						<div class="chapter-arrow">→</div>
					</a>

					<!-- CHAPTER 12 -->
					<a href="/class-9/statistics" class="chapter-card featured-chapter">
						<div class="chapter-number">12</div>
						<div class="chapter-info">
							<span>Chapter 12</span>
							<h3>Statistics</h3>
							<p>
								Master presentation of data, frequency distribution tables, bar graphs, and histograms.
							</p>
						</div>
						<div class="chapter-arrow">→</div>
					</a>
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="class9-cta">
			<div class="class9-container">
				<div class="cta-box">
					<div>
						<div class="class9-label">THE CONCEPTS ADDA</div>
						<h2>Ready to master Class 9 Maths?</h2>
						<p>Start with Chapter 1 or choose any topic you want to revise today.</p>
					</div>
					<a href="/class-9/number-systems" class="cta-button">
						Start Learning →
					</a>
				</div>
			</div>
		</section>
	</main>

	<style>
		.class9-page {
			min-height: 100vh;
			background: linear-gradient(180deg, #f8fbff 0%, #ffffff 40%, #f7f9fc 100%);
			color: #14213d;
		}

		.class9-container {
			width: min(1180px, calc(100% - 40px));
			margin: 0 auto;
		}

		.class9-navbar {
			background: rgba(255, 255, 255, 0.9);
			backdrop-filter: blur(12px);
			border-bottom: 1px solid #eef2f7;
			position: sticky;
			top: 0;
			z-index: 100;
		}

		.class9-nav-container {
			width: min(1180px, calc(100% - 40px));
			margin: 0 auto;
			height: 72px;
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.class9-brand {
			display: flex;
			align-items: center;
			gap: 12px;
			text-decoration: none;
			color: #14213d;
		}

		.class9-brand img {
			width: 40px;
			height: 40px;
			border-radius: 50%;
		}

		.class9-brand strong {
			display: block;
			font-size: 16px;
			font-weight: 800;
		}

		.class9-brand span {
			display: block;
			font-size: 11px;
			color: #64748b;
			margin-top: 1px;
		}

		.back-home {
			padding: 9px 16px;
			border-radius: 10px;
			background: #eef4ff;
			color: #2563eb;
			text-decoration: none;
			font-size: 13px;
			font-weight: 700;
			transition: all 0.2s ease;
		}

		.back-home:hover {
			background: #2563eb;
			color: #ffffff;
		}

		.class9-hero {
			padding: 85px 0 90px;
		}

		.class9-hero .class9-container {
			display: grid;
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
			gap: 60px;
			align-items: center;
		}

		.class9-label {
			color: #2563eb;
			font-size: 12px;
			font-weight: 900;
			letter-spacing: 2px;
			margin-bottom: 14px;
		}

		.class9-hero h1 {
			margin: 0;
			font-size: clamp(48px, 5.5vw, 68px);
			line-height: 1.02;
			letter-spacing: -2.5px;
			font-weight: 900;
			color: #0f172a;
		}

		.class9-hero h1 span {
			color: #2563eb;
		}

		.class9-hero-content > p {
			margin: 20px 0 0;
			max-width: 580px;
			color: #64748b;
			font-size: 17.5px;
			line-height: 1.65;
		}

		.hero-stats {
			display: flex;
			align-items: center;
			gap: 35px;
			margin-top: 35px;
			padding-top: 30px;
			border-top: 1px solid #e2e8f0;
		}

		.hero-stats strong {
			display: block;
			font-size: 28px;
			font-weight: 900;
			color: #2563eb;
			line-height: 1;
		}

		.hero-stats span {
			display: block;
			margin-top: 4px;
			color: #64748b;
			font-size: 12px;
			font-weight: 700;
			letter-spacing: 0.5px;
		}

		.math-visual {
			border-radius: 24px;
			background: #ffffff;
			border: 1px solid #e2e8f0;
			box-shadow: 0 25px 60px rgba(37, 99, 235, 0.08);
			overflow: hidden;
		}

		.visual-top {
			padding: 16px 20px;
			background: #f8fafc;
			border-bottom: 1px solid #edf2f7;
			display: flex;
			gap: 7px;
		}

		.visual-top span {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: #cbd5e1;
		}

		.visual-top span:nth-child(1) { background: #ef4444; }
		.visual-top span:nth-child(2) { background: #f59e0b; }
		.visual-top span:nth-child(3) { background: #10b981; }

		.visual-content {
			padding: 40px 30px;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			min-height: 280px;
		}

		.visual-small {
			padding: 4px 12px;
			border-radius: 6px;
			background: #eef4ff;
			color: #2563eb;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1.5px;
			margin-bottom: 20px;
		}

		.equation {
			display: flex;
			align-items: center;
			gap: 10px;
			font-size: 32px;
			font-weight: 900;
			color: #0f172a;
		}

		.equation-line {
			width: 200px;
			height: 3px;
			background: linear-gradient(90deg, transparent 0%, #2563eb 50%, transparent 100%);
			margin: 24px 0 16px;
		}

		.visual-answer {
			font-size: 14px;
			color: #64748b;
			font-weight: 600;
		}

		.visual-answer strong {
			color: #2563eb;
		}

		.chapters-section {
			padding: 90px 0 110px;
		}

		.section-intro {
			margin-bottom: 50px;
		}

		.section-intro h2 {
			margin: 0;
			font-size: clamp(34px, 4.5vw, 48px);
			line-height: 1.08;
			letter-spacing: -2px;
			font-weight: 900;
			color: #0f172a;
		}

		.section-intro h2 span {
			color: #2563eb;
		}

		.section-intro p {
			margin: 14px 0 0;
			color: #64748b;
			font-size: 16.5px;
		}

		.chapter-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 20px;
		}

		.chapter-card {
			display: grid;
			grid-template-columns: 50px minmax(0, 1fr) 24px;
			gap: 20px;
			align-items: center;
			padding: 28px;
			border-radius: 20px;
			border: 1px solid transparent;
			text-decoration: none;
			color: inherit;
			transition: all 0.25s ease;
			box-shadow: 0 4px 15px rgba(15, 23, 42, 0.02);
		}

		.chapter-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 18px 40px rgba(23, 32, 51, 0.08);
		}

		/* DIFFERENT CARD COLOURS FOR CLASS 9 */
		.chapter-card:nth-child(1) { background: #eef6ff; border-color: #d9eaff; }
		.chapter-card:nth-child(1):hover { border-color: #b8d8fa; }
		.chapter-card:nth-child(1) .chapter-number { background: #dbeafe; color: #2563eb; }
		.chapter-card:nth-child(1) .chapter-info span { color: #2563eb; }

		.chapter-card:nth-child(2) { background: #f4efff; border-color: #e5d9ff; }
		.chapter-card:nth-child(2):hover { border-color: #ccb7f5; }
		.chapter-card:nth-child(2) .chapter-number { background: #ede9fe; color: #7c3aed; }
		.chapter-card:nth-child(2) .chapter-info span { color: #7c3aed; }

		.chapter-card:nth-child(3) { background: #eefbf5; border-color: #d7f1e3; }
		.chapter-card:nth-child(3):hover { border-color: #b6e0c9; }
		.chapter-card:nth-child(3) .chapter-number { background: #d1fae5; color: #059669; }
		.chapter-card:nth-child(3) .chapter-info span { color: #059669; }

		.chapter-card:nth-child(4) { background: #fff5ed; border-color: #f8dfcb; }
		.chapter-card:nth-child(4):hover { border-color: #edc5a7; }
		.chapter-card:nth-child(4) .chapter-number { background: #ffedd5; color: #ea580c; }
		.chapter-card:nth-child(4) .chapter-info span { color: #ea580c; }

		.chapter-card:nth-child(5) { background: #fffbea; border-color: #f5eab8; }
		.chapter-card:nth-child(5):hover { border-color: #e7d58b; }
		.chapter-card:nth-child(5) .chapter-number { background: #fef3c7; color: #d97706; }
		.chapter-card:nth-child(5) .chapter-info span { color: #d97706; }

		.chapter-card:nth-child(6) { background: #edf8fa; border-color: #d5ecef; }
		.chapter-card:nth-child(6):hover { border-color: #afdce1; }
		.chapter-card:nth-child(6) .chapter-number { background: #cffafe; color: #0891b2; }
		.chapter-card:nth-child(6) .chapter-info span { color: #0891b2; }

		.chapter-card:nth-child(7) { background: #f3f5ff; border-color: #dfe3fa; }
		.chapter-card:nth-child(7):hover { border-color: #c2caf0; }
		.chapter-card:nth-child(7) .chapter-number { background: #e0e7ff; color: #4f46e5; }
		.chapter-card:nth-child(7) .chapter-info span { color: #4f46e5; }

		.chapter-card:nth-child(8) { background: #eef2ff; border-color: #d9e0ff; }
		.chapter-card:nth-child(8):hover { border-color: #b7c5f7; }
		.chapter-card:nth-child(8) .chapter-number { background: #e0e7ff; color: #3b82f6; }
		.chapter-card:nth-child(8) .chapter-info span { color: #3b82f6; }

		.chapter-card:nth-child(9) { background: #f5efff; border-color: #e7dcfb; }
		.chapter-card:nth-child(9):hover { border-color: #cbb9ed; }
		.chapter-card:nth-child(9) .chapter-number { background: #f3e8ff; color: #9333ea; }
		.chapter-card:nth-child(9) .chapter-info span { color: #9333ea; }

		.chapter-card:nth-child(10) { background: #eef9f2; border-color: #d8eddf; }
		.chapter-card:nth-child(10):hover { border-color: #b7ddc3; }
		.chapter-card:nth-child(10) .chapter-number { background: #dcfce7; color: #16a34a; }
		.chapter-card:nth-child(10) .chapter-info span { color: #16a34a; }

		.chapter-card:nth-child(11) { background: #fff3f5; border-color: #f5dce1; }
		.chapter-card:nth-child(11):hover { border-color: #e9bcc5; }
		.chapter-card:nth-child(11) .chapter-number { background: #ffe4e6; color: #e11d48; }
		.chapter-card:nth-child(11) .chapter-info span { color: #e11d48; }

		.chapter-card:nth-child(12) { background: #f1f6ff; border-color: #dce7f8; }
		.chapter-card:nth-child(12):hover { border-color: #bfd4ef; }
		.chapter-card:nth-child(12) .chapter-number { background: #e0f2fe; color: #0284c7; }
		.chapter-card:nth-child(12) .chapter-info span { color: #0284c7; }

		.chapter-number {
			width: 50px;
			height: 50px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 14px;
			font-size: 18px;
			font-weight: 900;
		}

		.chapter-info span {
			display: block;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1px;
			margin-bottom: 4px;
			text-transform: uppercase;
		}

		.chapter-info h3 {
			margin: 0;
			font-size: 20px;
			font-weight: 800;
			color: #0f172a;
		}

		.chapter-info p {
			margin: 6px 0 0;
			color: #64748b;
			font-size: 14px;
			line-height: 1.5;
		}

		.chapter-arrow {
			font-size: 20px;
			color: #2563eb;
			font-weight: 800;
			transition: transform 0.2s ease;
		}

		.chapter-card:hover .chapter-arrow {
			transform: translateX(4px);
		}

		.class9-cta {
			padding-bottom: 100px;
		}

		.cta-box {
			padding: 50px;
			border-radius: 28px;
			background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%);
			color: #ffffff;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 30px;
			box-shadow: 0 20px 50px rgba(37, 99, 235, 0.25);
		}

		.cta-box .class9-label {
			color: #93c5fd;
		}

		.cta-box h2 {
			margin: 0;
			font-size: 32px;
			font-weight: 900;
			letter-spacing: -1px;
		}

		.cta-box p {
			margin: 10px 0 0;
			color: #dbeafe;
			font-size: 16px;
		}

		.cta-button {
			padding: 16px 32px;
			border-radius: 14px;
			background: #ffffff;
			color: #1e40af;
			text-decoration: none;
			font-weight: 800;
			font-size: 15px;
			white-space: nowrap;
			transition: all 0.2s ease;
		}

		.cta-button:hover {
			transform: scale(1.03);
			box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
		}

		@media (max-width: 900px) {
			.class9-hero .class9-container {
				grid-template-columns: 1fr;
				gap: 45px;
			}

			.chapter-grid {
				grid-template-columns: 1fr;
			}

			.cta-box {
