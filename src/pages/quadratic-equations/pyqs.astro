---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
---

<Layout
	title="Quadratic Equations Last 5 Years PYQs Practice | Class 10 | The Concepts Adda"
	description="Practice CBSE Class 10 Quadratic Equations Last 5 Years (2020-2024) Previous Year Questions (PYQs) organized by year and marks for student self-practice."
>
	<main class="lesson-page">
		<div class="lesson-container">
			<a href="/quadratic-equations" class="back-link">
				<span class="back-arrow">←</span>
				<span>Back to Quadratic Equations</span>
			</a>

			<!-- LESSON HEADER -->
			<section class="lesson-header">
				<div class="lesson-number">06</div>
				<div class="lesson-header-copy">
					<div class="lesson-label">PRACTICE · CLASS 10 MATHEMATICS (NCERT)</div>
					<h1>Quadratic Equations <span>Last 5 Years PYQs</span></h1>
					<p>
						Practice official CBSE Class 10 Board exam questions from the last 5 years (2020 – 2024) organized by year and mark distribution for self-assessment.
					</p>
				</div>
			</section>

			<!-- CONTENT LAYOUT -->
			<section class="content-layout">
				<article class="lesson-content">

					<!-- ================= 2024 BOARD QUESTIONS ================= -->
					<div class="topic-label">01 · CBSE BOARD EXAM 2024</div>
					<h2>CBSE 2024 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 1 MARK</span>
							<h3>Q1. Find the discriminant of the quadratic equation 2x² - 4x + 3 = 0.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 1 MARK</span>
							<h3>Q2. The values of k for which the quadratic equation x² + kx + 16 = 0 has equal roots are:</h3>
						</div>
						<div class="example-solution">
							<p>(A) ± 8 &nbsp;&nbsp;&nbsp;&nbsp; (B) ± 4 &nbsp;&nbsp;&nbsp;&nbsp; (C) ± 16 &nbsp;&nbsp;&nbsp;&nbsp; (D) ± 2</p>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 2 MARKS</span>
							<h3>Q3. Solve for x by factorisation: √2 x² + 7x + 5√2 = 0.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 3 MARKS</span>
							<h3>Q4. Find the values of k for which the quadratic equation (k + 4)x² + (k + 1)x + 1 = 0 has equal real roots.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2024 · 5 MARKS</span>
							<h3>Q5. A motor boat whose speed is 18 km/h in still water takes 1 hour more to go 24 km upstream than to return downstream to the same spot. Find the speed of the stream.</h3>
						</div>
					</div>

					<!-- ================= 2023 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">02 · CBSE BOARD EXAM 2023</div>
					<h2>CBSE 2023 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 1 MARK</span>
							<h3>Q6. If the quadratic equation ax² + bx + c = 0 has real and equal roots, then c is equal to:</h3>
						</div>
						<div class="example-solution">
							<p>(A) -b / (2a) &nbsp;&nbsp;&nbsp;&nbsp; (B) b / (2a) &nbsp;&nbsp;&nbsp;&nbsp; (C) -b² / (4a) &nbsp;&nbsp;&nbsp;&nbsp; (D) b² / (4a)</p>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 2 MARKS</span>
							<h3>Q7. Solve for x using quadratic formula: 2x² - 5x + 3 = 0.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 3 MARKS</span>
							<h3>Q8. If the roots of the equation (a - b)x² + (b - c)x + (c - a) = 0 are equal, prove that 2a = b + c.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2023 · 5 MARKS</span>
							<h3>Q9. Two water taps together can fill a tank in 9⅜ hours. The tap of larger diameter takes 10 hours less than the smaller one to fill the tank separately. Find the time in which each tap can separately fill the tank.</h3>
						</div>
					</div>

					<!-- ================= 2022 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">03 · CBSE BOARD EXAM 2022</div>
					<h2>CBSE 2022 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2022 · 1 MARK</span>
							<h3>Q10. Find the roots of the quadratic equation x² - 0.04 = 0.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2022 · 2 MARKS</span>
							<h3>Q11. Find the nature of roots of 2x² - 6x + 3 = 0. If real roots exist, find them.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2022 · 3 MARKS</span>
							<h3>Q12. Solve for x: [1 / (x + 4)] - [1 / (x - 7)] = 11 / 30 (x ≠ -4, 7).</h3>
						</div>
					</div>

					<!-- ================= 2021 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">04 · CBSE BOARD EXAM 2021</div>
					<h2>CBSE 2021 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2021 · 1 MARK</span>
							<h3>Q13. Value of k for which the equation x² + 5kx + 16 = 0 has no real roots.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2021 · 2 MARKS</span>
							<h3>Q14. Solve for x: 4x² - 4px + (p² - q²) = 0.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2021 · 3 MARKS</span>
							<h3>Q15. A train travels 360 km at a uniform speed. If the speed had been 5 km/h more, it would have taken 1 hour less for the same journey. Find the speed of the train.</h3>
						</div>
					</div>

					<!-- ================= 2020 BOARD QUESTIONS ================= -->
					<div class="topic-label second-label">05 · CBSE BOARD EXAM 2020</div>
					<h2>CBSE 2020 Board Practice Questions</h2>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2020 · 1 MARK</span>
							<h3>Q16. Find the value of k for which the roots of the equation 3x² - 10x + k = 0 are reciprocal of each other.</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2020 · 3 MARKS</span>
							<h3>Q17. Solve for x: [(x - 1) / (x - 2)] + [(x - 3) / (x - 4)] = 3 ⅓ (x ≠ 2, 4).</h3>
						</div>
					</div>

					<div class="example-card">
						<div class="example-header">
							<span class="example-badge">CBSE 2020 · 5 MARKS</span>
							<h3>Q18. The sum of areas of two squares is 468 m². If the difference of their perimeters is 24 m, find the sides of the two squares.</h3>
						</div>
					</div>

					<!-- 06 · PRACTICE TIPS -->
					<div class="topic-label second-label">06 · SELF-PRACTICE TIPS</div>
					<h2>Tips for Solving Board PYQs</h2>

					<div class="summary-list">
						<div class="summary-item">
							<span>01</span>
							<p>For equal roots questions, immediately set discriminant <strong>D = b² - 4ac = 0</strong>.</p>
						</div>
						<div class="summary-item">
							<span>02</span>
							<p>In speed/distance word problems, set up equation using <strong>Time = Distance / Speed</strong>.</p>
						</div>
						<div class="summary-item">
							<span>03</span>
							<p>Check if roots are real before applying quadratic formula: if D &lt; 0, stop and write "No real roots".</p>
						</div>
					</div>

					<!-- LESSON NAVIGATION -->
					<div class="lesson-navigation">
						<a href="/quadratic-equations/nature-of-roots" class="previous-lesson">
							<span>←</span>
							<div>
								<small>PREVIOUS LESSON</small>
								<strong>Nature of Roots</strong>
							</div>
						</a>

						<a href="/quadratic-equations" class="next-lesson">
							<div>
								<small>COMPLETE COURSE</small>
								<strong>Quadratic Equations Overview</strong>
							</div>
							<span>→</span>
						</a>
					</div>
				</article>

				<!-- SIDEBAR -->
				<aside class="lesson-sidebar">
					<div class="sidebar-card">
						<div class="sidebar-title">QUADRATIC EQUATIONS</div>
						<div class="progress-text">Lesson 06 of 06</div>
						<div class="progress-bar">
							<div style="width: 100%;"></div>
						</div>

						<div class="sidebar-lessons">
							<a href="/quadratic-equations/introduction" class="sidebar-lesson">
								<span>01</span>
								<div>
									<strong>Introduction</strong>
									<small>Standard form ax² + bx + c = 0</small>
								</div>
							</a>

							<a href="/quadratic-equations/factorisation" class="sidebar-lesson">
								<span>02</span>
								<div>
									<strong>Factorisation</strong>
									<small>Splitting the middle term</small>
								</div>
							</a>

							<a href="/quadratic-equations/completing-the-square" class="sidebar-lesson">
								<span>03</span>
								<div>
									<strong>Completing the Square</strong>
									<small>Perfect square method</small>
								</div>
							</a>

							<a href="/quadratic-equations/quadratic-formula" class="sidebar-lesson">
								<span>04</span>
								<div>
									<strong>Quadratic Formula</strong>
									<small>x = (-b ± √D) / (2a)</small>
								</div>
							</a>

							<a href="/quadratic-equations/nature-of-roots" class="sidebar-lesson">
								<span>05</span>
								<div>
									<strong>Nature of Roots</strong>
									<small>Discriminant D = b² - 4ac</small>
								</div>
							</a>

							<a href="/quadratic-equations/pyqs" class="sidebar-lesson active">
								<span>06</span>
								<div>
									<strong>Last 5 Years PYQs</strong>
									<small>CBSE 2020-2024 practice set</small>
								</div>
							</a>
						</div>
					</div>
				</aside>
			</section>
		</div>
	</main>

	<style>
		.lesson-page {
			min-height: 100vh;
			background: linear-gradient(180deg, #f8fbff 0%, #ffffff 35%, #f7f9fc 100%);
			color: #14213d;
			padding: 45px 0 100px;
		}

		.lesson-container {
			width: min(1120px, calc(100% - 40px));
			margin: 0 auto;
		}

		.back-link {
			display: inline-flex;
			align-items: center;
			gap: 7px;
			color: #667085;
			text-decoration: none;
			font-size: 14px;
			font-weight: 700;
			margin-bottom: 35px;
			transition: color 0.2s ease, transform 0.2s ease;
		}

		.back-link:hover {
			color: #2563eb;
			transform: translateX(-3px);
		}

		.lesson-header {
			display: grid;
			grid-template-columns: 80px minmax(0, 1fr);
			gap: 25px;
			align-items: center;
			padding: 40px;
			border: 1px solid #e1e7f0;
			border-radius: 24px;
			background: rgba(255, 255, 255, 0.92);
			box-shadow: 0 18px 45px rgba(20, 33, 61, 0.055);
			margin-bottom: 45px;
		}

		.lesson-number {
			width: 80px;
			height: 80px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 20px;
			background: #eef4ff;
			color: #2563eb;
			font-size: 23px;
			font-weight: 900;
		}

		.lesson-label {
			color: #2563eb;
			font-size: 11px;
			font-weight: 850;
			letter-spacing: 1.7px;
			margin-bottom: 10px;
		}

		.lesson-header h1 {
			margin: 0;
			font-size: clamp(34px, 4.5vw, 54px);
			line-height: 1.05;
			letter-spacing: -2px;
			font-weight: 900;
			color: #14213d;
		}

		.lesson-header h1 span {
			color: #2563eb;
		}

		.lesson-header p {
			margin: 15px 0 0;
			max-width: 720px;
			color: #687180;
			font-size: 17px;
			line-height: 1.65;
		}

		.content-layout {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 300px;
			gap: 45px;
			align-items: start;
		}

		.lesson-content {
			min-width: 0;
			padding: 5px 0 0;
		}

		.topic-label {
			color: #2563eb;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1.8px;
			margin-bottom: 14px;
		}

		.second-label {
			margin-top: 60px;
		}

		.lesson-content h2 {
			margin: 0;
			color: #14213d;
			font-size: clamp(28px, 3.5vw, 38px);
			line-height: 1.1;
			letter-spacing: -1.5px;
			font-weight: 900;
		}

		.lesson-content > p {
			max-width: 780px;
			margin: 18px 0 0;
			color: #687180;
			font-size: 16.5px;
			line-height: 1.75;
		}

		.example-card {
			margin-top: 25px;
			border-radius: 20px;
			border: 1px solid #e1e7f0;
			background: #ffffff;
			box-shadow: 0 8px 25px rgba(20, 33, 61, 0.035);
			overflow: hidden;
		}

		.example-header {
			padding: 20px 24px;
			background: #f8fafc;
			border-bottom: 1px solid #edf2f7;
		}

		.example-badge {
			display: inline-block;
			padding: 4px 12px;
			border-radius: 6px;
			background: #2563eb;
			color: #ffffff;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1px;
			margin-bottom: 8px;
		}

		.example-header h3 {
			margin: 0;
			font-size: 18px;
			font-weight: 800;
			color: #14213d;
		}

		.example-solution {
			padding: 24px;
			color: #475569;
			font-size: 15px;
			line-height: 1.7;
		}

		.summary-list {
			display: grid;
			gap: 16px;
			margin-top: 26px;
		}

		.summary-item {
			display: flex;
			align-items: center;
			gap: 20px;
			padding: 20px 24px;
			border-radius: 16px;
			background: #ffffff;
			border: 1px solid #e1e7f0;
			box-shadow: 0 4px 15px rgba(20, 33, 61, 0.03);
		}

		.summary-item span {
			padding: 8px 14px;
			border-radius: 10px;
			background: #eef4ff;
			color: #2563eb;
			font-weight: 900;
			font-size: 13px;
			flex-shrink: 0;
		}

		.summary-item p {
			margin: 0;
			color: #334155;
			font-size: 15.5px;
			line-height: 1.5;
			font-weight: 600;
		}

		.lesson-navigation {
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: 20px;
			margin-top: 60px;
			padding-top: 40px;
			border-top: 1px solid #e2e8f0;
		}

		.previous-lesson,
		.next-lesson {
			display: flex;
			align-items: center;
			gap: 16px;
			padding: 18px 24px;
			border: 1px solid #e1e7f0;
			border-radius: 16px;
			background: #ffffff;
			text-decoration: none;
			color: #14213d;
			transition: all 0.2s ease;
		}

		.next-lesson {
			margin-left: auto;
			text-align: right;
			justify-content: flex-end;
		}

		.previous-lesson:hover,
		.next-lesson:hover {
			border-color: #2563eb;
			box-shadow: 0 10px 25px rgba(37, 99, 235, 0.08);
			transform: translateY(-2px);
		}

		.previous-lesson div,
		.next-lesson div {
			display: flex;
			flex-direction: column;
		}

		.previous-lesson small,
		.next-lesson small {
			display: block;
			color: #64748b;
			font-size: 11px;
			font-weight: 700;
			letter-spacing: 1px;
			margin-bottom: 4px;
		}

		.previous-lesson strong,
		.next-lesson strong {
			display: block;
			font-size: 15px;
			font-weight: 600;
			color: #0f172a;
		}

		.previous-lesson span,
		.next-lesson span {
			font-size: 20px;
			color: #2563eb;
			font-weight: 800;
		}

		.lesson-sidebar {
			position: sticky;
			top: 30px;
		}

		.sidebar-card {
			padding: 28px;
			border-radius: 24px;
			border: 1px solid #e1e7f0;
			background: #ffffff;
			box-shadow: 0 10px 30px rgba(20, 33, 61, 0.04);
		}

		.sidebar-title {
			color: #2563eb;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1.5px;
			margin-bottom: 8px;
		}

		.progress-text {
			color: #64748b;
			font-size: 13px;
			font-weight: 700;
			margin-bottom: 12px;
		}

		.progress-bar {
			height: 6px;
			border-radius: 10px;
			background: #e2e8f0;
			overflow: hidden;
			margin-bottom: 24px;
		}

		.progress-bar div {
			height: 100%;
			background: #2563eb;
			border-radius: 10px;
		}

		.sidebar-lessons {
			display: flex;
			flex-direction: column;
			gap: 8px;
		}

		.sidebar-lesson {
			display: flex;
			align-items: flex-start;
			gap: 12px;
			padding: 12px;
			border-radius: 12px;
			text-decoration: none;
			color: #334155;
			transition: background 0.15s ease;
		}

		.sidebar-lesson:hover {
			background: #f8fafc;
		}

		.sidebar-lesson.active {
			background: #eef4ff;
		}

		.sidebar-lesson > span {
			width: 24px;
			height: 24px;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			border-radius: 6px;
			background: #f1f5f9;
			color: #64748b;
			font-size: 11px;
			font-weight: 700;
		}

		.sidebar-lesson.active > span {
			background: #dbeafe;
			color: #2563eb;
		}

		.sidebar-lesson div {
			min-width: 0;
			display: flex;
			flex-direction: column;
		}

		.sidebar-lesson strong {
			display: block;
			font-size: 13px;
			font-weight: 600;
			color: #1e293b;
			line-height: 1.3;
		}

		.sidebar-lesson.active strong {
			color: #1d4ed8;
		}

		.sidebar-lesson small {
			display: block;
			font-size: 11px;
			color: #64748b;
			margin-top: 3px;
			line-height: 1.3;
		}

		.sidebar-lesson.active small {
			color: #3b82f6;
		}

		@media (max-width: 900px) {
			.content-layout {
				grid-template-columns: 1fr;
			}

			.lesson-header {
				grid-template-columns: 1fr;
				padding: 28px;
			}

			.lesson-number {
				width: 60px;
				height: 60px;
				font-size: 18px;
			}

			.lesson-navigation {
				flex-direction: column;
			}

			.next-lesson {
				width: 100%;
			}
		}
	</style>
</Layout>
