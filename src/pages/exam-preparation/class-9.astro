---
import Layout from "../../layouts/Layout.astro";
import { class9Practice } from "../../data/practiceClass9.js";
import "../../styles/global.css";
---

<Layout
  title="Class 9 CBSE & Annual Exam Most Repeated PYQs | The Concepts Adda"
  description="Class 9 Mathematics Annual Examination Preparation Hub: Solved Annual Exam PYQs & CBSE Pattern Questions for every chapter."
>
  <main class="prep-class-main">

    <!-- NAVBAR -->
    <header class="prep-navbar">
      <div class="nav-container">
        <a href="/" class="brand">
          <img src="/logo.png" alt="The Concepts Adda" class="brand-logo" />
          <div class="brand-text">
            <div class="brand-name">The Concepts Adda</div>
            <div class="brand-tagline">Understand. Practice. Master.</div>
          </div>
        </a>

        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/classes">Classes</a>
          <a href="/practice">Practice</a>
          <a href="/exam-preparation" class="active">Exam Prep</a>
        </nav>
      </div>
    </header>

    <!-- HERO -->
    <section class="class-prep-hero blue-theme">
      <div class="hero-container text-center">
        <div class="breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumb-dot"></span>
          <a href="/exam-preparation">Exam Preparation</a>
          <span class="breadcrumb-dot"></span>
          <span>CLASS 09 ANNUAL PYQS</span>
        </div>

        <div class="class-pill blue">CLASS 09 ANNUAL EXAM HUB</div>
        <h1>
          CBSE & Annual Most Repeated PYQs <br />
          <span class="blue-text">Chapter-Wise Question Bank</span>
        </h1>
        <p class="hero-desc">
          Select any chapter below to practice official Class 9 Annual Examination Questions & CBSE Pattern PYQs categorized by marks, step-by-step solutions, and marking schemes.
        </p>
      </div>
    </section>

    <!-- CHAPTER PYQS GRID SECTION -->
    <section class="modules-section">
      <div class="section-container">

        <div class="module-card featured-blue">
          <div class="module-header">
            <span class="module-icon">📘</span>
            <div>
              <span class="module-tag blue">CLASS 09 ANNUAL EXAM PYQS</span>
              <h2>Select a Chapter to Solve Most Repeated Annual PYQs</h2>
            </div>
          </div>
          <p>Click on any chapter below to access solved 1-Mark MCQs, 2-Mark Short Answer, 3-Mark Long Answer, Geometry Proofs & Section E Case Studies.</p>

          <div class="chapters-grid">
            {class9Practice.map((chap) => (
              <a href={`/exam-preparation/class-9/${chap.id}`} class="chapter-card-link blue-border">
                <div class="chap-card-top">
                  <span class="chap-num blue">Ch {chap.chapterNumber}</span>
                  <span class="pyq-badge blue">Annual PYQs</span>
                </div>
                <h3>{chap.title}</h3>
                <span class="open-link-text blue">Solve Most Repeated PYQs →</span>
              </a>
            ))}
          </div>
        </div>

      </div>
    </section>

  </main>

  <footer class="footer">
    <div class="footer-container">
      <div class="footer-brand">
        <img src="/logo.png" alt="The Concepts Adda" />
        <div>
          <strong>The Concepts Adda</strong>
          <span>Understand. Practice. Master.</span>
        </div>
      </div>
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/classes">Classes</a>
        <a href="/practice">Practice</a>
        <a href="/exam-preparation">Exam Prep</a>
      </div>
    </div>
    <div class="footer-bottom">
      © {new Date().getFullYear()} The Concepts Adda. All rights reserved.
    </div>
  </footer>
</Layout>

<style>
  :global(body) {
    margin: 0;
    background: #f8fafc;
    color: #14213d;
    font-family: Inter, system-ui, -apple-system, sans-serif;
  }

  .prep-class-main {
    min-height: 80vh;
  }

  .text-center {
    text-align: center;
  }

  /* NAVBAR */
  .prep-navbar {
    width: 100%;
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid #e2e8f0;
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav-container {
    width: min(1180px, calc(100% - 40px));
    height: 76px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  .brand-logo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid #f4c430;
  }

  .brand-name {
    font-size: 18px;
    font-weight: 850;
  }

  .brand-tagline {
    font-size: 11px;
    color: #64748b;
  }

  .nav-links {
    display: flex;
    gap: 24px;
  }

  .nav-links a {
    text-decoration: none;
    color: #475569;
    font-size: 14px;
    font-weight: 650;
  }

  .nav-links a:hover, .nav-links a.active {
    color: #2563eb;
  }

  /* HERO */
  .class-prep-hero.blue-theme {
    padding: 60px 0 40px;
    background: linear-gradient(180deg, #ffffff 0%, #eff6ff 100%);
    border-bottom: 1px solid #e2e8f0;
  }

  .hero-container {
    width: min(800px, calc(100% - 40px));
    margin: 0 auto;
  }

  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 16px;
  }

  .breadcrumb a {
    color: #2563eb;
    text-decoration: none;
  }

  .breadcrumb-dot {
    width: 4px;
    height: 4px;
    background: #cbd5e1;
    border-radius: 50%;
  }

  .class-pill.blue {
    background: #dbeafe;
    color: #1d4ed8;
    display: inline-block;
    padding: 4px 14px;
    border-radius: 99px;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.6px;
    margin-bottom: 12px;
  }

  .class-prep-hero h1 {
    font-size: 40px;
    font-weight: 850;
    color: #0f172a;
    line-height: 1.25;
    margin: 0 0 16px;
  }

  .blue-text {
    color: #2563eb;
  }

  .hero-desc {
    font-size: 17px;
    color: #475569;
    line-height: 1.6;
    margin: 0;
  }

  /* MODULES */
  .modules-section {
    padding: 60px 0;
  }

  .section-container {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
  }

  .module-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 36px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .featured-blue {
    background: linear-gradient(145deg, #ffffff 0%, #eff6ff 100%);
    border: 2px solid #93c5fd;
  }

  .module-header {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 16px;
  }

  .module-icon {
    font-size: 32px;
    background: #ffffff;
    padding: 12px;
    border-radius: 16px;
    line-height: 1;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .module-tag {
    font-size: 11px;
    font-weight: 850;
    color: #64748b;
    letter-spacing: 0.6px;
    display: block;
    margin-bottom: 4px;
  }

  .module-tag.blue {
    color: #1d4ed8;
  }

  .module-header h2 {
    font-size: 22px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
  }

  .module-card p {
    font-size: 15px;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .chapters-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 900px) {
    .chapters-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .chapters-grid {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  .chapter-card-link {
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 16px;
    padding: 20px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .chapter-card-link.blue-border {
    border-color: #93c5fd;
  }

  .chapter-card-link:hover {
    transform: translateY(-4px);
    border-color: #2563eb;
    box-shadow: 0 10px 24px rgba(37, 99, 235, 0.15);
    background: #eff6ff;
  }

  .chap-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .chap-num.blue {
    font-size: 12px;
    font-weight: 800;
    color: #1d4ed8;
    background: #dbeafe;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .pyq-badge.blue {
    font-size: 11px;
    font-weight: 850;
    color: #1d4ed8;
    background: #eff6ff;
    border: 1px solid #93c5fd;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .chapter-card-link h3 {
    font-size: 17px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 14px;
    line-height: 1.35;
  }

  .open-link-text.blue {
    font-size: 13px;
    font-weight: 750;
    color: #2563eb;
  }

  /* FOOTER */
  .footer {
    background: #0d172b;
    color: white;
    padding: 60px 0 25px;
  }

  .footer-container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-brand img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 2px solid #f4c430;
  }

  .footer-brand div {
    display: flex;
    flex-direction: column;
  }

  .footer-links {
    display: flex;
    gap: 24px;
  }

  .footer-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
  }

  .footer-links a:hover {
    color: white;
  }

  .footer-bottom {
    width: min(1180px, calc(100% - 40px));
    margin: 30px auto 0;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 13px;
    color: #64748b;
  }
</style>
