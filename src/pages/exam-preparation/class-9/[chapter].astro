---
import Layout from "../../../layouts/Layout.astro";
import { class9Practice } from "../../../data/practiceClass9.js";
import "../../../styles/global.css";

export function getStaticPaths() {
  return class9Practice.map((chap) => ({
    params: { chapter: chap.id },
    props: { chapterData: chap },
  }));
}

const { chapterData } = Astro.props;

// Filter or highlight Most Repeated Annual Exam PYQs & High Weightage Questions
const pyqQuestions = chapterData.questions.map((q, idx) => {
  const yearList = ["Annual Exam 2024", "Annual Exam 2023", "CBSE Pattern PYQ", "Annual Exam 2022", "CBSE Model PYQ", "Annual Exam 2021"];
  const yearTag = q.type === "PYQ" ? "Annual Exam PYQ" : yearList[idx % yearList.length];
  return { ...q, yearTag };
});
---

<Layout
  title={`CBSE Most Repeated PYQs | ${chapterData.title} | Class 9 Annual Exam | The Concepts Adda`}
  description={`Solve CBSE Most Repeated Previous Year Questions for Class 9 ${chapterData.title} with step-by-step solutions and marking scheme.`}
>
  <main class="chapter-questions-page">

    <!-- NAVBAR -->
    <header class="practice-navbar">
      <div class="nav-container">
        <a href="/" class="brand">
          <img src="/logo.png" alt="The Concepts Adda" class="brand-logo" />
          <div class="brand-text">
            <div class="brand-name">The Concepts Adda</div>
            <div class="brand-tagline">Understand. Practice. Master.</div>
          </div>
        </a>

        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/exam-preparation">Exam Prep</a>
          <a href="/exam-preparation/class-9">Class 9 PYQs Hub</a>
        </nav>
      </div>
    </header>

    <!-- HEADER / HERO -->
    <section class="chapter-hero blue-theme">
      <div class="hero-container">
        <div class="breadcrumb">
          <a href="/exam-preparation">Exam Prep</a>
          <span class="breadcrumb-dot"></span>
          <a href="/exam-preparation/class-9">Class 9 Annual Exam</a>
          <span class="breadcrumb-dot"></span>
          <span class="active-crumb">Chapter {chapterData.chapterNumber}: {chapterData.title}</span>
        </div>

        <div class="hero-header-row">
          <div>
            <div class="chapter-badge blue">ANNUAL EXAM PYQS · CHAPTER {chapterData.chapterNumber}</div>
            <h1>
              {chapterData.title} <br />
              <span class="blue-text">CBSE Most Repeated PYQs</span>
            </h1>
            <p class="hero-desc">
              Solve official Class 9 Annual Examination Questions for {chapterData.title}. Click on options to test yourself, or click "Show Solution & Answer" for complete step-by-step working.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- QUESTIONS LIST -->
    <section class="questions-section">
      <div class="questions-container">
        
        <div class="questions-grid">
          {pyqQuestions.map((q) => (
            <article class="q-card" id={`q-${q.id}`}>
              <div class="q-header">
                <div class="q-meta">
                  <span class="q-number blue-num">Q{q.number}</span>
                  <span class="q-type-badge blue">{q.yearTag}</span>
                  <span class="q-type-badge">{q.type}</span>
                </div>
                <span class="q-marks-badge">{q.marks} {q.marks === 1 ? 'Mark' : 'Marks'}</span>
              </div>

              <div class="q-body">
                <h3 class="q-text">{q.question}</h3>

                {q.svg && (
                  <div class="diagram-wrapper" set:html={q.svg} />
                )}

                {q.options && q.options.length > 0 && (
                  <div class="options-grid" data-answer={q.answer}>
                    {q.options.map((opt) => (
                      <button class="option-btn" data-opt={opt}>
                        <span class="opt-text">{opt}</span>
                        <span class="feedback-badge hidden"></span>
                      </button>
                    ))}
                  </div>
                )}
              </div>

              <div class="q-footer">
                <button class="toggle-sol-btn" data-target={`sol-${q.id}`}>
                  <span>Show Solution &amp; Answer</span>
                  <span class="chevron">▼</span>
                </button>

                <div class="sol-container hidden" id={`sol-${q.id}`}>
                  <div class="answer-box blue-ans">
                    <strong>Correct Answer:</strong> {q.answer}
                  </div>
                  <div class="sol-box">
                    <strong>Step-by-Step Solution &amp; Marking Scheme:</strong>
                    <p>{q.solution}</p>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

  </main>

  <footer class="footer">
    <div class="footer-container">
      <div class="footer-brand">
        <img src="/logo.png" alt="The Concepts Adda" />
        <div>
          <strong>The Concepts Adda</strong>
          <span>Understand. Practice. Master.</span>
        </div>
      </div>
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/exam-preparation">Exam Prep</a>
        <a href="/exam-preparation/class-9">Class 9 Annual Exam</a>
      </div>
    </div>
    <div class="footer-bottom">
      © {new Date().getFullYear()} The Concepts Adda. All rights reserved.
    </div>
  </footer>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Option Click Feedback
    const optionBtns = document.querySelectorAll('.option-btn');
    optionBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const grid = btn.closest('.options-grid');
        if (!grid) return;
        const correctAnswer = grid.getAttribute('data-answer');
        const selectedOpt = btn.getAttribute('data-opt');
        const allBtns = grid.querySelectorAll('.option-btn');

        allBtns.forEach((b) => {
          b.classList.remove('selected-correct', 'selected-wrong');
          const badge = b.querySelector('.feedback-badge');
          if (badge) badge.classList.add('hidden');
        });

        const currentBadge = btn.querySelector('.feedback-badge');
        if (selectedOpt === correctAnswer) {
          btn.classList.add('selected-correct');
          if (currentBadge) {
            currentBadge.textContent = '✓ Correct';
            currentBadge.classList.remove('hidden');
          }
        } else {
          btn.classList.add('selected-wrong');
          if (currentBadge) {
            currentBadge.textContent = '✗ Incorrect';
            currentBadge.classList.remove('hidden');
          }
        }
      });
    });

    // Toggle Solution Visibility
    const toggleBtns = document.querySelectorAll('.toggle-sol-btn');
    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const solEl = document.getElementById(targetId);
        const chevron = btn.querySelector('.chevron');

        if (solEl) {
          solEl.classList.toggle('hidden');
          const isHidden = solEl.classList.contains('hidden');
          const span = btn.querySelector('span');
          if (span) {
            span.textContent = isHidden ? 'Show Solution & Answer' : 'Hide Solution & Answer';
          }
          if (chevron) {
            chevron.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(180deg)';
          }
        }
      });
    });
  });
</script>

<style>
  :global(body) {
    margin: 0;
    background: #f8fafc;
    color: #14213d;
    font-family: Inter, system-ui, -apple-system, sans-serif;
  }

  .chapter-questions-page {
    min-height: 80vh;
  }

  /* NAVBAR */
  .practice-navbar {
    width: 100%;
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid #e2e8f0;
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav-container {
    width: min(1180px, calc(100% - 40px));
    height: 76px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  .brand-logo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid #f4c430;
  }

  .brand-name {
    font-size: 18px;
    font-weight: 850;
  }

  .brand-tagline {
    font-size: 11px;
    color: #64748b;
  }

  .nav-links {
    display: flex;
    gap: 24px;
  }

  .nav-links a {
    text-decoration: none;
    color: #475569;
    font-size: 14px;
    font-weight: 650;
  }

  .nav-links a:hover {
    color: #2563eb;
  }

  /* HERO */
  .chapter-hero.blue-theme {
    padding: 50px 0 36px;
    background: linear-gradient(180deg, #ffffff 0%, #eff6ff 100%);
    border-bottom: 1px solid #93c5fd;
  }

  .hero-container {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 16px;
  }

  .breadcrumb a {
    color: #2563eb;
    text-decoration: none;
  }

  .breadcrumb-dot {
    width: 4px;
    height: 4px;
    background: #cbd5e1;
    border-radius: 50%;
  }

  .active-crumb {
    color: #1e293b;
  }

  .chapter-badge.blue {
    display: inline-block;
    padding: 4px 12px;
    background: #dbeafe;
    color: #1d4ed8;
    border-radius: 99px;
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }

  .chapter-hero h1 {
    font-size: 36px;
    font-weight: 850;
    color: #0f172a;
    line-height: 1.25;
    margin: 0 0 12px;
  }

  .blue-text {
    color: #2563eb;
  }

  .hero-desc {
    font-size: 16px;
    color: #475569;
    line-height: 1.6;
    margin: 0;
    max-width: 800px;
  }

  /* QUESTIONS SECTION */
  .questions-section {
    padding: 50px 0;
  }

  .questions-container {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
  }

  .questions-grid {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .q-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  }

  .q-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .q-meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .q-number.blue-num {
    font-size: 16px;
    font-weight: 850;
    color: #1d4ed8;
    background: #dbeafe;
    padding: 4px 12px;
    border-radius: 8px;
  }

  .q-type-badge {
    padding: 4px 10px;
    background: #f1f5f9;
    color: #475569;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 750;
  }

  .q-type-badge.blue {
    background: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #93c5fd;
  }

  .q-marks-badge {
    font-size: 13px;
    font-weight: 750;
    color: #059669;
    background: #ecfdf5;
    padding: 4px 10px;
    border-radius: 6px;
  }

  .q-text {
    font-size: 18px;
    font-weight: 750;
    color: #1e293b;
    line-height: 1.5;
    margin: 0 0 16px;
  }

  .diagram-wrapper {
    margin: 16px 0;
    padding: 16px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .diagram-wrapper :global(svg) {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 14px;
  }

  @media (max-width: 640px) {
    .options-grid {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
  }

  .option-btn {
    width: 100%;
    padding: 14px 16px;
    background: #f8fafc;
    border: 1.5px solid #cbd5e1;
    border-radius: 12px;
    font-size: 14.5px;
    font-weight: 650;
    color: #1e293b;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    transition: all 0.2s ease;
  }

  .option-btn:hover {
    border-color: #2563eb;
    background: #eff6ff;
  }

  .option-btn.selected-correct {
    background: #ecfdf5;
    border-color: #10b981;
    color: #065f46;
  }

  .option-btn.selected-wrong {
    background: #fef2f2;
    border-color: #ef4444;
    color: #991b1b;
  }

  .feedback-badge {
    font-size: 12px;
    font-weight: 800;

    padding: 2px 8px;
    border-radius: 6px;
  }

  .selected-correct .feedback-badge {
    background: #10b981;
    color: #ffffff;
  }

  .selected-wrong .feedback-badge {
    background: #ef4444;
    color: #ffffff;
  }

  .hidden {
    display: none !important;
  }

  /* FOOTER SOLUTION TOGGLE */
  .q-footer {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px dashed #e2e8f0;
  }

  .toggle-sol-btn {
    padding: 10px 18px;
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    font-size: 13.5px;
    font-weight: 750;
    color: #334155;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
  }

  .toggle-sol-btn:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  .sol-container {
    margin-top: 16px;
    padding: 16px;
    background: #eff6ff;
    border: 1px solid #93c5fd;
    border-radius: 12px;
  }

  .answer-box.blue-ans {
    font-size: 14.5px;
    color: #1e40af;
    margin-bottom: 10px;
  }

  .sol-box {
    font-size: 14px;
    color: #334155;
    line-height: 1.6;
  }

  .sol-box p {
    margin: 6px 0 0;
  }

  /* FOOTER */
  .footer {
    background: #0d172b;
    color: white;
    padding: 60px 0 25px;
  }

  .footer-container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-brand img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 2px solid #f4c430;
  }

  .footer-brand div {
    display: flex;
    flex-direction: column;
  }

  .footer-links {
    display: flex;
    gap: 24px;
  }

  .footer-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
  }

  .footer-links a:hover {
    color: white;
  }

  .footer-bottom {
    width: min(1180px, calc(100% - 40px));
    margin: 30px auto 0;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 13px;
    color: #64748b;
  }
</style>
