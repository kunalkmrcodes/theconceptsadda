			font-size: 11px;
			font-weight: 700;
			letter-spacing: 1px;
			margin-bottom: 4px;
		}

		.previous-lesson strong,
		.next-lesson strong {
			display: block;
			font-size: 15px;
			font-weight: 600;
			color: #0f172a;
		}

		.previous-lesson span,
		.next-lesson span {
