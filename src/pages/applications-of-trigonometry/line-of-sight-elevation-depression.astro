			font-weight: 700;
			line-height: 1.5;
		}

		.example-card {
			margin-top: 25px;
			border-radius: 20px;
			border: 1px solid #e1e7f0;
			background: #ffffff;
			box-shadow: 0 8px 25px rgba(20, 33, 61, 0.035);
			overflow: hidden;
		}

		.example-header {
			padding: 20px 24px;
			background: #f8fafc;
			border-bottom: 1px solid #edf2f7;
		}

		.example-badge {
			display: inline-block;
			padding: 4px 12px;
			border-radius: 6px;
			background: #2563eb;
			color: #ffffff;
			font-size: 11px;
			font-weight: 900;
			letter-spacing: 1px;
			margin-bottom: 8px;
		}

		.example-header h3 {
			margin: 0;
			font-size: 18px;
			font-weight: 800;
			color: #14213d;
		}

		.example-solution {
			padding: 24px;
			color: #475569;
			font-size: 15px;
			line-height: 1.7;
		}

		.calc-box {
			margin-top: 10px;
			padding: 14px 18px;
			border-radius: 12px;
			background: #0f172a;
			color: #38bdf8;
			font-weight: 700;
			font-size: 15px;
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		}

		.summary-list {
			display: grid;
			gap: 16px;
			margin-top: 26px;
		}

		.summary-item {
			display: flex;
			align-items: center;
			gap: 20px;
			padding: 20px 24px;
			border-radius: 16px;
			background: #ffffff;
			border: 1px solid #e1e7f0;
			box-shadow: 0 4px 15px rgba(20, 33, 61, 0.03);
		}

		.summary-item span {
			padding: 8px 14px;
			border-radius: 10px;
			background: #eef4ff;
			color: #2563eb;
			font-weight: 900;
